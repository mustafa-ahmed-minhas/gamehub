# Normalize line endings: store LF in the repository, check out LF everywhere.
* text=auto eol=lf

# Application source and configuration
*.cs        text eol=lf
*.cshtml    text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sln       text eol=lf
*.csproj    text eol=lf
*.config    text eol=lf

# Windows scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets: never diffed, never line-ending translated
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       text eol=lf
*.mp4       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.xlsx      binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.zip       binary
