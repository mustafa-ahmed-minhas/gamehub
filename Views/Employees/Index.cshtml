@model GameHub.Models.ViewModels.EmployeeIndexViewModel
@using GameHub.Helpers
@using GameHub.Models.Enums
@{
    ViewData["Title"] = "Employees";
    Layout = "_AdminLayout";
    var start = Model.TotalRecords == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || !string.IsNullOrWhiteSpace(Model.Department)
        || !string.IsNullOrWhiteSpace(Model.Designation)
        || Model.EmploymentStatus.HasValue
        || Model.EmploymentType.HasValue;
    var pageStart = Math.Max(1, Model.CurrentPage - 3);
    var pageEnd = Math.Min(Model.TotalPages, pageStart + 6);
    pageStart = Math.Max(1, pageEnd - 6);
}
@functions {
    private string PageUrl(int page)
        => Url.Action("Index", new
        {
            search = Model.Search,
            department = Model.Department,
            designation = Model.Designation,
            employmentStatus = Model.EmploymentStatus,
            employmentType = Model.EmploymentType,
            sortBy = Model.SortBy,
            pageSize = Model.PageSize,
            page
        }) ?? "#";
}

<section class="arena-page hr-page employees-page" data-employees-page>
    <header class="arena-header">
        <div>
            <span class="admin-label">Human Resources</span>
            <h1>Employees</h1>
            <p>Manage your workforce, employment details, profiles, and staff status.</p>
        </div>
        <div class="arena-actions">
            <a class="admin-secondary-button" asp-controller="HR" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
            @if (Model.CanManage)
            {
                <a class="admin-action-button" asp-action="Create"><i class="bi bi-person-plus"></i> Add Employee</a>
            }
        </div>
    </header>

    <div class="arena-summary-grid">
        <article><i class="bi bi-people"></i><span>Total Employees</span><strong>@Model.TotalEmployees</strong></article>
        <article><i class="bi bi-person-check"></i><span>Active Employees</span><strong>@Model.ActiveEmployees</strong></article>
        <article><i class="bi bi-luggage"></i><span>On Leave</span><strong>@Model.OnLeaveEmployees</strong></article>
        <article><i class="bi bi-person-dash"></i><span>Inactive Employees</span><strong>@Model.InactiveEmployees</strong></article>
    </div>

    <section class="arena-card">
        <form class="arena-toolbar" method="get" data-employee-filters>
            <div class="arena-search"><i class="bi bi-search"></i><input name="search" value="@Model.Search" placeholder="Search employees..." aria-label="Search employees" autocomplete="off" data-live-search /></div>
            <select name="department" data-filter-select>
                <option value="">All Departments</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept" selected="@(string.Equals(Model.Department, dept, StringComparison.OrdinalIgnoreCase))">@dept</option>
                }
            </select>
            <select name="designation" data-filter-select>
                <option value="">All Designations</option>
                @foreach (var desig in Model.Designations)
                {
                    <option value="@desig" selected="@(string.Equals(Model.Designation, desig, StringComparison.OrdinalIgnoreCase))">@desig</option>
                }
            </select>
            <select name="employmentStatus" data-filter-select>
                <option value="">All Status</option>
                @foreach (EmploymentStatus value in Enum.GetValues<EmploymentStatus>())
                {
                    <option value="@value" selected="@(Model.EmploymentStatus == value)">@value.GetDisplayName()</option>
                }
            </select>
            <select name="employmentType" data-filter-select>
                <option value="">All Types</option>
                @foreach (EmploymentType value in Enum.GetValues<EmploymentType>())
                {
                    <option value="@value" selected="@(Model.EmploymentType == value)">@value.GetDisplayName()</option>
                }
            </select>
            <select name="sortBy" data-filter-select>
                <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest</option>
                <option value="name" selected="@(Model.SortBy == "name")">Name A-Z</option>
                <option value="employee-id" selected="@(Model.SortBy == "employee-id")">Employee ID</option>
                <option value="joining-date" selected="@(Model.SortBy == "joining-date")">Latest Joining</option>
            </select>
            <select name="pageSize" data-filter-select>
                @foreach (var size in new[] { 10, 25, 50 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                }
            </select>
            <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-x-circle"></i> Clear Filters</a>
        </form>

        @if (!Model.Employees.Any())
        {
            <div class="arena-empty">
                <i class="bi bi-person-lines-fill"></i>
                <h2>@(hasFilters ? "No Matching Employees" : "No Employees Yet")</h2>
                <p>@(hasFilters ? "Try changing or clearing your filters." : "Add your first employee to start building the workforce directory.")</p>
                @if (hasFilters)
                {
                    <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-x-circle"></i> Clear Filters</a>
                }
                else if (Model.CanManage)
                {
                    <a class="admin-action-button" asp-action="Create"><i class="bi bi-person-plus"></i> Add Employee</a>
                }
            </div>
        }
        else
        {
            <div class="hr-table-wrap">
                <table class="arena-table hr-table employees-table">
                    <thead>
                        <tr>
                            <th scope="col">Employee</th>
                            <th scope="col">Department</th>
                            <th scope="col">Designation</th>
                            <th scope="col">Employment Type</th>
                            <th scope="col">Joining Date</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone Number</th>
                            <th scope="col">Employment Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Employees)
                        {
                            <tr data-employee-row="@employee.Id">
                                <td data-label="Employee">
                                    <div class="user-cell hr-identity">
                                        @if (!string.IsNullOrWhiteSpace(employee.ProfileImageUrl))
                                        {
                                            <img class="user-avatar" src="@employee.ProfileImageUrl" alt="@employee.FullName" />
                                        }
                                        else
                                        {
                                            <span class="user-avatar">@employee.Initials</span>
                                        }
                                        <div>
                                            <strong>@employee.FullName</strong>
                                            <small>@employee.EmployeeNumber</small>
                                            @if (!string.IsNullOrWhiteSpace(employee.ReportingManagerName))
                                            {
                                                <small>Reports to @employee.ReportingManagerName</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Department"><span class="membership-code">@employee.Department</span></td>
                                <td data-label="Designation"><strong>@employee.Designation</strong></td>
                                <td data-label="Type"><span class="role-badge membership-role-badge">@employee.EmploymentType.GetDisplayName()</span></td>
                                <td data-label="Joining Date">@employee.JoiningDate.ToString("dd MMM yyyy")</td>
                                <td data-label="Email"><small>@employee.Email</small></td>
                                <td data-label="Phone"><strong>@employee.PhoneNumber</strong></td>
                                <td data-label="Status">
                                    <span class="membership-status-badge hr-tone @employee.EmploymentStatus.GetBadgeClass()"><i></i>@employee.EmploymentStatus.GetDisplayName()</span>
                                </td>
                                <td data-label="Actions">
                                    <div class="membership-action-menu">
                                        <a class="membership-icon-button" asp-action="Details" asp-route-id="@employee.Id" data-tooltip="View Employee" aria-label="View employee"><i class="bi bi-eye"></i></a>
                                        @if (Model.CanManage)
                                        {
                                            <a class="membership-icon-button" asp-action="Edit" asp-route-id="@employee.Id" data-tooltip="Edit" aria-label="Edit employee"><i class="bi bi-pencil"></i></a>
                                            <button class="membership-icon-button" type="button"
                                                    data-employee-status
                                                    data-url="@Url.Action("ChangeStatus", new { id = employee.Id })"
                                                    data-employee="@employee.FullName"
                                                    data-status="@employee.EmploymentStatus"
                                                    data-tooltip="Change Status"
                                                    aria-label="Change employment status"><i class="bi bi-power"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="arena-pagination">
                <span>Showing @start-@end of @Model.TotalRecords employees</span>
                <nav>
                    <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : PageUrl(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i> Previous</a>
                    @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                    {
                        <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@PageUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                    }
                    <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : PageUrl(Model.CurrentPage + 1))">Next <i class="bi bi-chevron-right"></i></a>
                </nav>
            </div>
        }
    </section>
</section>

@Html.AntiForgeryToken()
<div class="modal fade customer-modal" id="employeeStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Change Employment Status</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <p data-employee-name>Are you sure?</p>
                <label class="d-grid gap-2 mt-2">
                    <span class="small fw-semibold text-muted">New status</span>
                    <select id="employeeStatusSelect" class="form-select">
                        @foreach (EmploymentStatus value in Enum.GetValues<EmploymentStatus>())
                        {
                            <option value="@value">@value.GetDisplayName()</option>
                        }
                    </select>
                </label>
            </div>
            <div class="modal-footer"><button type="button" class="admin-secondary-button" data-bs-dismiss="modal">Cancel</button><button type="button" class="admin-action-button" data-employee-status-submit>Confirm</button></div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/hr-employees.js" asp-append-version="true"></script>
}