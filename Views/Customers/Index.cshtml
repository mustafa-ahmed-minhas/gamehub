@model GameHub.Models.ViewModels.CustomerIndexViewModel
@using GameHub.Helpers
@using GameHub.Models.Enums
@{
    ViewData["Title"] = "Customers";
    Layout = "_AdminLayout";
    var start = Model.TotalRecords == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || Model.CustomerType.HasValue
        || Model.CustomerSource.HasValue
        || !string.IsNullOrWhiteSpace(Model.Status)
        || !string.IsNullOrWhiteSpace(Model.Membership)
        || !string.IsNullOrWhiteSpace(Model.Blacklist)
        || !string.IsNullOrWhiteSpace(Model.City);
    var pageStart = Math.Max(1, Model.CurrentPage - 3);
    var pageEnd = Math.Min(Model.TotalPages, pageStart + 6);
    pageStart = Math.Max(1, pageEnd - 6);
}
@functions {
    private string TabUrl(string? status = null, string? membership = null, string? blacklist = null)
        => Url.Action("Index", new
        {
            search = Model.Search,
            customerType = Model.CustomerType,
            source = Model.CustomerSource,
            city = Model.City,
            sortBy = Model.SortBy,
            pageSize = Model.PageSize,
            page = 1,
            status = string.IsNullOrWhiteSpace(status) ? null : status,
            membership = string.IsNullOrWhiteSpace(membership) ? null : membership,
            blacklist = string.IsNullOrWhiteSpace(blacklist) ? null : blacklist
        }) ?? "#";

    private string PageUrl(int page)
        => Url.Action("Index", new
        {
            search = Model.Search,
            customerType = Model.CustomerType,
            source = Model.CustomerSource,
            status = Model.Status,
            membership = Model.Membership,
            blacklist = Model.Blacklist,
            city = Model.City,
            sortBy = Model.SortBy,
            pageSize = Model.PageSize,
            page
        }) ?? "#";

    private string Segment()
    {
        if (!string.IsNullOrWhiteSpace(Model.Status)) return Model.Status;
        if (!string.IsNullOrWhiteSpace(Model.Blacklist)) return Model.Blacklist == "blacklisted" ? "blacklisted" : "other";
        if (!string.IsNullOrWhiteSpace(Model.Membership)) return Model.Membership == "members" ? "members" : "other";
        return "all";
    }
}

<section class="arena-page customers-page" data-customers-index>
    <div class="arena-header">
        <div>
            <span class="admin-label">Customer Relationship Management</span>
            <h1>Customers</h1>
            <p>Manage customer profiles, contact information, membership status, preferences, and account activity.</p>
        </div>
        @if (Model.CanManage)
        {
            <a class="admin-action-button" asp-action="Create"><i class="bi bi-person-plus"></i> Add Customer</a>
        }
    </div>

    <div class="arena-summary-grid">
        <article><i class="bi bi-people"></i><span>Total Customers</span><strong>@Model.TotalCustomers</strong></article>
        <article><i class="bi bi-person-check"></i><span>Active Customers</span><strong>@Model.ActiveCustomers</strong></article>
        <article><i class="bi bi-person-badge"></i><span>Members</span><strong>@Model.Members</strong></article>
        <article><i class="bi bi-stars"></i><span>VIP Customers</span><strong>@Model.VipCustomers</strong></article>
        <article><i class="bi bi-shield-exclamation"></i><span>Blacklisted</span><strong>@Model.BlacklistedCustomers</strong></article>
        <article><i class="bi bi-cash-stack"></i><span>Outstanding Balance</span><strong>@Model.OutstandingBalance.ToString("N0")</strong></article>
    </div>

    <nav class="arena-tabs" aria-label="Customer segments">
        <a class="@(Segment() == "all" ? "active" : "")" href="@TabUrl()" aria-current="@(Segment() == "all" ? "page" : null)"><i class="bi bi-people"></i> All Customers</a>
        <a class="@(Segment() == "active" ? "active" : "")" href="@TabUrl(status: "active")" aria-current="@(Segment() == "active" ? "page" : null)"><i class="bi bi-person-check"></i> Active</a>
        <a class="@(Segment() == "inactive" ? "active" : "")" href="@TabUrl(status: "inactive")" aria-current="@(Segment() == "inactive" ? "page" : null)"><i class="bi bi-person-dash"></i> Inactive</a>
        <a class="@(Segment() == "members" ? "active" : "")" href="@TabUrl(membership: "members")" aria-current="@(Segment() == "members" ? "page" : null)"><i class="bi bi-person-badge"></i> Members</a>
        <a class="@(Segment() == "blacklisted" ? "active" : "")" href="@TabUrl(blacklist: "blacklisted")" aria-current="@(Segment() == "blacklisted" ? "page" : null)"><i class="bi bi-shield-exclamation"></i> Blacklisted</a>
    </nav>

    <section class="arena-card">
        <form class="arena-toolbar" method="get" data-customer-filters>
            <div class="arena-search"><i class="bi bi-search"></i><input name="search" value="@Model.Search" placeholder="Search customers..." aria-label="Search customers" autocomplete="off" data-live-search /></div>
            <select name="customerType" data-filter-select>
                <option value="">All Types</option>
                @foreach (CustomerType value in Enum.GetValues<CustomerType>())
                {
                    <option value="@value" selected="@(Model.CustomerType == value)">@value.GetDisplayName()</option>
                }
            </select>
            <select name="source" data-filter-select>
                <option value="">All Sources</option>
                @foreach (CustomerSource value in Enum.GetValues<CustomerSource>())
                {
                    <option value="@value" selected="@(Model.CustomerSource == value)">@value.GetDisplayName()</option>
                }
            </select>
            <select name="status" data-filter-select>
                <option value="">All Status</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
            </select>
            <select name="membership" data-filter-select>
                <option value="">All Memberships</option>
                <option value="members" selected="@(Model.Membership == "members")">Members</option>
                <option value="non-members" selected="@(Model.Membership == "non-members")">Non-Members</option>
                <option value="expired" selected="@(Model.Membership == "expired")">Expired</option>
            </select>
            <select name="blacklist" data-filter-select>
                <option value="">All Risk</option>
                <option value="blacklisted" selected="@(Model.Blacklist == "blacklisted")">Blacklisted</option>
                <option value="not-blacklisted" selected="@(Model.Blacklist == "not-blacklisted")">Not Blacklisted</option>
            </select>
            <select name="city" data-filter-select>
                <option value="">All Cities</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city" selected="@(Model.City == city)">@city</option>
                }
            </select>
            <select name="sortBy" data-filter-select>
                <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest</option>
                <option value="name" selected="@(Model.SortBy == "name")">Name A-Z</option>
                <option value="code" selected="@(Model.SortBy == "code")">Customer Code</option>
                <option value="loyalty" selected="@(Model.SortBy == "loyalty")">Most Loyalty Points</option>
                <option value="balance" selected="@(Model.SortBy == "balance")">Highest Balance</option>
                <option value="last-visit" selected="@(Model.SortBy == "last-visit")">Last Visit</option>
                <option value="active" selected="@(Model.SortBy == "active")">Active First</option>
                <option value="blacklisted" selected="@(Model.SortBy == "blacklisted")">Blacklisted First</option>
            </select>
            <select name="pageSize" data-filter-select>
                @foreach (var size in new[] { 10, 25, 50 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                }
            </select>
            <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-x-circle"></i> Clear</a>
        </form>

        @if (!Model.Customers.Any())
        {
            <div class="arena-empty">
                <i class="bi bi-person-lines-fill"></i>
                <h2>@(hasFilters ? "No Matching Customers" : "No Customers Yet")</h2>
                <p>@(hasFilters ? "Try changing or clearing your filters." : "Add your first customer to begin managing profiles, memberships and bookings.")</p>
                @if (hasFilters)
                {
                    <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-x-circle"></i> Clear Filters</a>
                }
                else if (Model.CanManage)
                {
                    <a class="admin-action-button" asp-action="Create"><i class="bi bi-person-plus"></i> Add Customer</a>
                }
            </div>
        }
        else
        {
            <div class="customers-table-wrap">
                <table class="arena-table customers-table">
                    <thead>
                        <tr>
                            <th scope="col">Customer</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Type</th>
                            <th scope="col">Source</th>
                            <th scope="col">Membership</th>
                            <th scope="col">Loyalty</th>
                            <th scope="col">Balance</th>
                            <th scope="col">Status</th>
                            <th scope="col">Last Visit</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model.Customers)
                        {
                            <tr data-customer-row="@customer.Id">
                                <td data-label="Customer">
                                    <div class="user-cell customer-identity">
                                        @if (!string.IsNullOrWhiteSpace(customer.ProfileImageUrl))
                                        {
                                            <img class="user-avatar" src="@customer.ProfileImageUrl" alt="@customer.FullName" />
                                        }
                                        else
                                        {
                                            <span class="user-avatar membership-table-avatar">@customer.Initials</span>
                                        }
                                        <div>
                                            <strong>@customer.FullName</strong>
                                            <small>@customer.CustomerCode</small>
                                            @if (customer.CustomerType == CustomerType.VIP) { <em>VIP</em> }
                                            @if (customer.IsBlacklisted) { <em class="danger">Blacklisted</em> }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Contact">
                                    <strong>@customer.PrimaryPhone</strong>
                                    <small>@(customer.WhatsAppNumber ?? "WhatsApp not set")</small>
                                    <small>@(customer.Email ?? "Email not provided")</small>
                                </td>
                                <td data-label="Type"><span class="role-badge membership-role-badge">@customer.CustomerType.GetDisplayName()</span></td>
                                <td data-label="Source"><span class="membership-code">@customer.CustomerSource.GetDisplayName()</span></td>
                                <td data-label="Membership">
                                    @if (customer.IsMember)
                                    {
                                        var expired = customer.MembershipExpiryDate.HasValue && customer.MembershipExpiryDate.Value < DateOnly.FromDateTime(DateTime.UtcNow);
                                        <span class="membership-status-badge @(expired ? "expired" : "confirmed")"><i></i>@(expired ? "Expired" : "Member")</span>
                                        <small>@(customer.MembershipExpiryDate?.ToString("dd MMM yyyy") ?? "No expiry")</small>
                                    }
                                    else
                                    {
                                        <span class="membership-status-badge pending"><i></i>Non-Member</span>
                                    }
                                </td>
                                <td data-label="Loyalty"><strong>@customer.LoyaltyPoints</strong><small>points</small></td>
                                <td data-label="Balance"><strong class="@(customer.OutstandingBalance > 0 ? "customer-danger-text" : "")">PKR @customer.OutstandingBalance.ToString("N0")</strong></td>
                                <td data-label="Status"><span class="membership-status-badge @(customer.IsActive ? "active" : "inactive")"><i></i>@(customer.IsActive ? "Active" : "Inactive")</span></td>
                                <td data-label="Last Visit">@(customer.LastVisitAt?.ToString("dd MMM yyyy") ?? "Never")</td>
                                <td data-label="Actions">
                                    <div class="membership-action-menu">
                                        <a class="membership-icon-button" asp-action="Details" asp-route-id="@customer.Id" data-tooltip="View" aria-label="View customer"><i class="bi bi-eye"></i></a>
                                        @if (Model.CanManage)
                                        {
                                            <a class="membership-icon-button" asp-action="Edit" asp-route-id="@customer.Id" data-tooltip="Edit" aria-label="Edit customer"><i class="bi bi-pencil"></i></a>
                                            <button class="membership-icon-button" type="button" data-customer-toggle data-url="@Url.Action("ToggleStatus", new { id = customer.Id })" data-message="@(customer.IsActive ? "Deactivate this customer?" : "Activate this customer?")" data-tooltip="Toggle" aria-label="Toggle status"><i class="bi bi-power"></i></button>
                                            <button class="membership-icon-button @(customer.IsBlacklisted ? "is-danger" : "")" type="button" data-blacklist-toggle data-url="@Url.Action("ToggleBlacklist", new { id = customer.Id })" data-blacklisted="@customer.IsBlacklisted.ToString().ToLowerInvariant()" data-tooltip="Risk" aria-label="Toggle blacklist"><i class="bi bi-shield-exclamation"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="arena-pagination">
                <span>Showing @start-@end of @Model.TotalRecords customers</span>
                <nav>
                    <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : PageUrl(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i> Previous</a>
                    @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                    {
                        <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@PageUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                    }
                    <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : PageUrl(Model.CurrentPage + 1))">Next <i class="bi bi-chevron-right"></i></a>
                </nav>
            </div>
        }
    </section>
</section>

@Html.AntiForgeryToken()
<div class="modal fade customer-modal" id="customerConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Confirm Action</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><p data-confirm-message>Are you sure?</p><textarea class="form-control d-none" data-blacklist-reason placeholder="Reason for blacklisting"></textarea></div>
            <div class="modal-footer"><button type="button" class="admin-secondary-button" data-bs-dismiss="modal">Cancel</button><button type="button" class="admin-action-button" data-confirm-submit>Confirm</button></div>
        </div>
    </div>
</div>