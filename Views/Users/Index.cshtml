@model UserIndexViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";

    var startRecord = Model.TotalRecords == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var endRecord = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);

    string QueryFor(int page) => Url.Action("Index", "Users", new
    {
        search = Model.Search,
        role = Model.Role,
        status = Model.Status,
        sortBy = Model.SortBy,
        sortDirection = Model.SortDirection,
        page,
        pageSize = Model.PageSize
    }) ?? "#";
}

<form id="statusToggleForm" method="post">
    @Html.AntiForgeryToken()
</form>

<section class="users-page" data-users-index>
    <div class="users-header admin-reveal">
        <div>
            <span class="admin-label">System Administration</span>
            <h1>User Management</h1>
            <p>Create and manage internal ERP users, roles, and access status.</p>
        </div>
        <a class="admin-action-button" asp-controller="Users" asp-action="Create">
            <i class="bi bi-person-plus"></i> Add New User
        </a>
    </div>

    <div class="user-summary-grid">
        <article class="user-summary-card admin-reveal">
            <i class="bi bi-people"></i>
            <span>Total Users</span>
            <strong>@Model.TotalUsers</strong>
        </article>
        <article class="user-summary-card admin-reveal">
            <i class="bi bi-check-circle"></i>
            <span>Active Users</span>
            <strong>@Model.ActiveUsers</strong>
        </article>
        <article class="user-summary-card admin-reveal">
            <i class="bi bi-pause-circle"></i>
            <span>Inactive Users</span>
            <strong>@Model.InactiveUsers</strong>
        </article>
        <article class="user-summary-card admin-reveal">
            <i class="bi bi-shield-lock"></i>
            <span>Admin-Level Users</span>
            <strong>@Model.AdminLevelUsers</strong>
        </article>
    </div>

    <section class="users-card admin-reveal">
        <form class="users-toolbar" method="get" asp-controller="Users" asp-action="Index" data-users-filter-form>
            <div class="user-search-field">
                <i class="bi bi-search"></i>
                <input name="search" value="@Model.Search" type="search" placeholder="Search users by name, email, or phone..." data-live-search />
            </div>

            <select name="role" aria-label="Filter by role" data-auto-submit>
                <option value="">All Roles</option>
                @foreach (UserRole role in Enum.GetValues<UserRole>())
                {
                    <option value="@role" selected="@(Model.Role == role)">@role.GetDisplayName()</option>
                }
            </select>

            <select name="status" aria-label="Filter by status" data-auto-submit>
                <option value="">All Status</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
            </select>

            <select name="sortBy" aria-label="Sort users" data-auto-submit>
                <option value="name" selected="@(Model.SortBy == "name" && Model.SortDirection == "asc")">Name A-Z</option>
                <option value="name" data-direction="desc" selected="@(Model.SortBy == "name" && Model.SortDirection == "desc")">Name Z-A</option>
                <option value="email" selected="@(Model.SortBy == "email")">Email A-Z</option>
                <option value="role" selected="@(Model.SortBy == "role")">Role</option>
                <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest</option>
                <option value="status" selected="@(Model.SortBy == "status")">Status</option>
            </select>
            <input type="hidden" name="sortDirection" value="@Model.SortDirection" data-sort-direction />

            <select name="pageSize" aria-label="Page size" data-auto-submit>
                @foreach (var size in new[] { 10, 25, 50 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size / page</option>
                }
            </select>

            <input type="hidden" name="page" value="1" />
            <a class="admin-secondary-button" asp-controller="Users" asp-action="Index">
                <i class="bi bi-x-lg"></i> Clear
            </a>
        </form>

        @if (!Model.Users.Any())
        {
            <div class="users-empty-state">
                <i class="bi bi-person-x"></i>
                <h2>No users found</h2>
                <p>Try changing your filters or create a new internal ERP user.</p>
                <a class="admin-action-button" asp-controller="Users" asp-action="Create">Create User</a>
            </div>
        }
        else
        {
            <div class="users-table-wrap">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Login</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr data-user-row="@user.Id">
                                <td data-label="User">
                                    <div class="user-cell">
                                        <span class="user-avatar">@user.Initials</span>
                                        <div>
                                            <strong>@user.FullName</strong>
                                            <small>@user.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Contact">
                                    <div class="muted-stack">
                                        <span>@user.Email</span>
                                        <small>@(user.PhoneNumber ?? "Phone not provided")</small>
                                    </div>
                                </td>
                                <td data-label="Role"><span class="role-badge role-@user.Role.ToString().ToLowerInvariant()">@user.Role.GetDisplayName()</span></td>
                                <td data-label="Status">
                                    <span class="user-status-badge @(user.IsActive ? "active" : "inactive")" data-status-badge>
                                        <i></i><span data-status-text>@(user.IsActive ? "Active" : "Inactive")</span>
                                    </span>
                                </td>
                                <td data-label="Created">
                                    <div class="muted-stack">
                                        <span>@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                        <small>@user.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                                    </div>
                                </td>
                                <td data-label="Last Login">
                                    @if (user.LastLoginAt.HasValue)
                                    {
                                        <div class="muted-stack">
                                            <span>@user.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                                            <small>@user.LastLoginAt.Value.ToLocalTime().ToString("hh:mm tt")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="never-text">Never</span>
                                    }
                                </td>
                                <td data-label="Actions">
                                    <div class="user-actions">
                                        <a class="icon-button" asp-controller="Users" asp-action="Details" asp-route-id="@user.Id" aria-label="View @user.FullName"><i class="bi bi-eye"></i></a>
                                        <a class="icon-button" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" aria-label="Edit @user.FullName"><i class="bi bi-pencil"></i></a>
                                        <button type="button"
                                                class="icon-button"
                                                data-status-toggle
                                                data-user-id="@user.Id"
                                                data-user-name="@user.FullName"
                                                data-is-active="@user.IsActive.ToString().ToLowerInvariant()"
                                                aria-label="@(user.IsActive ? "Deactivate" : "Activate") @user.FullName">
                                            <i class="bi @(user.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="users-pagination">
                <span>Showing @startRecord-@endRecord of @Model.TotalRecords users</span>
                <nav aria-label="User pagination">
                    <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : QueryFor(Model.CurrentPage - 1))">Previous</a>
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        if (pageNumber == 1 || pageNumber == Model.TotalPages || Math.Abs(pageNumber - Model.CurrentPage) <= 2)
                        {
                            <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@QueryFor(pageNumber)">@pageNumber</a>
                        }
                    }
                    <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : QueryFor(Model.CurrentPage + 1))">Next</a>
                </nav>
            </div>
        }
    </section>
</section>

<div class="modal fade user-modal" id="statusConfirmModal" tabindex="-1" aria-labelledby="statusConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="statusConfirmTitle">Confirm Status Change</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p data-status-message>This user status will be changed.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="admin-secondary-button" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="admin-action-button" data-confirm-status>Confirm</button>
            </div>
        </div>
    </div>
</div>
