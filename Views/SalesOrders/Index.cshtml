@model SalesOrderIndexViewModel
@using GameHub.Helpers
@using GameHub.Models.Enums
@using System.Net
@{
    ViewData["Title"] = "Sales Orders";
    Layout = "_AdminLayout";

    var start = Model.TotalRecords == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);
    var pageStart = Math.Max(1, Model.CurrentPage - 2);
    var pageEnd = Math.Min(Model.TotalPages, pageStart + 4);
    pageStart = Math.Max(1, pageEnd - 4);

    var activeFilterCount = new[] { "status", "customerId", "assignedToUserId", "dateFrom", "dateTo", "invoiceState" }
        .Count(x => !string.IsNullOrWhiteSpace(Q(x)));
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || activeFilterCount > 0;

    string Q(string key) => Context.Request.Query[key].ToString();
    string PageUrl(int page)
    {
        var pairs = new List<string>();
        foreach (var item in Context.Request.Query)
        {
            if (item.Key.Equals("page", StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var value in item.Value) if (!string.IsNullOrWhiteSpace(value)) pairs.Add($"{WebUtility.UrlEncode(item.Key)}={WebUtility.UrlEncode(value)}");
        }
        pairs.Add($"page={page}");
        return $"{Context.Request.Path}?{string.Join("&", pairs)}";
    }
}

<section class="arena-page sales-cycle-page sales-order-page">
    <header class="arena-header admin-reveal">
        <div>
            <span class="admin-label">Sales Management</span>
            <h1>Sales Orders</h1>
            <p>Convert accepted quotations into reviewed, confirmed orders that are ready for the future invoice phase.</p>
        </div>
        <div class="arena-actions">
            @if (Model.CanCreate)
            {
                <a class="admin-action-button" asp-action="CreateDirect"><i class="bi bi-plus-circle"></i> Direct Sales Order</a>
            }
            <a class="admin-secondary-button" asp-controller="Sales" asp-action="Index" asp-route-tab="quotations"><i class="bi bi-file-earmark-check"></i> Accepted Quotations</a>
        </div>
    </header>

    <nav class="arena-tabs" aria-label="Sales cycle sections">
        <a asp-controller="Sales" asp-action="Index">Overview</a>
        <a asp-controller="Sales" asp-action="Index" asp-route-tab="quotations">Quotations</a>
        <a class="active" asp-controller="SalesOrders" asp-action="Index">Sales Orders <span class="sales-cycle-tab-count">@Model.TotalRecords</span></a>
        <a class="disabled" href="#" aria-disabled="true">Future Invoices <small>Next phase</small></a>
        <a class="disabled" href="#" aria-disabled="true">Future Payments <small>Next phase</small></a>
    </nav>

    <div class="sales-cycle-layout sales-cycle-layout-wide">
        <main class="sales-cycle-main">
            <div class="arena-summary-grid">
                <article><i class="bi bi-pencil-square"></i><span>Draft Orders</span><strong data-sales-counter>@Model.DraftCount</strong></article>
                <article><i class="bi bi-check2-circle"></i><span>Confirmed</span><strong data-sales-counter>@Model.ConfirmedCount</strong></article>
                <article><i class="bi bi-receipt-cutoff"></i><span>Ready for Invoice</span><strong data-sales-counter>@Model.ReadyForInvoiceCount</strong></article>
                <article><i class="bi bi-cash-stack"></i><span>Total Order Value</span><strong>@Model.CurrencySymbol @Model.TotalOrderValue.ToString("N0")</strong></article>
            </div>

            <section class="arena-card">
                <form class="arena-toolbar" method="get" asp-action="Index">
                    <div class="arena-search">
                        <i class="bi bi-search"></i>
                        <input name="search" value="@Model.Search" placeholder="Search order, quotation, customer, opportunity or PO..." aria-label="Search sales orders" autocomplete="off" data-sales-search />
                    </div>

                    <button class="admin-secondary-button" type="button" data-sales-filter-toggle aria-controls="salesOrderFilterDrawer" aria-expanded="false">
                        <i class="bi bi-sliders"></i> Filters
                        <span class="membership-status-badge @(activeFilterCount > 0 ? "active" : "pending")" data-sales-filter-count @(activeFilterCount == 0 ? "hidden" : "")><i></i>@activeFilterCount</span>
                    </button>

                    <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-x-circle"></i> Clear</a>

                    <select name="sortBy" data-sales-filter aria-label="Sort sales orders">
                        <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                        <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest</option>
                        <option value="date" selected="@(Model.SortBy == "date")">Order Date</option>
                        <option value="highest" selected="@(Model.SortBy == "highest")">Highest Value</option>
                        <option value="lowest" selected="@(Model.SortBy == "lowest")">Lowest Value</option>
                        <option value="status" selected="@(Model.SortBy == "status")">Status</option>
                    </select>

                    <select name="pageSize" data-sales-filter aria-label="Page size">
                        @foreach (var size in new[] { 10, 25, 50 })
                        {
                            <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                        }
                    </select>
                </form>

                <div class="sales-cycle-chips">
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <span>Search: @Model.Search</span>
                    }
                    @if (Model.Status.HasValue)
                    {
                        <span>Status: @Model.Status.Value.GetDisplayName()</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.InvoiceState))
                    {
                        <span>Invoice: @(Model.InvoiceState switch
                        {
                            "not-created" => "Not Created",
                            "ready" => "Ready for Invoice",
                            "created" => "Created",
                            _ => Model.InvoiceState
                        })</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Q("customerId")))
                    {
                        <span>Customer selected</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Q("assignedToUserId")))
                    {
                        <span>Owner selected</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Q("dateFrom")) || !string.IsNullOrWhiteSpace(Q("dateTo")))
                    {
                        <span>Order date: @Q("dateFrom") to @Q("dateTo")</span>
                    }
                    @if (hasFilters)
                    {
                        <a asp-action="Index"><i class="bi bi-x"></i> Clear All</a>
                    }
                </div>

                @if (!Model.Items.Any())
                {
                    <div class="arena-empty">
                        <i class="bi bi-clipboard2-plus"></i>
                        <h2>@(hasFilters ? "No Matching Sales Orders" : "No Sales Orders Yet")</h2>
                        <p>@(hasFilters ? "Try changing or clearing your filters." : "Create a sales order from an accepted quotation to begin order fulfilment.")</p>
                        @if (hasFilters)
                        {
                            <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-x-circle"></i> Clear Filters</a>
                        }
                        else
                        {
                            <a class="admin-action-button" asp-controller="Sales" asp-action="Index" asp-route-tab="quotations"><i class="bi bi-file-earmark-check"></i> View Quotations</a>
                        }
                    </div>
                }
                else
                {
                    <div class="arena-table-wrap">
                        <table class="arena-table sales-cycle-table">
                            <thead>
                                <tr>
                                    <th scope="col">Sales Order</th>
                                    <th scope="col">Customer</th>
                                    <th scope="col">Quotation</th>
                                    <th scope="col">Order Date</th>
                                    <th scope="col">Value</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Owner</th>
                                    <th scope="col">Invoice</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var initials = string.Join("", (item.CustomerName ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
                                    <tr>
                                        <td data-label="Sales Order">
                                            <strong title="@item.SalesOrderNumber">@item.SalesOrderNumber</strong>
                                            <small title="@(item.Subject ?? "Sales order")">@(item.Subject ?? "Sales order")</small>
                                            <em>@item.CreatedAt.ToString("MMM dd, yyyy")</em>
                                        </td>
                                        <td data-label="Customer">
                                            <div class="user-cell membership-name-cell">
                                                <span class="user-avatar membership-table-avatar">@(initials.Length == 0 ? "S" : initials)</span>
                                                <div>
                                                    <strong title="@item.CustomerName">@item.CustomerName</strong>
                                                    <small>@item.CustomerCode</small>
                                                    <em>@(item.OrganizationName ?? "Individual")</em>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Quotation">
                                            <strong>@item.QuotationNumber</strong>
                                            <small title="@item.OpportunityName">@item.OpportunityName</small>
                                            <em>@item.SourceType</em>
                                        </td>
                                        <td data-label="Order Date">
                                            <strong>@item.OrderDate.ToString("MMM dd, yyyy")</strong>
                                            <small>Order date</small>
                                        </td>
                                        <td data-label="Value">
                                            <strong>@item.CurrencySymbol @item.GrandTotal.ToString("N0")</strong>
                                            <small>Subtotal @item.CurrencySymbol @item.Subtotal.ToString("N0")</small>
                                        </td>
                                        <td data-label="Status">
                                            <span class="@item.Status.Badge()"><i></i>@item.Status.GetDisplayName()</span>
                                        </td>
                                        <td data-label="Owner">
                                            <div class="user-cell membership-name-cell">
                                                <span class="user-avatar membership-table-avatar">@((item.Owner ?? "U").First())</span>
                                                <div><strong>@(item.Owner ?? "Unassigned")</strong></div>
                                            </div>
                                        </td>
                                        <td data-label="Invoice">
                                            <span class="@StatusBadgeHelper.Badge(item.InvoiceState)"><i></i>@item.InvoiceState</span>
                                        </td>
                                        <td data-label="Actions">
                                            <div class="membership-action-menu">
                                                <a class="membership-icon-button" asp-action="Details" asp-route-id="@item.Id" aria-label="View sales order" data-tooltip="View"><i class="bi bi-eye"></i></a>
                                                @if (Model.CanEditDraft && item.CanEdit)
                                                {
                                                    <a class="membership-icon-button" asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit sales order" data-tooltip="Edit"><i class="bi bi-pencil"></i></a>
                                                }
                                                <div class="dropdown">
                                                    <button class="membership-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions for @item.SalesOrderNumber" data-tooltip="More"><i class="bi bi-three-dots"></i></button>
                                                    <div class="dropdown-menu dropdown-menu-end">
                                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye"></i> View</a>
                                                        <a class="dropdown-item" asp-action="Preview" asp-route-id="@item.Id"><i class="bi bi-file-earmark-richtext"></i> Preview</a>
                                                        @if (Model.CanEditDraft && item.CanEdit)
                                                        {
                                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i> Edit Draft</a>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="arena-pagination">
                        <span>Showing @start-@end of @Model.TotalRecords sales orders</span>
                        <nav aria-label="Sales order pagination">
                            <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : PageUrl(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i> Previous</a>
                            @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                            {
                                <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@PageUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                            }
                            <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : PageUrl(Model.CurrentPage + 1))">Next <i class="bi bi-chevron-right"></i></a>
                        </nav>
                    </div>
                }
            </section>
        </main>
    </div>

    <div class="sales-cycle-filter-drawer" data-sales-filter-drawer aria-hidden="true">
        <div class="sales-cycle-filter-panel" id="salesOrderFilterDrawer" role="dialog" aria-label="Sales order filters">
            <div class="sales-cycle-filter-head">
                <div>
                    <span class="admin-label">Sales Order Filters</span>
                    <h2>Refine the register</h2>
                </div>
                <button class="membership-icon-button" type="button" data-sales-filter-close aria-label="Close filters"><i class="bi bi-x-lg"></i></button>
            </div>
            <form method="get" asp-action="Index">
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <input type="hidden" name="search" value="@Model.Search" />
                }
                @if (Model.SortBy != "newest")
                {
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                }
                @if (Model.PageSize != 10)
                {
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                }
                <div class="sales-cycle-filter-grid">
                    <label>Status
                        <select name="status" data-sales-filter-input>
                            <option value="">All Statuses</option>
                            @foreach (SalesOrderStatus item in Enum.GetValues<SalesOrderStatus>())
                            {
                                <option value="@item" selected="@(Model.Status == item)">@item.GetDisplayName()</option>
                            }
                        </select>
                    </label>
                    <label>Invoice State
                        <select name="invoiceState" data-sales-filter-input>
                            <option value="">All Invoice States</option>
                            <option value="not-created" selected="@(Model.InvoiceState == "not-created")">Not Created</option>
                            <option value="ready" selected="@(Model.InvoiceState == "ready")">Ready for Invoice</option>
                            <option value="created" selected="@(Model.InvoiceState == "created")">Created</option>
                        </select>
                    </label>
                    <label>Customer
                        <select name="customerId" data-sales-filter-input>
                            <option value="">All Customers</option>
                            @foreach (var item in Model.CustomerOptions)
                            {
                                <option value="@item.Value" selected="@(Q("customerId") == item.Value)">@item.Text</option>
                            }
                        </select>
                    </label>
                    <label>Owner
                        <select name="assignedToUserId" data-sales-filter-input>
                            <option value="">All Owners</option>
                            @foreach (var item in Model.UserOptions)
                            {
                                <option value="@item.Value" selected="@(Q("assignedToUserId") == item.Value)">@item.Text</option>
                            }
                        </select>
                    </label>
                    <label>Order Date From
                        <input type="date" name="dateFrom" value="@Q("dateFrom")" />
                    </label>
                    <label>Order Date To
                        <input type="date" name="dateTo" value="@Q("dateTo")" />
                    </label>
                </div>
                <div class="sales-cycle-filter-actions">
                    <button class="admin-action-button" type="submit"><i class="bi bi-check2"></i> Apply Filters</button>
                    <a class="admin-secondary-button" asp-action="Index">Clear All</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Styles { <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/sales-orders.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/sales.js" asp-append-version="true"></script><script src="~/js/sales-orders.js" asp-append-version="true"></script> }
