@model CustomerMembershipFormViewModel
@using GameHub.Models.Enums
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Membership" : "Assign Membership";
    Layout = "_AdminLayout";
    var formAction = Model.IsEditMode ? "EditMembership" : "Assign";
}
<section class="users-page membership-form-page">
    <header class="users-header membership-page-header"><div><span class="admin-label">Customer Membership</span><h1>@(Model.IsEditMode ? "Edit Membership" : "Assign Membership")</h1><p>Select an eligible customer, choose a plan, and manage membership terms.</p></div><a class="membership-btn membership-btn-secondary" asp-action="Index" asp-route-tab="customers"><i class="bi bi-arrow-left"></i> <span>Back</span></a></header>
    <form class="membership-form-grid" asp-action="@formAction" asp-route-id="@Model.Id" method="post" data-membership-form>
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
        <main class="membership-form-main users-form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <fieldset><legend><i class="bi bi-person"></i> Customer</legend><div class="premium-field"><label>Customer</label><div><i class="bi bi-people"></i><select asp-for="CustomerId" asp-items="Model.Customers" data-member-customer></select></div><small asp-validation-for="CustomerId"></small></div></fieldset>
            <fieldset><legend><i class="bi bi-card-list"></i> Membership Plan</legend><div class="premium-field"><label>Plan</label><div><i class="bi bi-person-badge"></i><select asp-for="MembershipPlanId" asp-items="Model.Plans" data-member-plan></select></div><small asp-validation-for="MembershipPlanId"></small></div></fieldset>
            <fieldset><legend><i class="bi bi-calendar-range"></i> Dates</legend><div class="form-grid-two"><div class="premium-field"><label>Start Date</label><div><i class="bi bi-calendar"></i><input asp-for="StartDate" type="date" data-start-date /></div></div><div class="premium-field"><label>Expiry Date</label><div><i class="bi bi-calendar-check"></i><input asp-for="ExpiryDate" type="date" data-expiry-date /></div><small asp-validation-for="ExpiryDate"></small></div></div></fieldset>
            <fieldset><legend><i class="bi bi-wallet2"></i> Financial Snapshot</legend><div class="form-grid-two"><div class="premium-field"><label>Joining Fee</label><div><i class="bi bi-cash"></i><input asp-for="JoiningFee" type="number" min="0" step="0.01" /></div></div><div class="premium-field"><label>Renewal Fee</label><div><i class="bi bi-arrow-repeat"></i><input asp-for="RenewalFee" type="number" min="0" step="0.01" /></div></div><div class="premium-field"><label>Discount %</label><div><i class="bi bi-percent"></i><input asp-for="DiscountPercentage" type="number" min="0" max="100" /></div></div><div class="premium-field"><label>Status</label><div><i class="bi bi-toggle-on"></i><select asp-for="Status" asp-items="Html.GetEnumSelectList<MembershipStatus>()"></select></div></div></div></fieldset>
            <fieldset><legend><i class="bi bi-clock"></i> Usage and Options</legend><div class="form-grid-two"><div class="premium-field"><label>Included Hours</label><div><i class="bi bi-clock-history"></i><input asp-for="IncludedBookingHours" type="number" min="0" /></div></div><div class="premium-field"><label>Used Hours</label><div><i class="bi bi-hourglass"></i><input asp-for="UsedBookingHours" type="number" min="0" /></div></div><label class="premium-toggle-field"><input asp-for="AutoRenew" type="checkbox" /><strong>Auto Renew</strong><span>Mark for renewal follow-up.</span></label><label class="premium-toggle-field"><input asp-for="IsActive" type="checkbox" /><strong>Active</strong><span>Current usable record.</span></label></div></fieldset>
            <fieldset><legend><i class="bi bi-pause-circle"></i> Freeze / Notes</legend><div class="form-grid-two"><div class="premium-field"><label>Frozen From</label><div><i class="bi bi-calendar-minus"></i><input asp-for="FrozenFrom" type="date" /></div></div><div class="premium-field"><label>Frozen Until</label><div><i class="bi bi-calendar-plus"></i><input asp-for="FrozenUntil" type="date" /></div></div><div class="premium-field span-two"><label>Cancellation Reason</label><div><i class="bi bi-exclamation-triangle"></i><input asp-for="CancellationReason" /></div></div><div class="premium-field span-two"><label>Notes</label><div><i class="bi bi-journal-text"></i><input asp-for="Notes" /></div></div></div></fieldset>
            <div class="form-actions membership-save-actions"><a class="membership-btn membership-btn-secondary" asp-action="Index" asp-route-tab="customers">Cancel</a><button class="membership-btn membership-btn-primary" type="submit" data-loading-button><i class="bi bi-check2-circle"></i><span>Save Membership</span></button></div>
        </main>
        <aside class="membership-preview-card"><span>Membership Preview</span><h2>@(Model.MembershipNumber ?? "MEM-000000")</h2><p data-member-preview-plan>Selected plan benefits</p><strong>@Model.CurrencySymbol @Model.JoiningFee.ToString("N0")</strong><div class="membership-preview-grid"><div><span>Start</span><b>@Model.StartDate.ToString("dd MMM yyyy")</b></div><div><span>Expiry</span><b>@Model.ExpiryDate.ToString("dd MMM yyyy")</b></div><div><span>Hours</span><b>@Model.UsedBookingHours / @Model.IncludedBookingHours</b></div><div><span>Status</span><b>@Model.Status</b></div></div></aside>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/memberships.js" asp-append-version="true"></script> }
