@model GameHub.Models.Entities.CourtSchedule
@{ ViewData["Title"] = "Schedule Details"; Layout = "_AdminLayout"; }
<section class="arena-details"><div class="arena-header"><div><span class="admin-label">Arena Setup</span><h1>@Model.Court.Name Schedule</h1><p>@Model.DayOfWeek recurring schedule</p></div><div class="arena-detail-actions"><a class="admin-secondary-button" asp-action="Index" asp-route-tab="schedules">Back</a><a class="admin-action-button" asp-action="EditSchedule" asp-route-id="@Model.Id">Edit</a></div></div><div class="arena-detail-grid"><article><i class="bi bi-clock-history"></i><h2>@Model.DayOfWeek</h2><p>Hours: @(Model.IsClosed ? "Closed" : $"{Model.OpeningTime:HH:mm} - {Model.ClosingTime:HH:mm}")</p><p>Slot: @Model.SlotDurationMinutes minutes</p><p>Buffer: @Model.BufferMinutes minutes</p><p>Status: @(Model.IsActive ? "Active" : "Inactive")</p></article></div></section>
