@model GameHub.Models.Entities.CourtPricing
@{ ViewData["Title"] = "Pricing Details"; Layout = "_AdminLayout"; }
<section class="arena-details"><div class="arena-header"><div><span class="admin-label">Arena Setup</span><h1>@Model.Name</h1><p>@Model.Court.Name - @Model.Court.Sport.Name</p></div><div class="arena-detail-actions"><a class="admin-secondary-button" asp-action="Index" asp-route-tab="pricing">Back</a><a class="admin-action-button" asp-action="EditPricing" asp-route-id="@Model.Id">Edit</a></div></div><div class="arena-detail-grid"><article><i class="bi bi-cash-stack"></i><h2>PKR @Model.Price.ToString("N0")</h2><p>Day: @(Model.DayOfWeek?.ToString() ?? "All Days")</p><p>Time: @Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</p><p>Duration: @Model.DurationMinutes minutes</p><p>Type: @(Model.IsPeakRate ? "Peak" : "Standard")</p></article></div></section>
