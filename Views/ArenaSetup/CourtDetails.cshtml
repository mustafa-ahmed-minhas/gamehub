@model GameHub.Models.Entities.Court
@{ ViewData["Title"] = "Court Details"; Layout = "_AdminLayout"; }
<section class="arena-details"><div class="arena-header"><div><span class="admin-label">Arena Setup</span><h1>@Model.Name</h1><p>@Model.Description</p></div><div class="arena-detail-actions"><a class="admin-secondary-button" asp-action="Index" asp-route-tab="courts">Back</a><a class="admin-action-button" asp-action="EditCourt" asp-route-id="@Model.Id">Edit</a></div></div><div class="arena-detail-grid"><article><i class="bi bi-grid-3x3-gap"></i><h2>@Model.Code</h2><p>Sport: @Model.Sport.Name</p><p>Facility: @Model.Facility.Name</p><p>Status: @Model.Status</p><p>Capacity: @Model.Capacity</p></article><article><h2>Pricing Rules</h2>@foreach (var p in Model.Pricings.Take(6)) { <p>@p.Name - PKR @p.Price.ToString("N0")</p> }</article><article><h2>Weekly Schedule</h2>@foreach (var s in Model.Schedules.OrderBy(x => x.DayOfWeek).Take(7)) { <p>@s.DayOfWeek: @(s.IsClosed ? "Closed" : $"{s.OpeningTime:HH:mm} - {s.ClosingTime:HH:mm}")</p> }</article></div></section>
