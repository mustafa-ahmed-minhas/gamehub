@model GameHub.Models.Entities.Sport
@{ ViewData["Title"] = "Sport Details"; Layout = "_AdminLayout"; }
<section class="arena-details"><div class="arena-header"><div><span class="admin-label">Arena Setup</span><h1>@Model.Name</h1><p>@Model.Description</p></div><div class="arena-detail-actions"><a class="admin-secondary-button" asp-action="Index" asp-route-tab="sports">Back</a><a class="admin-action-button" asp-action="EditSport" asp-route-id="@Model.Id">Edit</a></div></div><div class="arena-detail-grid"><article><i class="bi @(Model.IconClass ?? "bi-trophy")"></i><h2>@Model.Code</h2><p>Default duration: @Model.DefaultDurationMinutes minutes</p><p>Courts: @Model.Courts.Count</p><p>Status: @(Model.IsActive ? "Active" : "Inactive")</p><p>Created: @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p></article></div></section>
