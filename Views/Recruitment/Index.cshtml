@model GameHub.Models.ViewModels.RecruitmentIndexViewModel
@using GameHub.Helpers
@using GameHub.Models.Enums
@{
    ViewData["Title"] = "Recruitment Management";
    Layout = "_AdminLayout";

    var isOpenings = Model.ActiveTab == "openings";
    var applicationsTab = !isOpenings;

    var openingsHasFilters = !string.IsNullOrWhiteSpace(Model.OpeningSearch)
        || !string.IsNullOrWhiteSpace(Model.OpeningDepartment)
        || Model.OpeningEmploymentType.HasValue
        || Model.OpeningStatus.HasValue;

    var applicationsHasFilters = !string.IsNullOrWhiteSpace(Model.ApplicationSearch)
        || Model.ApplicationJobPostingId.HasValue
        || Model.ApplicationStatus.HasValue;

    var start = Model.TotalRecords == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);
    var pageStart = Math.Max(1, Model.CurrentPage - 3);
    var pageEnd = Math.Min(Model.TotalPages, pageStart + 6);
    pageStart = Math.Max(1, pageEnd - 6);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@functions {
    private string TabUrl(string targetTab)
        => Url.Action("Index", new { tab = targetTab, pageSize = Model.PageSize }) ?? "#";

    private string OpeningsUrl(int? page = null)
        => Url.Action("Index", new
        {
            tab = "openings",
            search = Model.OpeningSearch,
            department = Model.OpeningDepartment,
            employmentType = Model.OpeningEmploymentType,
            openingStatus = Model.OpeningStatus,
            openingSort = Model.OpeningSortBy,
            pageSize = Model.PageSize,
            page = page ?? Model.CurrentPage
        }) ?? "#";

    private string ApplicationsUrl(int? page = null)
        => Url.Action("Index", new
        {
            tab = "applications",
            search = Model.ApplicationSearch,
            jobPostingId = Model.ApplicationJobPostingId,
            applicationStatus = Model.ApplicationStatus,
            applicationSort = Model.ApplicationSortBy,
            pageSize = Model.PageSize,
            page = page ?? Model.CurrentPage
        }) ?? "#";
}

<section class="arena-page hr-page recruitment-page" data-recruitment-index data-active-tab="@Model.ActiveTab">
    <header class="arena-header">
        <div>
            <span class="admin-label">Recruitment</span>
            <h1>Recruitment Management</h1>
            <p>Open positions and the candidate pipeline in one place - from application through to interview.</p>
        </div>
        <div class="arena-actions">
            @if (Model.CanManage)
            {
                <a class="admin-secondary-button" asp-controller="JobApplications" asp-action="Create"><i class="bi bi-person-plus"></i> Add Application</a>
                <a class="admin-action-button" asp-controller="JobPostings" asp-action="Create"><i class="bi bi-journal-plus"></i> Add Job Posting</a>
            }
        </div>
    </header>

    <div class="arena-summary-grid hr-summary-grid">
        <article><i class="bi bi-briefcase"></i><span>Total Job Openings</span><strong>@Model.TotalJobOpenings</strong></article>
        <article><i class="bi bi-unlock"></i><span>Open Positions</span><strong>@Model.OpenPositions</strong></article>
        <article><i class="bi bi-inbox"></i><span>Total Applications</span><strong>@Model.TotalApplications</strong></article>
        <article><i class="bi bi-search"></i><span>Under Review</span><strong>@Model.UnderReview</strong></article>
        <article><i class="bi bi-star"></i><span>Shortlisted Candidates</span><strong>@Model.ShortlistedCandidates</strong></article>
        <article><i class="bi bi-calendar-check"></i><span>Interviews Scheduled</span><strong>@Model.InterviewsScheduled</strong></article>
    </div>

    <nav class="arena-tabs" aria-label="Recruitment views">
        <a class="@(isOpenings ? "active" : "")" href="@TabUrl("openings")" aria-current="@(isOpenings ? "page" : null)"><i class="bi bi-briefcase"></i> Job Openings</a>
        <a class="@(applicationsTab ? "active" : "")" href="@TabUrl("applications")" aria-current="@(applicationsTab ? "page" : null)"><i class="bi bi-inbox"></i> Applications</a>
    </nav>

    @if (isOpenings)
    {
        <section class="arena-card">
            <form class="arena-toolbar" method="get" data-recruitment-filters>
                <input type="hidden" name="tab" value="openings" />
                <div class="arena-search"><i class="bi bi-search"></i><input name="search" value="@Model.OpeningSearch" placeholder="Search by title or reference..." aria-label="Search job openings" autocomplete="off" data-live-search /></div>
                <select name="department" data-filter-select>
                    <option value="">All Departments</option>
                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department" selected="@(Model.OpeningDepartment == department)">@department</option>
                    }
                </select>
                <select name="employmentType" data-filter-select>
                    <option value="">All Employment Types</option>
                    @foreach (EmploymentType value in Enum.GetValues<EmploymentType>())
                    {
                        <option value="@value" selected="@(Model.OpeningEmploymentType == value)">@value.GetDisplayName()</option>
                    }
                </select>
                <select name="openingStatus" data-filter-select>
                    <option value="">All Status</option>
                    @foreach (JobPostingStatus value in Enum.GetValues<JobPostingStatus>())
                    {
                        <option value="@value" selected="@(Model.OpeningStatus == value)">@value.GetDisplayName()</option>
                    }
                </select>
                <select name="openingSort" data-filter-select>
                    <option value="newest" selected="@(Model.OpeningSortBy == "newest")">Newest First</option>
                    <option value="oldest" selected="@(Model.OpeningSortBy == "oldest")">Oldest First</option>
                    <option value="deadline" selected="@(Model.OpeningSortBy == "deadline")">Closing Soonest</option>
                    <option value="title" selected="@(Model.OpeningSortBy == "title")">Title A-Z</option>
                    <option value="vacancies" selected="@(Model.OpeningSortBy == "vacancies")">Most Vacancies</option>
                </select>
                <select name="pageSize" data-filter-select>
                    @foreach (var size in new[] { 10, 25, 50 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
                <a class="admin-secondary-button" asp-action="Index" asp-route-tab="openings"><i class="bi bi-x-circle"></i> Clear</a>
            </form>

            @if (!Model.Openings.Any())
            {
                <div class="arena-empty">
                    <i class="bi bi-briefcase"></i>
                    <h2>@(openingsHasFilters ? "No Matching Job Openings" : "No Job Openings Yet")</h2>
                    <p>@(openingsHasFilters ? "Try changing or clearing your filters." : "Create your first job posting to start advertising openings and collecting applications.")</p>
                    @if (openingsHasFilters)
                    {
                        <a class="admin-secondary-button" asp-action="Index" asp-route-tab="openings"><i class="bi bi-x-circle"></i> Clear Filters</a>
                    }
                    else if (Model.CanManage)
                    {
                        <a class="admin-action-button" asp-controller="JobPostings" asp-action="Create"><i class="bi bi-journal-plus"></i> Add Job Posting</a>
                    }
                </div>
            }
            else
            {
                <div class="recruitment-table-wrap">
                    <table class="arena-table recruitment-table">
                        <thead>
                            <tr>
                                <th scope="col">Job Reference</th>
                                <th scope="col">Job Title</th>
                                <th scope="col">Department</th>
                                <th scope="col">Employment Type</th>
                                <th scope="col">Vacancies</th>
                                <th scope="col">Applications</th>
                                <th scope="col">Deadline</th>
                                <th scope="col">Status</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opening in Model.Openings)
                            {
                                var expired = opening.ApplicationDeadline < DateOnly.FromDateTime(DateTime.UtcNow);
                                <tr data-opening-row="@opening.Id">
                                    <td data-label="Job Reference"><span class="membership-code">@opening.ReferenceNumber</span></td>
                                    <td data-label="Job Title"><strong>@opening.JobTitle</strong><small>@opening.WorkplaceType.GetDisplayName()</small></td>
                                    <td data-label="Department">@opening.Department</td>
                                    <td data-label="Employment Type"><span class="role-badge membership-role-badge">@opening.EmploymentType.GetDisplayName()</span></td>
                                    <td data-label="Vacancies"><strong>@opening.Vacancies</strong> <small>@(opening.Vacancies == 1 ? "position" : "positions")</small></td>
                                    <td data-label="Applications"><strong>@opening.ApplicationCount</strong> <small>@(opening.ApplicationCount == 1 ? "application" : "applications")</small></td>
                                    <td data-label="Deadline">
                                        <strong class="@(expired ? "customer-danger-text" : "")">@opening.ApplicationDeadline.ToString("dd MMM yyyy")</strong>
                                        @if (expired) { <small>Expired</small> }
                                    </td>
                                    <td data-label="Status">
                                        <span class="membership-status-badge hr-tone @opening.Status.GetBadgeClass()"><i></i>@opening.Status.GetDisplayName()</span>
                                    </td>
                                    <td data-label="Actions">
                                        <div class="membership-action-menu">
                                            <a class="membership-icon-button" asp-controller="JobPostings" asp-action="Details" asp-route-id="@opening.Id" data-tooltip="View" aria-label="View job posting"><i class="bi bi-eye"></i></a>
                                            @if (Model.CanManage)
                                            {
                                                <a class="membership-icon-button" asp-controller="JobPostings" asp-action="Edit" asp-route-id="@opening.Id" data-tooltip="Edit" aria-label="Edit job posting"><i class="bi bi-pencil"></i></a>
                                                @if (!expired && opening.Status == JobPostingStatus.Open)
                                                {
                                                    <a class="membership-icon-button" asp-controller="JobApplications" asp-action="Create" asp-route-jobPostingId="@opening.Id" data-tooltip="Add application" aria-label="Add application"><i class="bi bi-person-plus"></i></a>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="arena-pagination">
                    <span>Showing @start-@end of @Model.TotalRecords job openings</span>
                    <nav>
                        <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : OpeningsUrl(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i> Previous</a>
                        @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                        {
                            <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@OpeningsUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                        }
                        <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : OpeningsUrl(Model.CurrentPage + 1))">Next <i class="bi bi-chevron-right"></i></a>
                    </nav>
                </div>
            }
        </section>
    }
    else
    {
        <section class="arena-card">
            <form class="arena-toolbar" method="get" data-recruitment-filters>
                <input type="hidden" name="tab" value="applications" />
                <div class="arena-search"><i class="bi bi-search"></i><input name="search" value="@Model.ApplicationSearch" placeholder="Search by name, reference, or email..." aria-label="Search applications" autocomplete="off" data-live-search /></div>
                <select name="jobPostingId" data-filter-select>
                    <option value="">All Job Postings</option>
                    @foreach (var option in Model.JobPostings)
                    {
                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                    }
                </select>
                <select name="applicationStatus" data-filter-select>
                    <option value="">All Status</option>
                    @foreach (JobApplicationStatus value in Enum.GetValues<JobApplicationStatus>())
                    {
                        <option value="@value" selected="@(Model.ApplicationStatus == value)">@value.GetDisplayName()</option>
                    }
                </select>
                <select name="applicationSort" data-filter-select>
                    <option value="newest" selected="@(Model.ApplicationSortBy == "newest")">Newest First</option>
                    <option value="oldest" selected="@(Model.ApplicationSortBy == "oldest")">Oldest First</option>
                    <option value="name" selected="@(Model.ApplicationSortBy == "name")">Candidate A-Z</option>
                    <option value="status" selected="@(Model.ApplicationSortBy == "status")">Status</option>
                    <option value="position" selected="@(Model.ApplicationSortBy == "position")">Position</option>
                </select>
                <select name="pageSize" data-filter-select>
                    @foreach (var size in new[] { 10, 25, 50 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
                <a class="admin-secondary-button" asp-action="Index" asp-route-tab="applications"><i class="bi bi-x-circle"></i> Clear</a>
            </form>

            @if (!Model.Applications.Any())
            {
                <div class="arena-empty">
                    <i class="bi bi-inbox"></i>
                    <h2>@(applicationsHasFilters ? "No Matching Applications" : "No Applications Yet")</h2>
                    <p>@(applicationsHasFilters ? "Try changing or clearing your filters." : "Applications submitted against your job postings will appear here for review.")</p>
                    @if (applicationsHasFilters)
                    {
                        <a class="admin-secondary-button" asp-action="Index" asp-route-tab="applications"><i class="bi bi-x-circle"></i> Clear Filters</a>
                    }
                    else if (Model.CanManage)
                    {
                        <a class="admin-action-button" asp-controller="JobApplications" asp-action="Create"><i class="bi bi-person-plus"></i> Add Application</a>
                    }
                </div>
            }
            else
            {
                <div class="recruitment-table-wrap">
                    <table class="arena-table recruitment-table">
                        <thead>
                            <tr>
                                <th scope="col">Application Reference</th>
                                <th scope="col">Candidate Name</th>
                                <th scope="col">Job Title</th>
                                <th scope="col">Email</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Applied</th>
                                <th scope="col">Status</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in Model.Applications)
                            {
                                var actionable = application.Status != JobApplicationStatus.Hired
                                    && application.Status != JobApplicationStatus.Rejected;
                                <tr data-application-row="@application.Id">
                                    <td data-label="Application Reference"><span class="membership-code">@application.ApplicationNumber</span></td>
                                    <td data-label="Candidate Name">
                                        <div class="user-cell customer-identity">
                                            <span class="user-avatar membership-table-avatar">@application.Initials</span>
                                            <div>
                                                <strong>@application.CandidateName</strong>
                                                <small>@application.JobReference</small>
                                                @if (application.InterviewsScheduled > 0)
                                                {
                                                    <em>@application.InterviewsScheduled interview@(application.InterviewsScheduled == 1 ? "" : "s")</em>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Job Title"><strong>@application.JobTitle</strong></td>
                                    <td data-label="Email">@application.Email</td>
                                    <td data-label="Phone">@application.Phone</td>
                                    <td data-label="Applied">@application.ApplicationDate.ToString("dd MMM yyyy")</td>
                                    <td data-label="Status">
                                        <span class="membership-status-badge hr-tone @application.Status.GetBadgeClass()"><i></i>@application.Status.GetDisplayName()</span>
                                    </td>
                                    <td data-label="Actions">
                                        <div class="membership-action-menu">
                                            <a class="membership-icon-button" asp-controller="JobApplications" asp-action="Details" asp-route-id="@application.Id" data-tooltip="View" aria-label="View application"><i class="bi bi-eye"></i></a>
                                            @if (Model.CanManage)
                                            {
                                                <a class="membership-icon-button" asp-controller="JobApplications" asp-action="Edit" asp-route-id="@application.Id" data-tooltip="Edit" aria-label="Edit application"><i class="bi bi-pencil"></i></a>
                                                @if (actionable && application.Status != JobApplicationStatus.Shortlisted)
                                                {
                                                    <form method="post" asp-controller="JobApplications" asp-action="Shortlist" asp-route-id="@application.Id" class="membership-inline-form"
                                                          data-hr-confirm-form data-confirm-title="Shortlist Candidate"
                                                          data-confirm-message="Shortlist @application.CandidateName for @application.JobTitle?">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button class="membership-icon-button" type="submit" data-tooltip="Shortlist" aria-label="Shortlist candidate"><i class="bi bi-star"></i></button>
                                                    </form>
                                                }
                                                @if (actionable)
                                                {
                                                    <form method="post" asp-controller="JobApplications" asp-action="Reject" asp-route-id="@application.Id" class="membership-inline-form"
                                                          data-hr-confirm-form data-confirm-title="Reject Application" data-confirm-danger="true"
                                                          data-confirm-message="Reject the application from @application.CandidateName? This cannot be undone.">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button class="membership-icon-button is-danger" type="submit" data-tooltip="Reject" aria-label="Reject application"><i class="bi bi-x-circle"></i></button>
                                                    </form>
                                                }
                                                <a class="membership-icon-button" asp-controller="JobApplications" asp-action="ScheduleInterview" asp-route-id="@application.Id" data-tooltip="Schedule interview" aria-label="Schedule interview"><i class="bi bi-calendar-plus"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="arena-pagination">
                    <span>Showing @start-@end of @Model.TotalRecords applications</span>
                    <nav>
                        <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : ApplicationsUrl(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i> Previous</a>
                        @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                        {
                            <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@ApplicationsUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                        }
                        <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : ApplicationsUrl(Model.CurrentPage + 1))">Next <i class="bi bi-chevron-right"></i></a>
                    </nav>
                </div>
            }
        </section>
    }
</section>

<div class="modal fade customer-modal" id="hrConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" data-hr-confirm-title>Confirm Action</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><p data-hr-confirm-message>Are you sure?</p></div>
            <div class="modal-footer">
                <button type="button" class="admin-secondary-button" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="admin-action-button" data-hr-confirm-submit>Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr-forms.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/hr-recruitment.js" asp-append-version="true"></script>
}
