@model PaymentReceiptViewModel
@using GameHub.Helpers
@{var payment=Model.Payment;var settings=Model.Settings;var receiptNumber="RCP-"+payment.PaymentNumber.Replace("PAY-","");ViewData["Title"]=$"Receipt {receiptNumber}";Layout="_AdminLayout";}
<section class="users-page customer-profile-page sales-cycle-page sales-document-page"><header class="customer-profile-header admin-reveal no-print"><div class="customer-profile-title"><a class="customer-back-link" asp-action="Details" asp-route-id="@payment.Id"><i class="bi bi-arrow-left"></i> Back to Payment</a><span class="admin-label">Payment Receipt</span><h1>Receipt @receiptNumber</h1><p>Customer-ready confirmation for payment @payment.PaymentNumber.</p></div><div class="customer-detail-actions"><button class="admin-secondary-button" type="button" data-doc-print data-document-id="receiptDocument"><i class="bi bi-printer"></i> Print</button><button class="admin-action-button" type="button" data-doc-download data-document-id="receiptDocument"><i class="bi bi-download"></i> Download / Save PDF</button><div class="membership-action-menu"><button class="membership-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More receipt actions"><i class="bi bi-three-dots"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-action="Details" asp-route-id="@payment.Id"><i class="bi bi-arrow-left"></i> Back to details</a></li><li><a class="dropdown-item" asp-controller="Invoices" asp-action="Details" asp-route-id="@payment.InvoiceId"><i class="bi bi-receipt"></i> View invoice</a></li><li><a class="dropdown-item" asp-action="Index"><i class="bi bi-wallet2"></i> Back to payments</a></li></ul></div></div></header><article id="receiptDocument" class="accounting-document payment-receipt-document document-print-root" data-document-preview><header class="payment-receipt-hero"><div class="payment-receipt-brand"><span class="payment-receipt-logo">G</span><div><strong>@settings.ArenaName</strong><small>Premium sports arena</small><p>@settings.Address<br />@settings.Phone · @settings.Email</p></div></div><div class="payment-receipt-title"><span>PAYMENT RECEIPT</span><h1>@receiptNumber</h1><small>Payment @payment.PaymentNumber</small></div></header><div class="payment-receipt-rule"></div><section class="payment-receipt-meta"><div><span>Received from</span><h2>@payment.Customer.FullName</h2><p>@payment.Customer.CustomerCode<br />@(payment.Customer.Email??"Email not provided")<br />@payment.Customer.PrimaryPhone</p></div><div><span>Payment details</span><dl><div><dt>Invoice</dt><dd>@payment.Invoice.InvoiceNumber</dd></div><div><dt>Payment date</dt><dd>@payment.PaymentDate.ToString("dd MMM yyyy")</dd></div><div><dt>Method</dt><dd>@payment.PaymentMethod.GetDisplayName()</dd></div><div><dt>Reference</dt><dd>@(payment.ReferenceNumber??"Not provided")</dd></div></dl></div></section><section class="payment-receipt-amount"><small>Amount received</small><strong>@payment.CurrencySymbol @payment.Amount.ToString("N2")</strong><span><i class="bi bi-check-circle"></i> Payment recorded successfully</span></section><section class="payment-receipt-balance"><div><span>Invoice total</span><strong>@payment.CurrencySymbol @payment.Invoice.GrandTotal.ToString("N2")</strong></div><div><span>Paid to date</span><strong>@payment.CurrencySymbol @payment.Invoice.PaidAmount.ToString("N2")</strong></div><div class="remaining"><span>Remaining balance</span><strong>@payment.CurrencySymbol @payment.Invoice.OutstandingAmount.ToString("N2")</strong></div></section>@if(!string.IsNullOrWhiteSpace(payment.Notes)){<section class="payment-receipt-note"><span>Notes</span><p>@payment.Notes</p></section>}<footer class="payment-receipt-footer"><div><strong>Thank you for your payment.</strong><p>Received by @payment.ReceivedByUser.FullName · @settings.ArenaName<br />Support: @settings.Email · @settings.Phone</p></div><div><span>Receipt status</span><strong>Recorded</strong><small>Generated from GameHub ERP</small></div></footer></article></section>
@section Styles{<link rel="stylesheet" href="~/css/sales.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/customer-documents.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/customer-documents-print.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/payments.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/payment-receipt.css" asp-append-version="true"/>}
@section Scripts{<script src="~/js/document-print.js" asp-append-version="true"></script>}
