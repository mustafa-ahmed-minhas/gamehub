@model BookingFormViewModel
@using GameHub.Helpers
@using GameHub.Models.Enums
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Booking" : "Create Booking";
    Layout = "_AdminLayout";
    var action = Model.IsEditMode ? "Edit" : "Create";
    var minDate = Model.MinBookingDate.ToString("yyyy-MM-dd");
    var maxDate = Model.MaxBookingDate.ToString("yyyy-MM-dd");
    var slotDuration = Model.SlotDurationMinutes > 0 ? Model.SlotDurationMinutes : 60;
    var money = (decimal amount) => $"{Model.CurrencySymbol} {amount:N2}";
}
<section class="booking-form-page">
    <header class="booking-hero">
        <div>
            <span class="admin-label">GUIDED RESERVATION</span>
            <h1>@(Model.IsEditMode ? "Edit Booking" : "Create Booking")</h1>
            <p>Search a customer, pick the court and slot, and GameHub prices the reservation from live master data.</p>
        </div>
        <a class="booking-btn booking-btn-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i><span>Back to Bookings</span></a>
    </header>

    <form class="booking-form-grid" asp-action="@action" asp-route-id="@Model.Id" method="post" data-booking-form data-currency="@Model.CurrencySymbol" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="DurationMinutes" type="hidden" data-duration value="@Model.DurationMinutes" />
        <input asp-for="PlayerCount" type="hidden" value="1" />
        <input asp-for="StartTime" type="hidden" data-start-time value="@Model.StartTime.ToString("HH:mm")" />
        <input asp-for="EndTime" type="hidden" data-end-time value="@Model.EndTime.ToString("HH:mm")" />
        <main class="booking-form-main">
            <div asp-validation-summary="ModelOnly" class="text-danger booking-validation-summary"></div>

            <section class="booking-form-card">
                <h2><i class="bi bi-person"></i> Customer</h2>
                <div class="booking-field">
                    <span>Customer <em>*</em></span>
                    <div class="booking-autocomplete">
                        <i class="bi bi-search"></i>
                        <input type="text" id="customerSearch" data-customer-search placeholder="Search by name, phone or customer code..." autocomplete="off" role="combobox" aria-expanded="false" aria-controls="customerResults" aria-autocomplete="list" value="@Model.CustomerDisplayName" />
                        <button type="button" class="booking-autocomplete-clear" data-customer-clear title="Clear customer" hidden><i class="bi bi-x-circle"></i></button>
                        <div id="customerResults" class="customer-results" data-customer-results role="listbox"></div>
                    </div>
                    <input asp-for="CustomerId" type="hidden" data-customer-id />
                    <small asp-validation-for="CustomerId"></small>
                    <small class="booking-field-error" data-field-error="CustomerId" hidden></small>
                    <small class="booking-helper">Type at least two characters. Only matching customers are searched and the booking is stored by customer id.</small>
                </div>
                <div class="booking-summary-panel" data-customer-summary>
                    <i class="bi bi-person-badge"></i>
                    <p>Select a customer to preview profile, membership status, loyalty points and blacklist warnings.</p>
                </div>
            </section>

            <section class="booking-form-card">
                <h2><i class="bi bi-grid"></i> Sport, Facility &amp; Court</h2>
                <div class="booking-form-two">
                    <label class="booking-field">
                        <span>Sport <em>*</em></span>
                        <select asp-for="SportId" asp-items="Model.Sports" data-sport-select><option value="">Select sport</option></select>
                        <small asp-validation-for="SportId"></small>
                    </label>
                    <label class="booking-field">
                        <span>Facility <em>*</em></span>
                        <select asp-for="FacilityId" asp-items="Model.Facilities" data-facility-select><option value="">Select facility</option></select>
                        <small asp-validation-for="FacilityId"></small>
                    </label>
                    <label class="booking-field span-two">
                        <span>Court <em>*</em></span>
                        <select asp-for="CourtId" asp-items="Model.Courts" data-court-select><option value="">Select court</option></select>
                        <small asp-validation-for="CourtId"></small>
                        <small class="booking-helper">Slots, duration and pricing are loaded from the selected court.</small>
                    </label>
                </div>
            </section>

            <section class="booking-form-card">
                <h2><i class="bi bi-calendar-range"></i> Schedule</h2>
                <div class="booking-form-two">
                    <label class="booking-field">
                        <span>Booking Date <em>*</em></span>
                        <input asp-for="BookingDate" type="date" data-booking-date min="@minDate" max="@maxDate" />
                        <small asp-validation-for="BookingDate"></small>
                        <small class="booking-field-error" data-field-error="BookingDate" hidden></small>
                        <small class="booking-helper">Bookings are open from @minDate to @maxDate.</small>
                    </label>
                    <div class="booking-field">
                        <span>Time Slot <em>*</em></span>
                        <p class="booking-slot-hint" data-slot-hint>Slots are @slotDuration minutes long and follow the court schedule.</p>
                        <small asp-validation-for="StartTime"></small>
                        <small asp-validation-for="DurationMinutes"></small>
                        <small class="booking-field-error" data-field-error="StartTime" hidden></small>
                    </div>
                </div>
                <div class="booking-slot-grid" data-slot-grid><div class="booking-slot-empty">Choose a court and date to load available slots.</div></div>
                <div class="booking-helper" data-slot-status></div>
            </section>

            <section class="booking-form-card">
                <h2><i class="bi bi-cash-stack"></i> Pricing &amp; Payment</h2>
                <div class="booking-form-two">
                    <label class="booking-field">
                        <span>Manual Discount</span>
                        <input asp-for="ManualDiscountAmount" type="number" min="0" step="0.01" data-manual-discount readonly="@(!Model.CanManualDiscount || Model.HasFinancialRecords)" />
                        <span asp-validation-for="ManualDiscountAmount"></span>
                        <small class="booking-field-error" data-field-error="ManualDiscountAmount" hidden></small>
                        @if (Model.HasFinancialRecords)
                        {
                            <small class="booking-helper">Locked because this booking already has a sales order, invoice and payment.</small>
                        }
                        else if (!Model.CanManualDiscount)
                        {
                            <small class="booking-helper">Only Super Admin and Admin can apply a manual discount.</small>
                        }
                    </label>
                    <label class="booking-field">
                        <span>Amount Paid</span>
                        <input asp-for="PaidAmount" type="number" min="0" step="0.01" data-paid-amount readonly="@Model.HasFinancialRecords" />
                        <span asp-validation-for="PaidAmount"></span>
                        <small class="booking-field-error" data-field-error="PaidAmount" hidden></small>
                        @if (Model.HasFinancialRecords)
                        {
                            <small class="booking-helper">Locked because this booking already has a sales order, invoice and payment.</small>
                        }
                        else
                        {
                            <small class="booking-helper">Enter either 0 or the full total. Partial payments are not supported.</small>
                        }
                    </label>
                    <label class="booking-field">
                        <span>Status</span>
                        <select asp-for="Status" asp-items="Model.StatusOptions" data-status-select></select>
                        <small asp-validation-for="Status"></small>
                        <small class="booking-field-error" data-field-error="Status" hidden></small>
                        <small class="booking-helper">Manual bookings are confirmed directly, they never wait for approval.</small>
                    </label>
                    <label class="booking-field">
                        <span>Source</span>
                        <select asp-for="Source" asp-items="Model.SourceOptions" data-source-select></select>
                        <small asp-validation-for="Source"></small>
                        <small class="booking-field-error" data-field-error="Source" hidden></small>
                    </label>
                </div>
                <div class="booking-price-panel" data-price-panel>
                    <div><span>Base Price</span><strong data-price-base>@money(Model.PriceSummary.BaseAmount)</strong></div>
                    <div><span>Membership Discount</span><strong data-price-membership>@money(Model.PriceSummary.MembershipDiscountAmount)</strong></div>
                    <div><span>Manual Discount</span><strong data-price-manual>@money(Model.PriceSummary.ManualDiscountAmount)</strong></div>
                    <div><span>Tax</span><strong data-price-tax>@money(Model.PriceSummary.TaxAmount)</strong></div>
                    <div class="booking-price-total"><span>Final Total</span><strong data-price-total>@money(Model.PriceSummary.TotalAmount)</strong></div>
                    <div><span>Amount Paid</span><strong data-price-paid>@money(Model.PriceSummary.PaidAmount)</strong></div>
                    <div><span>Remaining Balance</span><strong data-price-balance>@money(Model.PriceSummary.BalanceAmount)</strong></div>
                </div>
                <p class="booking-price-note" data-price-note hidden></p>
            </section>

            <section class="booking-form-card">
                <h2><i class="bi bi-journal-text"></i> Additional Information</h2>
                <div class="booking-form-two">
                    <label class="booking-field span-two">
                        <span>Reference Number</span>
                        <input asp-for="ReferenceNumber" />
                        <small asp-validation-for="ReferenceNumber"></small>
                    </label>
                    <label class="booking-field span-two">
                        <span>Customer Notes</span>
                        <textarea asp-for="CustomerNotes"></textarea>
                        <small asp-validation-for="CustomerNotes"></small>
                    </label>
                    <label class="booking-field span-two">
                        <span>Special Request</span>
                        <textarea asp-for="SpecialRequest"></textarea>
                        <small asp-validation-for="SpecialRequest"></small>
                    </label>
                    <label class="booking-field span-two">
                        <span>Internal Notes</span>
                        <textarea asp-for="InternalNotes"></textarea>
                        <small asp-validation-for="InternalNotes"></small>
                    </label>
                </div>
            </section>

            <div class="booking-save-bar">
                <a class="booking-btn booking-btn-secondary" asp-action="Index">Cancel</a>
                <button class="booking-btn booking-btn-primary" type="submit" data-booking-submit><i class="bi bi-check2-circle"></i><span>Save Booking</span></button>
            </div>
        </main>

        <aside class="booking-live-summary" data-live-summary>
            <span>@Model.ArenaName</span>
            <h2>@(Model.BookingNumber ?? "New Booking")</h2>
            <p>Complete the booking details to preview the reservation.</p>
            <dl>
                <div><dt>Customer</dt><dd data-summary-customer>@(string.IsNullOrWhiteSpace(Model.CustomerDisplayName) ? "Not selected" : Model.CustomerDisplayName)</dd></div>
                <div><dt>Sport</dt><dd data-summary-sport>Not selected</dd></div>
                <div><dt>Facility</dt><dd data-summary-facility>Not selected</dd></div>
                <div><dt>Court</dt><dd data-summary-court>Not selected</dd></div>
                <div><dt>Date</dt><dd data-summary-date>@Model.BookingDate.ToString("dd MMM yyyy")</dd></div>
                <div><dt>Time</dt><dd data-summary-time>@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</dd></div>
                <div><dt>Duration</dt><dd data-summary-duration>@Model.DurationMinutes min</dd></div>
                <div><dt>Status</dt><dd data-summary-status>@Model.Status.GetDisplayName()</dd></div>
                <div><dt>Total</dt><dd data-summary-total>@money(Model.PriceSummary.TotalAmount)</dd></div>
                <div><dt>Balance</dt><dd data-summary-balance>@money(Model.PriceSummary.BalanceAmount)</dd></div>
            </dl>
        </aside>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
