@model IReadOnlyList<CustomerBookingRequest>
@{ ViewData["Title"] = "Customer Requests"; Layout = "_AdminLayout"; }
<div class="admin-page-shell"><div class="admin-page-header"><div><span class="admin-kicker">Booking Management</span><h1>Customer Requests</h1></div></div><div class="admin-card"><table class="admin-table"><thead><tr><th>Customer</th><th>Booking</th><th>Type</th><th>Requested Time</th><th>Reason</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Customer.FullName</td><td>@r.Booking.BookingNumber<br />@r.Booking.Court.Name</td><td>@r.RequestType.GetDisplayName()</td><td>@(r.RequestedDate?.ToString("MMM dd")) @(r.RequestedStartTime?.ToString("hh:mm tt"))</td><td>@r.Reason</td><td>@r.Status.GetDisplayName()</td><td>@if(r.Status == CustomerBookingRequestStatus.Pending){<form asp-action="ApproveCustomerRequest" asp-route-id="@r.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="admin-btn admin-btn-primary">Approve</button></form><form asp-action="RejectCustomerRequest" asp-route-id="@r.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="admin-btn admin-btn-secondary">Reject</button></form>}</td></tr>}</tbody></table></div></div>
