@model RefundDetailsViewModel
@using GameHub.Models.Enums
@{
    ViewData["Title"] = "Refund Details - " + Model.Refund.RefundNumber;
    Layout = "_AdminLayout";
    ViewData["BookingGuidance"] = "refunds";
    ViewData["BookingGuidanceRail"] = false;
    ViewData["PendingRefunds"] = 0;
    ViewData["FailedRefunds"] = 0;
    ViewData["TotalRefundAmount"] = Model.CurrencySymbol + " " + Model.Refund.Amount.ToString("N0");
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" />
    <style>
        .crm-lead-view-page.rd-page {
            --rd-gold: #b8892f;
            --rd-gold-light: #f1d695;
            --rd-ink: #171614;
            --rd-muted: #6d6458;
            --rd-line: rgba(184, 137, 47, .16);
            --rd-soft: #fff8ee;
            --rd-shadow: 0 12px 30px rgba(17, 16, 14, .05);
            --rd-shadow-hover: 0 18px 42px rgba(17, 16, 14, .09);
            --rd-radius: 18px;
        }

        /* Hero */
        .rd-hero {
            background: linear-gradient(135deg, #fff 0%, #fffaf3 100%);
            border: 1px solid var(--rd-line);
            border-radius: var(--rd-radius);
            box-shadow: var(--rd-shadow);
            padding: 24px 28px;
            position: relative;
            overflow: hidden;
        }
        .rd-hero::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--rd-gold), var(--rd-gold-light), var(--rd-gold));
        }
        .rd-hero-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }
        .rd-breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .8rem;
            font-weight: 700;
            color: var(--rd-muted);
        }
        .rd-breadcrumb a { color: var(--rd-muted); text-decoration: none; transition: color .2s ease; }
        .rd-breadcrumb a:hover { color: var(--rd-gold); }
        .rd-breadcrumb span { color: var(--rd-ink); font-weight: 800; }
        .rd-breadcrumb i { font-size: .7rem; opacity: .6; }
        .rd-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
        }
        .rd-btn {
            border-radius: 12px;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            font-size: .82rem;
            padding: 0 16px;
            border: 1px solid transparent;
            text-decoration: none;
            cursor: pointer;
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }
        .rd-btn:hover { transform: translateY(-1px); }
        .rd-btn-primary {
            background: linear-gradient(135deg, var(--rd-gold-light), var(--rd-gold));
            color: #11100e;
            box-shadow: 0 6px 16px rgba(184, 137, 47, .2);
        }
        .rd-btn-success {
            background: #e4f8ec;
            color: #17613a;
            border-color: #c6ecd5;
        }
        .rd-btn-success:hover { background: #d6f2e1; border-color: #a8e0bf; }
        .rd-btn-secondary {
            background: #fff;
            color: var(--rd-ink);
            border-color: var(--rd-line);
        }
        .rd-btn-secondary:hover { border-color: var(--rd-gold); color: var(--rd-gold); }

        .rd-hero-main {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }
        .rd-identity {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
        }
        .rd-avatar {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--rd-gold-light), var(--rd-gold));
            color: #11100e;
            display: grid;
            place-items: center;
            font-size: 1.25rem;
            font-weight: 800;
            flex-shrink: 0;
            box-shadow: 0 8px 20px rgba(184, 137, 47, .22);
        }
        .rd-kicker {
            color: var(--rd-gold);
            font-weight: 800;
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .08em;
        }
        .rd-identity h1 {
            font-size: clamp(1.45rem, 2.6vw, 2rem);
            font-weight: 900;
            color: var(--rd-ink);
            margin: 2px 0 6px;
            letter-spacing: -.01em;
            line-height: 1.15;
        }
        .rd-subtitle {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--rd-muted);
            font-weight: 600;
            font-size: .9rem;
            flex-wrap: wrap;
            margin: 0;
        }
        .rd-dot {
            width: 5px; height: 5px; border-radius: 50%;
            background: var(--rd-gold); flex-shrink: 0;
        }
        .rd-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }
        .rd-badge {
            padding: 6px 12px;
            border-radius: 999px;
            font-weight: 800;
            font-size: .7rem;
            letter-spacing: .01em;
            border: 1px solid var(--rd-line);
            background: var(--rd-soft);
            color: #7a5517;
        }
        .rd-badge-status-completed { background: #e4f8ec; color: #17613a; border-color: #c6ecd5; }
        .rd-badge-status-failed { background: #ffe7e7; color: #9b2828; border-color: #f2caca; }
        .rd-badge-status-pending { background: #fff3d9; color: #7a5517; border-color: #f2cf9a; }
        .rd-badge-status-processing { background: #edf3ff; color: #2f5b9a; border-color: #c9e0ff; }
        .rd-badge-status-cancelled { background: #f4f0e8; color: var(--rd-muted); border-color: var(--rd-line); }
        .rd-badge-reason-bookingrejected { background: #fff0dc; color: #9a5200; }
        .rd-badge-reason-customercancellation { background: #ffe7e7; color: #9b2828; }
        .rd-badge-reason-courtunavailable { background: #edf3ff; color: #2f5b9a; }
        .rd-badge-method-gatewayrefund { background: #e4f8ec; color: #17613a; }
        .rd-badge-method-manualrefund { background: #fff3d9; color: #7a5517; }
        .rd-badge-method-walletcredit { background: #edf3ff; color: #2f5b9a; }

        .rd-key-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 16px 28px;
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid var(--rd-line);
        }
        .rd-key-item { display: grid; gap: 2px; min-width: 120px; }
        .rd-key-item span { color: var(--rd-muted); font-weight: 700; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; }
        .rd-key-item strong { color: var(--rd-ink); font-weight: 900; font-size: .95rem; }

        /* Lifecycle */
        .rd-lifecycle-wrap { margin: 22px 0 0; }
        .rd-lifecycle-label { color: var(--rd-muted); font-weight: 800; font-size: .74rem; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
        .rd-lifecycle-label i { color: var(--rd-gold); }
        .rd-lifecycle {
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: 1fr;
            gap: 0;
            background: var(--rd-soft);
            border-radius: 12px;
            padding: 4px;
            border: 1px solid var(--rd-line);
        }
        .rd-lifecycle span {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 11px 8px;
            font-weight: 800;
            font-size: .78rem;
            color: var(--rd-muted);
            transition: all .3s ease;
        }
        .rd-lifecycle span::after {
            content: "";
            position: absolute;
            top: 50%; right: 0;
            width: 1px; height: 55%;
            background: var(--rd-line);
            transform: translateY(-50%);
        }
        .rd-lifecycle span:last-child::after { display: none; }
        .rd-lifecycle span.active {
            background: linear-gradient(135deg, var(--rd-gold-light), var(--rd-gold));
            color: #11100e;
            border-radius: 9px;
            box-shadow: 0 4px 12px rgba(184, 137, 47, .2);
        }
        .rd-lifecycle span.terminal { background: #f4f0e8; color: var(--rd-muted); }
        .rd-lifecycle span i { margin-right: 5px; font-size: .85rem; }

        /* Two-column grid */
        .rd-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
            margin-top: 24px;
            align-items: stretch;
        }
        .rd-panel {
            background: #fff;
            border: 1px solid var(--rd-line);
            border-radius: var(--rd-radius);
            box-shadow: var(--rd-shadow);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .rd-panel:hover { transform: translateY(-2px); box-shadow: var(--rd-shadow-hover); }
        .rd-panel-wide { grid-column: 1 / -1; }
        .rd-panel-head {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 20px 22px 14px;
            border-bottom: 1px solid var(--rd-line);
        }
        .rd-panel-icon {
            width: 36px; height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--rd-soft), #fff3d9);
            color: var(--rd-gold);
            display: grid; place-items: center;
            font-size: 1.05rem;
            flex-shrink: 0;
        }
        .rd-panel-head h2 { font-size: 1.02rem; font-weight: 900; margin: 0; color: var(--rd-ink); }
        .rd-panel-head p { margin: 3px 0 0; color: var(--rd-muted); font-weight: 600; font-size: .78rem; }
        .rd-panel-body { padding: 14px 22px 20px; display: grid; gap: 2px; }
        .rd-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 12px;
            align-items: start;
            padding: 9px 0;
            border-bottom: 1px solid rgba(184, 137, 47, .07);
        }
        .rd-row:last-child { border-bottom: none; }
        .rd-row dt { color: var(--rd-muted); font-weight: 800; font-size: .78rem; }
        .rd-row dd { margin: 0; font-weight: 600; font-size: .88rem; color: var(--rd-ink); line-height: 1.45; word-break: break-word; }
        .rd-row.danger dt { color: #9b2828; }
        .rd-row dd code {
            background: #f4f0e8;
            padding: 3px 7px;
            border-radius: 6px;
            font-size: .76rem;
            font-weight: 700;
            color: var(--rd-ink);
            border: 1px solid var(--rd-line);
        }
        .rd-muted { color: var(--rd-muted) !important; font-weight: 600; }
        .rd-danger-text { color: #9b2828; font-weight: 700; }

        /* Empty state */
        .rd-empty {
            padding: 26px 22px;
            text-align: center;
            background: var(--rd-soft);
            border: 1px dashed var(--rd-line);
            border-radius: 14px;
            margin: 8px 22px 20px;
        }
        .rd-empty i { width: 44px; height: 44px; border-radius: 12px; background: #fff3d9; color: var(--rd-gold); display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem; margin-bottom: 8px; }
        .rd-empty strong { color: var(--rd-ink); font-size: .92rem; display: block; margin-bottom: 3px; }
        .rd-empty span { color: var(--rd-muted); font-size: .78rem; font-weight: 600; }

        /* Table */
        .rd-table-card {
            background: #fff;
            border: 1px solid var(--rd-line);
            border-radius: 14px;
            box-shadow: var(--rd-shadow);
            margin: 8px 22px 20px;
            overflow: hidden;
        }
        .rd-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            min-width: 100%;
        }
        .rd-table thead th {
            background: linear-gradient(180deg, #fffaf3, #fff6e9);
            color: var(--rd-muted);
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 900;
            padding: 12px 14px;
            border-bottom: 1px solid var(--rd-line);
            text-align: left;
        }
        .rd-table tbody tr { transition: background .18s ease; }
        .rd-table tbody tr:hover { background: #fffaf3; }
        .rd-table td { padding: 12px 14px; border-bottom: 1px solid rgba(184, 137, 47, .08); vertical-align: middle; font-size: .85rem; }
        .rd-table tbody tr:last-child td { border-bottom: none; }
        .rd-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 800;
            background: var(--rd-soft);
            color: #7a5517;
            border: 1px solid var(--rd-line);
        }
        .rd-status-badge i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

        /* Timeline */
        .rd-timeline { padding: 8px 22px 20px; display: grid; gap: 12px; }
        .rd-timeline-item { display: grid; grid-template-columns: 24px 1fr; gap: 12px; position: relative; }
        .rd-timeline-item::before {
            content: "";
            position: absolute;
            left: 11px; top: 26px; bottom: -12px;
            width: 2px;
            background: linear-gradient(var(--rd-line), transparent);
        }
        .rd-timeline-item:last-child::before { display: none; }
        .rd-timeline-dot {
            width: 24px; height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--rd-gold-light), var(--rd-gold));
            display: grid; place-items: center;
            color: #11100e;
            flex-shrink: 0;
            margin-top: 2px;
            box-shadow: 0 4px 10px rgba(184, 137, 47, .22);
        }
        .rd-timeline-dot i { font-size: .55rem; }
        .rd-timeline-copy {
            background: #fff;
            border: 1px solid var(--rd-line);
            border-radius: 12px;
            padding: 12px 14px;
        }
        .rd-timeline-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 6px;
        }
        .rd-timeline-top strong { font-weight: 800; color: var(--rd-ink); font-size: .88rem; }
        .rd-timeline-top time { color: var(--rd-muted); font-size: .72rem; font-weight: 700; white-space: nowrap; }
        .rd-timeline-type {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 999px;
            background: var(--rd-soft);
            color: var(--rd-gold);
            font-size: .62rem;
            font-weight: 800;
            margin-bottom: 6px;
        }
        .rd-timeline-copy p { margin: 0 0 4px; color: var(--rd-ink); font-size: .83rem; line-height: 1.5; }
        .rd-timeline-copy small { color: var(--rd-muted); font-weight: 600; font-size: .7rem; }

        /* Responsive */
        @@media (max-width: 980px) {
            .rd-grid { grid-template-columns: 1fr; }
            .rd-hero-main { flex-direction: column; align-items: flex-start; }
            .rd-hero-actions { width: 100%; }
            .rd-hero-actions .rd-btn { flex: 1 1 auto; justify-content: center; }
            .rd-key-strip { gap: 14px 20px; }
        }
        @@media (max-width: 640px) {
            .rd-hero { padding: 20px; }
            .rd-row { grid-template-columns: 1fr; gap: 4px; }
            .rd-row dt { margin-bottom: 2px; }
            .rd-panel-head { padding: 16px 18px 12px; }
            .rd-panel-body { padding: 12px 18px 16px; }
            .rd-timeline-item { grid-template-columns: 1fr; }
            .rd-timeline-item::before { display: none; }
            .rd-timeline-dot { width: 32px; height: 32px; margin: 0 auto 6px; }
            .rd-lifecycle { grid-auto-flow: row; grid-auto-columns: 1fr; }
            .rd-lifecycle span::after { display: none; }
        }
    </style>
}

<section class="crm-page crm-page-pro crm-lead-view-page rd-page">
    <header class="rd-hero">
        <div class="rd-hero-top">
            <nav class="rd-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Bookings" asp-action="Index">Bookings</a>
                <i class="bi bi-chevron-right"></i>
                <a asp-action="Refunds">Refunds</a>
                <i class="bi bi-chevron-right"></i>
                <span>@Model.Refund.RefundNumber</span>
            </nav>
            <div class="rd-hero-actions">
                @if (Model.ShowRetryButton)
                {
                    <form method="post" asp-action="RetryRefund" asp-route-id="@Model.Refund.Id" class="d-inline" data-booking-action data-message="Retry this gateway refund?">
                        <button type="submit" class="rd-btn rd-btn-primary"><i class="bi bi-arrow-clockwise"></i> Retry Gateway Refund</button>
                    </form>
                }
                @if (Model.ShowCompleteManualButton)
                {
                    <button type="button" class="rd-btn rd-btn-success" data-bs-toggle="modal" data-bs-target="#completeManualRefundModal"><i class="bi bi-check2-circle"></i> Complete Manual Refund</button>
                }
                <a class="rd-btn rd-btn-secondary" asp-action="Refunds"><i class="bi bi-arrow-left"></i> Back to Refunds</a>
            </div>
        </div>

        <div class="rd-hero-main">
            <div class="rd-identity">
                <span class="rd-avatar"><i class="bi bi-arrow-return-left"></i></span>
                <div>
                    <span class="rd-kicker">Refund Profile</span>
                    <h1>@Model.Refund.RefundNumber</h1>
                    <p class="rd-subtitle">
                        <span>@Model.Booking.BookingNumber</span>
                        <span class="rd-dot"></span>
                        <span>@Model.Booking.Customer.FirstName @Model.Booking.Customer.LastName (@Model.Booking.Customer.CustomerCode)</span>
                    </p>
                </div>
            </div>
            <div class="rd-badges">
                <span class="rd-badge rd-badge-status-@Model.Refund.Status.ToString().ToLowerInvariant()">@Model.StatusDisplayName</span>
                <span class="rd-badge rd-badge-reason-@Model.Refund.Reason.ToString().ToLowerInvariant()">@Model.ReasonDisplayName</span>
                <span class="rd-badge rd-badge-method-@Model.Refund.Method.ToString().ToLowerInvariant()">@Model.MethodDisplayName</span>
            </div>
        </div>

        <div class="rd-key-strip">
            <div class="rd-key-item"><span>Refund Amount</span><strong>@Model.CurrencySymbol @Model.Refund.Amount.ToString("N0")</strong></div>
            <div class="rd-key-item"><span>Payment Method</span><strong>@Model.MethodDisplayName</strong></div>
            <div class="rd-key-item"><span>Refund Date</span><strong>@Model.Refund.InitiatedAt.ToString("dd MMM yyyy")</strong></div>
            <div class="rd-key-item"><span>Status</span><strong>@Model.StatusDisplayName</strong></div>
        </div>
    </header>

    <div class="rd-lifecycle-wrap">
        <div class="rd-lifecycle-label"><i class="bi bi-signpost-split"></i> Refund Lifecycle</div>
        <div class="rd-lifecycle">
            <span class="@(Model.Refund.Status == RefundStatus.Pending || Model.Refund.Status == RefundStatus.Processing ? "active" : "") @(Model.Refund.Status == RefundStatus.Cancelled ? "terminal" : "")">
                @if (Model.Refund.Status == RefundStatus.Pending || Model.Refund.Status == RefundStatus.Processing) { <i class="bi bi-check2"></i> }
                Pending
            </span>
            <span class="@(Model.Refund.Status == RefundStatus.Processing ? "active" : "") @(Model.Refund.Status == RefundStatus.Failed ? "terminal" : "")">
                @if (Model.Refund.Status == RefundStatus.Processing) { <i class="bi bi-check2"></i> }
                Processing
            </span>
            <span class="@(Model.Refund.Status == RefundStatus.Completed ? "active terminal" : "")">
                @if (Model.Refund.Status == RefundStatus.Completed) { <i class="bi bi-check2"></i> }
                Completed
            </span>
            <span class="@(Model.Refund.Status == RefundStatus.Failed ? "active terminal" : "")">
                @if (Model.Refund.Status == RefundStatus.Failed) { <i class="bi bi-check2"></i> }
                Failed
            </span>
        </div>
    </div>

    <div class="rd-grid">
        <article class="rd-panel">
            <header class="rd-panel-head">
                <span class="rd-panel-icon"><i class="bi bi-info-circle"></i></span>
                <div>
                    <h2>Refund Overview</h2>
                    <p>Core refund details and status.</p>
                </div>
            </header>
            <dl class="rd-panel-body">
                <div class="rd-row"><dt>Refund Number</dt><dd>@Model.Refund.RefundNumber</dd></div>
                <div class="rd-row"><dt>Status</dt><dd><span class="rd-badge rd-badge-status-@Model.Refund.Status.ToString().ToLowerInvariant()">@Model.StatusDisplayName</span></dd></div>
                <div class="rd-row"><dt>Method</dt><dd><span class="rd-badge rd-badge-method-@Model.Refund.Method.ToString().ToLowerInvariant()">@Model.MethodDisplayName</span></dd></div>
                <div class="rd-row"><dt>Reason</dt><dd><span class="rd-badge rd-badge-reason-@Model.Refund.Reason.ToString().ToLowerInvariant()">@Model.ReasonDisplayName</span></dd></div>
                @if (!string.IsNullOrWhiteSpace(Model.Refund.ReasonDetails))
                {
                    <div class="rd-row"><dt>Reason Details</dt><dd>@Model.Refund.ReasonDetails</dd></div>
                }
                <div class="rd-row"><dt>Amount</dt><dd><strong>@Model.CurrencySymbol @Model.Refund.Amount.ToString("N0")</strong></dd></div>
            </dl>
        </article>

        <article class="rd-panel">
            <header class="rd-panel-head">
                <span class="rd-panel-icon"><i class="bi bi-gear"></i></span>
                <div>
                    <h2>Refund Processing</h2>
                    <p>Processing and audit information.</p>
                </div>
            </header>
            <dl class="rd-panel-body">
                <div class="rd-row"><dt>Initiated By</dt><dd>@Model.InitiatedByName</dd></div>
                <div class="rd-row"><dt>Initiated At</dt><dd>@Model.Refund.InitiatedAt.ToString("dd MMM yyyy HH:mm")</dd></div>
                @if (Model.Refund.ProcessedAt.HasValue)
                {
                    <div class="rd-row"><dt>Processed By</dt><dd>@Model.ProcessedByName</dd></div>
                    <div class="rd-row"><dt>Processed At</dt><dd>@Model.Refund.ProcessedAt.Value.ToString("dd MMM yyyy HH:mm")</dd></div>
                }
                @if (Model.Refund.CompletedAt.HasValue)
                {
                    <div class="rd-row"><dt>Completed At</dt><dd>@Model.Refund.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")</dd></div>
                }
                @if (Model.Refund.FailedAt.HasValue)
                {
                    <div class="rd-row"><dt>Failed At</dt><dd>@Model.Refund.FailedAt.Value.ToString("dd MMM yyyy HH:mm")</dd></div>
                    <div class="rd-row danger"><dt>Failure Reason</dt><dd class="rd-danger-text">@Model.Refund.FailureReason</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Refund.GatewayRefundId))
                {
                    <div class="rd-row"><dt>Gateway Refund ID</dt><dd><code>@Model.Refund.GatewayRefundId</code></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Refund.GatewayRefundReference))
                {
                    <div class="rd-row"><dt>Gateway Reference</dt><dd><code>@Model.Refund.GatewayRefundReference</code></dd></div>
                }
            </dl>
        </article>

        <article class="rd-panel">
            <header class="rd-panel-head">
                <span class="rd-panel-icon"><i class="bi bi-credit-card"></i></span>
                <div>
                    <h2>Payment Transaction</h2>
                    <p>Original payment transaction linked to this refund.</p>
                </div>
            </header>
            <dl class="rd-panel-body">
                @if (Model.HasPaymentTransaction)
                {
                    <div class="rd-row"><dt>Transaction Number</dt><dd>@Model.PaymentTransaction!.TransactionNumber</dd></div>
                    <div class="rd-row"><dt>Gateway</dt><dd>@Model.PaymentTransaction.Gateway.ToString()</dd></div>
                    <div class="rd-row"><dt>Transaction Amount</dt><dd>@Model.CurrencySymbol @Model.PaymentTransaction.Amount.ToString("N0")</dd></div>
                    <div class="rd-row"><dt>Status</dt><dd><span class="rd-badge rd-badge-status-@Model.PaymentTransaction.Status.ToString().ToLowerInvariant()">@Model.PaymentTransaction.Status.GetDisplayName()</span></dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.PaymentTransaction.GatewayReference))
                    {
                        <div class="rd-row"><dt>Gateway Reference</dt><dd><code>@Model.PaymentTransaction.GatewayReference</code></dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.PaymentTransaction.GatewayTransactionId))
                    {
                        <div class="rd-row"><dt>Gateway Transaction ID</dt><dd><code>@Model.PaymentTransaction.GatewayTransactionId</code></dd></div>
                    }
                    <div class="rd-row"><dt>Initiated At</dt><dd>@Model.PaymentTransaction.InitiatedAt.ToString("dd MMM yyyy HH:mm")</dd></div>
                    @if (Model.PaymentTransaction.CompletedAt.HasValue)
                    {
                        <div class="rd-row"><dt>Completed At</dt><dd>@Model.PaymentTransaction.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")</dd></div>
                    }
                }
                else
                {
                    <div class="rd-row"><dt>Transaction Details</dt><dd class="rd-muted">Not available (Payment transaction not linked)</dd></div>
                }
            </dl>
        </article>

        <article class="rd-panel">
            <header class="rd-panel-head">
                <span class="rd-panel-icon"><i class="bi bi-calendar-event"></i></span>
                <div>
                    <h2>Linked Booking</h2>
                    <p>Original booking that generated this refund.</p>
                </div>
            </header>
            <dl class="rd-panel-body">
                <div class="rd-row"><dt>Booking Number</dt><dd>@Model.Booking.BookingNumber</dd></div>
                <div class="rd-row"><dt>Status</dt><dd><span class="rd-badge rd-badge-status-@Model.Booking.Status.ToString().ToLowerInvariant()">@Model.Booking.Status.GetDisplayName()</span></dd></div>
                <div class="rd-row"><dt>Date & Time</dt><dd>@Model.Booking.BookingDate.ToString("dd MMM yyyy") @Model.Booking.StartTime.ToString("HH:mm") - @Model.Booking.EndTime.ToString("HH:mm")</dd></div>
                <div class="rd-row"><dt>Court</dt><dd>
                    @if (Model.Booking.Court != null)
                    {
                        @Model.Booking.Court.Name
                        @if (Model.Booking.Court.Facility != null)
                        {
                            <text> (@Model.Booking.Court.Facility.Name)</text>
                        }
                    }
                    else
                    {
                        <span class="rd-muted">Not available</span>
                    }
                </dd></div>
                <div class="rd-row"><dt>Sport</dt><dd>
                    @if (Model.Booking.Sport != null)
                    {
                        @Model.Booking.Sport.Name
                    }
                    else
                    {
                        <span class="rd-muted">Not available</span>
                    }
                </dd></div>
                <div class="rd-row"><dt>Duration</dt><dd>@Model.Booking.DurationMinutes minutes</dd></div>
                <div class="rd-row"><dt>Players</dt><dd>@Model.Booking.PlayerCount</dd></div>
                <div class="rd-row"><dt>Total Amount</dt><dd>@Model.CurrencySymbol @Model.Booking.TotalAmount.ToString("N0")</dd></div>
                <div class="rd-row"><dt>Paid Amount</dt><dd>@Model.CurrencySymbol @Model.Booking.PaidAmount.ToString("N0")</dd></div>
                <div class="rd-row"><dt>Payment Status</dt><dd><span class="rd-badge rd-badge-status-@Model.Booking.PaymentStatus.ToString().ToLowerInvariant()">@Model.Booking.PaymentStatus.GetDisplayName()</span></dd></div>
                @if (Model.Booking.CancelledAt.HasValue)
                {
                    <div class="rd-row"><dt>Cancelled At</dt><dd>@Model.Booking.CancelledAt.Value.ToString("dd MMM yyyy HH:mm")</dd></div>
                    <div class="rd-row"><dt>Cancellation Reason</dt><dd>@Model.Booking.CancellationReason</dd></div>
                }
            </dl>
        </article>

        <article class="rd-panel">
            <header class="rd-panel-head">
                <span class="rd-panel-icon"><i class="bi bi-person-lines-fill"></i></span>
                <div>
                    <h2>Customer Details</h2>
                    <p>Customer linked to the refunded booking.</p>
                </div>
            </header>
            <dl class="rd-panel-body">
                <div class="rd-row"><dt>Customer Name</dt><dd>@Model.Booking.Customer.FirstName @Model.Booking.Customer.LastName</dd></div>
                <div class="rd-row"><dt>Customer Code</dt><dd>@Model.Booking.Customer.CustomerCode</dd></div>
                <div class="rd-row"><dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(Model.Booking.Customer.Email) ? "Not provided" : Model.Booking.Customer.Email)</dd></div>
                <div class="rd-row"><dt>Phone</dt><dd>@(string.IsNullOrWhiteSpace(Model.Booking.Customer.PrimaryPhone) ? "Not provided" : Model.Booking.Customer.PrimaryPhone)</dd></div>
                <div class="rd-row"><dt>WhatsApp</dt><dd>@(string.IsNullOrWhiteSpace(Model.Booking.Customer.WhatsAppNumber) ? "Not provided" : Model.Booking.Customer.WhatsAppNumber)</dd></div>
            </dl>
        </article>

        @if (Model.HasPayment)
        {
            <article class="rd-panel">
                <header class="rd-panel-head">
                    <span class="rd-panel-icon"><i class="bi bi-receipt"></i></span>
                    <div>
                        <h2>Invoice & Payment</h2>
                        <p>Financial records created for the booking.</p>
                    </div>
                </header>
                <dl class="rd-panel-body">
                    @if (Model.HasInvoice)
                    {
                        <div class="rd-row"><dt>Invoice Number</dt><dd>@Model.Payment!.Invoice.InvoiceNumber</dd></div>
                        <div class="rd-row"><dt>Invoice Status</dt><dd><span class="rd-badge rd-badge-status-@Model.Payment.Invoice.Status.ToString().ToLowerInvariant()">@Model.Payment.Invoice.Status.GetDisplayName()</span></dd></div>
                        <div class="rd-row"><dt>Invoice Amount</dt><dd>@Model.CurrencySymbol @Model.Payment.Invoice.GrandTotal.ToString("N0")</dd></div>
                    }
                    <div class="rd-row"><dt>Payment Number</dt><dd>@Model.Payment!.PaymentNumber</dd></div>
                    <div class="rd-row"><dt>Payment Status</dt><dd><span class="rd-badge rd-badge-status-@Model.Payment.Status.ToString().ToLowerInvariant()">@Model.Payment.Status.GetDisplayName()</span></dd></div>
                    <div class="rd-row"><dt>Payment Amount</dt><dd>@Model.CurrencySymbol @Model.Payment.Amount.ToString("N0")</dd></div>
                    <div class="rd-row"><dt>Payment Method</dt><dd>@Model.Payment.PaymentMethod.GetDisplayName()</dd></div>
                    <div class="rd-row"><dt>Recorded At</dt><dd>@Model.Payment.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd></div>
                </dl>
            </article>
        }

        <article class="rd-panel rd-panel-wide">
            <header class="rd-panel-head">
                <span class="rd-panel-icon"><i class="bi bi-journal-text"></i></span>
                <div>
                    <h2>Approval History</h2>
                    <p>Audit trail of approval actions on this booking.</p>
                </div>
            </header>
            @if (!Model.HasApprovals)
            {
                <div class="rd-empty">
                    <i class="bi bi-journal-text"></i>
                    <strong>No approval records found.</strong>
                    <span>Approval actions will appear here.</span>
                </div>
            }
            @if (Model.HasApprovals)
            {
                <div class="rd-table-card">
                    <table class="rd-table">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Previous Status</th>
                                <th>New Status</th>
                                <th>By</th>
                                <th>At</th>
                                <th>Comments</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var approval in Model.ApprovalHistory)
                            {
                                <tr>
                                    <td><span class="rd-status-badge"><i></i>@approval.Action.GetDisplayName()</span></td>
                                    <td>@approval.PreviousStatus</td>
                                    <td>@approval.NewStatus</td>
                                    <td>@(approval.ActionByUser?.FirstName + " " + approval.ActionByUser?.LastName ?? "System")</td>
                                    <td>@approval.ActionAt.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@approval.Comments</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <article class="rd-panel rd-panel-wide">
            <header class="rd-panel-head">
                <span class="rd-panel-icon"><i class="bi bi-activity"></i></span>
                <div>
                    <h2>Activity History</h2>
                    <p>All recorded activities on this booking.</p>
                </div>
            </header>
            @if (!Model.HasActivities)
            {
                <div class="rd-empty">
                    <i class="bi bi-activity"></i>
                    <strong>No activity records found.</strong>
                    <span>Activity records will appear here.</span>
                </div>
            }
            @if (Model.HasActivities)
            {
                <div class="rd-timeline">
                    @foreach (var activity in Model.ActivityHistory)
                    {
                        <div class="rd-timeline-item">
                            <span class="rd-timeline-dot"><i class="bi bi-dot"></i></span>
                            <div class="rd-timeline-copy">
                                <div class="rd-timeline-top">
                                    <strong>@activity.ActivityType.GetDisplayName()</strong>
                                    <time>@activity.PerformedAt.ToString("dd MMM yyyy HH:mm")</time>
                                </div>
                                <span class="rd-timeline-type">Booking</span>
                                <p>@activity.Description</p>
                                <small class="rd-muted">By: @(activity.PerformedByUser?.FirstName + " " + activity.PerformedByUser?.LastName ?? "System")</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </div>

    @if (Model.ShowCompleteManualButton)
    {
        <div class="modal fade" id="completeManualRefundModal" tabindex="-1" aria-labelledby="completeManualRefundModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="completeManualRefundModalLabel"><i class="bi bi-check2-circle"></i> Complete Manual Refund</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-action="ProcessManualRefund" asp-route-id="@Model.Refund.Id">
                        <div class="modal-body">
                            <p>Confirm completion of manual refund <strong>@Model.Refund.RefundNumber</strong> for <strong>@Model.CurrencySymbol @Model.Refund.Amount.ToString("N0")</strong>.</p>
                            <p class="rd-muted">This action marks the refund as completed and updates the booking's payment status.</p>
                            <div class="mb-3">
                                <label class="form-label">Gateway Refund Reference (optional)</label>
                                <input type="text" name="gatewayRefundReference" class="form-control" placeholder="Enter external refund reference if applicable" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="rd-btn rd-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="rd-btn rd-btn-primary"><i class="bi bi-check2-circle"></i> Confirm Completion</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <partial name="_GuidancePanel" />
</section>

<div class="booking-modal" data-booking-modal hidden>
    <div>
        <button type="button" data-booking-modal-close><i class="bi bi-x-lg"></i></button>
        <h3>Confirm Action</h3>
        <p data-booking-modal-message>Are you sure?</p>
        <textarea data-booking-modal-reason placeholder="Enter reason" data-char-count="true"></textarea>
        <div data-char-counter class="crm-muted" style="font-size: 0.75rem; margin-top: 0.25rem;"></div>
        <button class="rd-btn rd-btn-primary" type="button" data-booking-modal-confirm>Confirm</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/crm.js" asp-append-version="true"></script>
}