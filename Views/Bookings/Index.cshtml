@model BookingIndexViewModel
@using GameHub.Models.Enums
@{
    ViewData["Title"] = "Booking Management";
    Layout = "_AdminLayout";
    ViewData["BookingGuidance"] = Model.View == "calendar" ? "calendar" : "bookings";
    ViewData["BookingGuidanceRail"] = false;
    ViewData["TodaysBookings"] = Model.TodaysBookings;
    ViewData["PendingApprovals"] = Model.Pending;
    ViewData["PendingRefunds"] = 0; // Not available in this ViewModel
    ViewData["CourtOccupancy"] = Model.CourtOccupancy.ToString("N0") + "%";
    var eventsJson = System.Text.Json.JsonSerializer.Serialize(Model.CalendarEvents);
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" />
    <style>
        .bookings-page .admin-action-button,
        .bookings-page .admin-secondary-button,
        .bookings-page .membership-icon-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 40px;
            padding: 0 14px;
            border-radius: 12px;
            border: 1px solid rgba(214, 166, 82, .2);
            background: #fff;
            color: #171614;
            font-weight: 800;
            font-size: .82rem;
            text-decoration: none;
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }
        .bookings-page .admin-action-button {
            background: linear-gradient(135deg, #f7d989, #d6a652);
            color: #11100e;
            border: 0;
            box-shadow: 0 10px 22px rgba(154, 108, 32, .18);
        }
        .bookings-page .admin-secondary-button:hover,
        .bookings-page .membership-icon-button:hover {
            transform: translateY(-1px);
            border-color: #d6a652;
            box-shadow: 0 10px 22px rgba(154, 108, 32, .12);
        }
        .bookings-page .admin-action-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 26px rgba(154, 108, 32, .24);
        }
        .bookings-page .membership-icon-button {
            min-height: 36px;
            width: 36px;
            padding: 0;
            border-radius: 10px;
        }
        .bookings-page .membership-icon-button.danger {
            color: #9b2828;
            border-color: #f2caca;
            background: #fff6f6;
        }
    </style>
}

<div class="crm-page crm-page-pro bookings-page">
    <div class="arena-header">
        <div>
            <span class="admin-label">ARENA OPERATIONS</span>
            <h1>Booking Management</h1>
            <p>Manage reservations, court availability, customer schedules, and booking lifecycle.</p>
        </div>
        <div class="crm-command-actions">
            <div class="crm-view-toggle" aria-label="Booking view mode">
                <a class="@(Model.View == "list" ? "active" : "")" asp-action="Index" asp-route-view="list"><i class="bi bi-list-ul"></i> List</a>
                <a class="@(Model.View == "calendar" ? "active" : "")" asp-action="Index" asp-route-view="calendar"><i class="bi bi-calendar-week"></i> Calendar</a>
            </div>
            @if (Model.CanManage)
            {
                <a class="admin-action-button" asp-action="Create"><i class="bi bi-plus-lg"></i> Create Booking</a>
            }
        </div>
    </div>

    <div class="arena-summary-grid">
        <article><i class="bi bi-calendar-day"></i><span>Today's Bookings</span><strong>@Model.TodaysBookings</strong></article>
        <article><i class="bi bi-check2-circle"></i><span>Confirmed</span><strong>@Model.Confirmed</strong></article>
        <article><i class="bi bi-hourglass-split"></i><span>Pending</span><strong>@Model.Pending</strong></article>
        <article><i class="bi bi-play-circle"></i><span>In Progress</span><strong>@Model.InProgress</strong></article>
        <article><i class="bi bi-trophy"></i><span>Completed Today</span><strong>@Model.CompletedToday</strong></article>
        <article><i class="bi bi-x-circle"></i><span>Cancelled (7d)</span><strong>@Model.Cancelled</strong></article>
        <article><i class="bi bi-cash-stack"></i><span>Today's Revenue</span><strong>@Model.CurrencySymbol @Model.TodaysRevenue.ToString("N0")</strong></article>
        <article><i class="bi bi-pie-chart"></i><span>Court Occupancy</span><strong>@Model.CourtOccupancy.ToString("N0")%</strong></article>
    </div>

    <section class="arena-card crm-leads-card">
        <form class="arena-toolbar" method="get" data-crm-toolbar>
            <input type="hidden" name="view" value="@Model.View" />
            <div class="arena-search">
                <i class="bi bi-search"></i>
                <input name="search" value="@Model.Search" placeholder="Search booking, customer, court..." data-crm-search />
            </div>
            <button class="admin-secondary-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#bookingFilters">
                <i class="bi bi-sliders"></i> Filters <span>@Model.ActiveFilterCount</span>
            </button>
            <a class="admin-secondary-button" asp-action="Index" asp-route-view="@Model.View"><i class="bi bi-x-circle"></i> Clear</a>
            <select name="sortBy" data-crm-filter aria-label="Sort bookings">
                @foreach (var opt in Model.SortOptions)
                {
                    <option value="@opt.Value" selected="@(opt.Value == Model.SortBy)">@opt.Text</option>
                }
            </select>
            <select name="pageSize" data-crm-filter aria-label="Page size">
                @foreach (var opt in Model.PageSizeOptions)
                {
                    <option value="@opt.Value" selected="@(opt.Value == Model.PageSize.ToString())">@opt.Text</option>
                }
            </select>

            <div class="offcanvas offcanvas-end crm-filter-panel" tabindex="-1" id="bookingFilters">
                <div class="offcanvas-header">
                    <div><span class="admin-kicker">Booking Filters</span><h5>Refine bookings</h5></div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <label>Status<select name="status">@foreach (var opt in Model.StatusOptions) { <option value="@opt.Value" selected="@(opt.Value == Model.CurrentQueryValues.GetValueOrDefault("status"))">@opt.Text</option> }</select></label>
                    <label>Payment Status<select name="paymentStatus">@foreach (var opt in Model.PaymentStatusOptions) { <option value="@opt.Value" selected="@(opt.Value == Model.CurrentQueryValues.GetValueOrDefault("paymentStatus"))">@opt.Text</option> }</select></label>
                    <label>Source<select name="source">@foreach (var opt in Model.SourceOptions) { <option value="@opt.Value" selected="@(opt.Value == Model.CurrentQueryValues.GetValueOrDefault("source"))">@opt.Text</option> }</select></label>
                    <label>Sport<select name="sportId"><option value="">All Sports</option>@foreach (var item in Model.Sports) { <option value="@item.Value" selected="@(item.Value == Model.CurrentQueryValues.GetValueOrDefault("sportId"))">@item.Text</option> }</select></label>
                    <label>Facility<select name="facilityId"><option value="">All Facilities</option>@foreach (var item in Model.Facilities) { <option value="@item.Value" selected="@(item.Value == Model.CurrentQueryValues.GetValueOrDefault("facilityId"))">@item.Text</option> }</select></label>
                    <label>Court<select name="courtId"><option value="">All Courts</option>@foreach (var item in Model.Courts) { <option value="@item.Value" selected="@(item.Value == Model.CurrentQueryValues.GetValueOrDefault("courtId"))">@item.Text</option> }</select></label>
                    <label>Customer<select name="customerId"><option value="">All Customers</option>@foreach (var item in Model.Customers) { <option value="@item.Value" selected="@(item.Value == Model.CurrentQueryValues.GetValueOrDefault("customerId"))">@item.Text</option> }</select></label>
                    <label>Date From<input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" /></label>
                    <label>Date To<input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" /></label>
                    <div class="crm-filter-actions">
                        <button class="admin-action-button" type="submit"><i class="bi bi-check2"></i> Apply Filters</button>
                        <a class="admin-secondary-button" asp-action="Index" asp-route-view="@Model.View">Clear All</a>
                    </div>
                </div>
            </div>
        </form>

        <div class="crm-active-filters">
            @foreach (var kvp in Model.CurrentQueryValues)
            {
                if (kvp.Key != "view")
                {
                    <a class="crm-filter-chip" href="@Url.Action("Index")" data-filter-key="@kvp.Key"><i class="bi bi-x"></i> @kvp.Key: @kvp.Value</a>
                }
            }
        </div>

        @if (Model.View == "calendar")
        {
            <div class="booking-calendar-shell" data-calendar-shell style="height: 650px;">
                <div class="booking-calendar-loading" data-calendar-loading><span class="spinner-border spinner-border-sm"></span> Loading calendar...</div>
                <div id="bookingCalendar" data-events="@eventsJson" data-currency="@Model.CurrencySymbol" style="height: 100%;"></div>
            </div>
        }
        else if (!Model.Bookings.Any())
        {
            <div class="arena-empty">
                <i class="bi bi-calendar-plus"></i>
                <h2>No bookings found</h2>
                <p>Create a booking or adjust filters to see reservations.</p>
            </div>
        }
        else
        {
            <div class="crm-leads-table-card membership-workspace-card">
                <div class="crm-leads-table-wrap membership-table-wrap">
                    <table class="crm-leads-table crm-data-grid">
                        <thead>
                            <tr>
                                <th style="width: 12%;">Booking</th>
                                <th style="width: 16%;">Customer</th>
                                <th style="width: 14%;">Date & Time</th>
                                <th style="width: 14%;">Court</th>
                                <th style="width: 10%;">Sport</th>
                                <th style="width: 8%;">Duration</th>
                                <th style="width: 10%;">Amount</th>
                                <th style="width: 8%;">Payment</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 8%;">Source</th>
                                <th style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Bookings)
                            {
                                <tr>
                                    <td data-label="Booking">
                                        <div class="crm-person-cell">
                                            <span class="crm-mini-avatar">@item.BookingNumber[0]</span>
                                            <div>
                                                <strong>@item.BookingNumber</strong>
                                                <small>@item.CreatedAt.ToString("dd MMM yyyy") @(item.IsWalkIn ? "Walk-in" : "")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Customer">
                                        <div class="crm-person-cell">
                                            <span class="crm-mini-avatar">@item.CustomerInitials</span>
                                            <div>
                                                <strong>@item.CustomerName</strong>
                                                <small>@item.CustomerPhone @(item.IsMemberBooking ? "• Member" : "")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Date & Time">
                                        <strong>@item.BookingDate.ToString("dd MMM yyyy")</strong>
                                        <small>@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</small>
                                    </td>
                                    <td data-label="Court">
                                        <strong>@item.CourtName</strong>
                                        <small>@item.FacilityName</small>
                                    </td>
                                    <td data-label="Sport">@item.SportName</td>
                                    <td data-label="Duration">@item.DurationMinutes min</td>
                                    <td data-label="Amount">
                                        <strong>@Model.CurrencySymbol @item.TotalAmount.ToString("N0")</strong>
                                        <small>Bal @item.BalanceAmount.ToString("N0")</small>
                                    </td>
                                    <td data-label="Payment">
                                        <span class="membership-status-badge crm-lead-badge payment-@item.PaymentStatus.ToString().ToLowerInvariant()"><i></i>@item.PaymentStatus.GetDisplayName()</span>
                                    </td>
                                    <td data-label="Status">
                                        <span class="membership-status-badge crm-lead-badge status-@item.Status.ToString().ToLowerInvariant()"><i></i>@item.Status.GetDisplayName()</span>
                                    </td>
                                    <td data-label="Source">@item.Source.GetDisplayName()</td>
                                    <td data-label="Actions">
                                        <div class="membership-action-menu crm-lead-actions">
                                            <a class="membership-icon-button" asp-action="Details" asp-route-id="@item.Id" title="View Details" aria-label="View booking @item.BookingNumber"><i class="bi bi-eye"></i></a>
                                            @if (Model.CanManage && (item.Status == BookingStatus.Draft || item.Status == BookingStatus.Pending || item.Status == BookingStatus.Confirmed))
                                            {
                                                <a class="membership-icon-button" asp-action="Edit" asp-route-id="@item.Id" title="Edit" aria-label="Edit booking @item.BookingNumber"><i class="bi bi-pencil"></i></a>
                                                <a class="membership-icon-button" asp-action="Reschedule" asp-route-id="@item.Id" title="Reschedule" aria-label="Reschedule booking @item.BookingNumber"><i class="bi bi-calendar2-week"></i></a>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="crm-leads-pagination membership-pagination">
                <span>Showing @Model.StartRecord-@Model.EndRecord of @Model.TotalRecords bookings</span>
                <div class="pagination-controls">
                    @foreach (var link in Model.PaginationLinks)
                    {
                        var cssClass = "page-link";
                        if (link.IsActive) cssClass += " active";
                        if (link.IsDisabled) cssClass += " disabled";
                        var icon = "";
                        if (link.Label == "Previous") icon = "<i class=\"bi bi-chevron-left\"></i> ";
                        else if (link.Label == "Next") icon = " <i class=\"bi bi-chevron-right\"></i>";
                        <a class="@cssClass" href="@link.Url" aria-current="@(link.IsActive ? "page" : null)">@Html.Raw(icon + link.Label)</a>
                    }
                </div>
            </div>
        }
    </section>

    @Html.AntiForgeryToken()
    <div class="booking-modal" data-booking-modal hidden>
        <div>
            <button type="button" data-booking-modal-close><i class="bi bi-x-lg"></i></button>
            <h3>Confirm Action</h3>
            <p data-booking-modal-message>Are you sure?</p>
            <textarea data-booking-modal-reason placeholder="Enter reason" data-char-count="true"></textarea>
            <div data-char-counter class="crm-muted" style="font-size: 0.75rem; margin-top: 0.25rem;"></div>
            <button class="crm-premium-button" type="button" data-booking-modal-confirm>Confirm</button>
        </div>
    </div>

    <div class="booking-quick-modal" data-booking-quick-modal hidden>
        <div class="booking-quick-card">
            <button type="button" class="booking-quick-close" data-booking-quick-close aria-label="Close quick view"><i class="bi bi-x-lg"></i></button>
            <span class="admin-label">BOOKING QUICK VIEW</span>
            <h3 data-quick-number>Booking</h3>
            <div class="booking-quick-grid">
                <div><span>Customer</span><strong data-quick-customer>-</strong></div>
                <div><span>Court</span><strong data-quick-court>-</strong></div>
                <div><span>Sport</span><strong data-quick-sport>-</strong></div>
                <div><span>Booking Time</span><strong data-quick-time>-</strong></div>
                <div><span>Status</span><strong data-quick-status>-</strong></div>
                <div><span>Payment Status</span><strong data-quick-payment>Open details</strong></div>
                <div><span>Total Amount</span><strong data-quick-amount>-</strong></div>
            </div>
            <div class="booking-quick-actions">
                <a class="crm-premium-button" data-quick-details href="#"><i class="bi bi-eye"></i><span>View Details</span></a>
                <a class="crm-premium-button secondary" data-quick-edit href="#"><i class="bi bi-pencil"></i><span>Edit Booking</span></a>
                <button class="crm-premium-button secondary" type="button" data-booking-quick-close><i class="bi bi-x-circle"></i><span>Close</span></button>
            </div>
        </div>
    </div>

    <partial name="_GuidancePanel" />
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
}