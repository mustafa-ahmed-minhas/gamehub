@using Microsoft.AspNetCore.Authentication
@{
    var auth = await Context.AuthenticateAsync(AuthConstants.CustomerScheme);
    var isCustomerSignedIn = auth.Succeeded && auth.Principal?.Identity?.IsAuthenticated == true;
    var customerName = auth.Principal?.Identity?.Name ?? "Player";
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    string NavItemClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        ? "btn-ghost-light btn-compact active"
        : "btn-ghost-light btn-compact";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameHub Arena</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toasts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer-account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gamehub-table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-courts.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="customer-site">
    <nav class="customer-nav" data-customer-nav>
        <div class="container customer-nav-inner">
            <a class="brand-mark" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">G</span>
                <span><strong>GameHub</strong><small>Arena</small></span>
            </a>
            <button class="nav-toggle" type="button" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
            <div class="customer-nav-links" data-nav-links>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Courts" asp-action="Index">Courts</a>
                <a asp-controller="MyMemberships" asp-action="Plans">Membership</a>
                <a asp-controller="Courts" asp-action="HowItWorks">How Booking Works</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="facilities">Facilities</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact</a>
            </div>
            <div class="customer-nav-actions">
                @if (isCustomerSignedIn)
                {
                    <a class="@(NavItemClass("MyAccount"))" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-person-circle"></i> My Account</a>
                    <a class="@(NavItemClass("MyBookings"))" asp-controller="MyBookings" asp-action="Index"><i class="bi bi-calendar-check"></i> My Bookings</a>
                    <a class="@(NavItemClass("MyMemberships"))" asp-controller="MyMemberships" asp-action="Index"><i class="bi bi-stars"></i> Membership</a>
                    <a class="@(NavItemClass("CustomerHistory"))" asp-controller="CustomerHistory" asp-action="Index"><i class="bi bi-clock-history"></i> History</a>
                    <a class="@(NavItemClass("CustomerNotifications"))" asp-controller="CustomerNotifications" asp-action="Index"><i class="bi bi-bell"></i> Notifications</a>
                    @* An antiforgery token is bound to the claim identity of HttpContext.User. This
                       nav is also rendered on public pages that use the customer layout without
                       CustomerAuthorize (Courts, Inquiry, online booking), where HttpContext.User is
                       still the admin-scheme principal. Pin the customer principal for exactly this
                       token so it always matches the customer identity that CustomerPrincipal
                       resolves on sign out, then restore the previous user so every other form in
                       the shell keeps the identity it already had. *@
                    var principalBeforeSignOutToken = Context.User;
                    Context.User = auth.Principal!;
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn-premium btn-compact" type="submit"><i class="bi bi-box-arrow-right"></i> Sign Out</button>
                    </form>
                    Context.User = principalBeforeSignOutToken;
                }
                else
                {
                    <a class="btn-ghost-light btn-compact" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Sign In</a>
                    <a class="btn-premium btn-compact" asp-controller="Account" asp-action="Signup"><i class="bi bi-person-plus"></i> Create Account</a>
                }
            </div>
        </div>
    </nav>

    <main id="top" role="main">
        @RenderBody()
    </main>

    <footer class="customer-footer">
        <div class="container customer-footer-grid">
            <div>
                <a class="brand-mark" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">G</span>
                    <span><strong>GameHub</strong><small>Arena</small></span>
                </a>
                <p>Premium courts, smoother booking, and a cleaner sports life.</p>
            </div>
            <div>
                <h3>Explore</h3>
                <a asp-controller="Courts" asp-action="Index">Courts</a>
                <a asp-controller="Courts" asp-action="HowItWorks">How Booking Works</a>
                <a asp-controller="Account" asp-action="Signup">Create Account</a>
            </div>
            <div>
                <h3>Account</h3>
                <a asp-controller="MyAccount" asp-action="Index">My Account</a>
                <a asp-controller="MyAccount" asp-action="Profile">Profile</a>
                <a asp-controller="MyMemberships" asp-action="Index">My Membership</a>
                <a asp-controller="MyMemberships" asp-action="Plans">Membership Plans</a>
                <a asp-controller="MyAccount" asp-action="Payments">Payment History</a>
                <a asp-controller="MyInvoices" asp-action="Index">Invoices</a>
                <a asp-controller="CustomerHistory" asp-action="Index">Activity History</a>
                <a asp-controller="CustomerNotifications" asp-action="Index">Notifications</a>
                <a asp-controller="MyAccount" asp-action="ChangePassword">Change Password</a>
            </div>
            <div>
                <h3>Support</h3>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact Us</a>
                <a asp-controller="Courts" asp-action="HowItWorks">How Booking Works</a>
                <a asp-controller="Account" asp-action="Signup">Create Account</a>
            </div>
        </div>
    </footer>
    <partial name="_ToastContainer" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/toasts.js" asp-append-version="true"></script>
    <script src="~/js/customer-account.js" asp-append-version="true"></script>
    <script src="~/js/gamehub-table.js" asp-append-version="true"></script>
    <script src="~/js/public-courts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
