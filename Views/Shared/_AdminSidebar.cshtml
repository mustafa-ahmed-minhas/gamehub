@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var tab = Context.Request.Query["tab"].ToString().ToLowerInvariant();
    var view = Context.Request.Query["view"].ToString().ToLowerInvariant();
    var name = User.FindFirstValue(ClaimTypes.Name) ?? "GameHub User";
    var initials = string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    var role = RolePermissions.GetCurrentRoleDisplay(User);
    bool Can(string module) => RolePermissions.CanAccessModule(User, module);
    bool On(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase);
    bool Arena(string value) => On("ArenaSetup") && string.Equals(tab, value, StringComparison.OrdinalIgnoreCase);
    bool Crm(string value) => On("CRM") && string.Equals(tab, value, StringComparison.OrdinalIgnoreCase);
    // The Sales helper is referenced only by the temporarily-hidden Sales section below.
    // Keep it (and suppress "declared but never used") so that section can be re-enabled as-is.
#pragma warning disable CS8321
    bool Sales(string value) => On("Sales") && string.Equals(tab, value, StringComparison.OrdinalIgnoreCase);
#pragma warning restore CS8321

    // A section renders expanded when it contains the currently active page.
    bool DashboardActive = On("Dashboard");
    bool MasterDataActive = On("ArenaSetup");
    bool CrmActive = On("Customers") || On("CRM");
    bool SalesActive = On("Sales") || On("SalesOrders") || On("Invoices") || On("Payments");
    bool OperationsActive = (On("Bookings") && view != "calendar") || On("Memberships");
    bool HrActive = On("HR") || On("Recruitment") || On("Offers") || On("Employees") || On("Performance") || On("Termination") || On("HRReports");
    bool AdminActive = On("Users") || On("Settings");
    bool ReportsActive = On("Reports");

    string GroupClass(bool active) => active ? "admin-nav-group is-open" : "admin-nav-group";
}
<aside class="admin-sidebar" data-admin-sidebar aria-label="GameHub ERP navigation">
    <div class="admin-sidebar-brand"><a class="admin-brand" asp-controller="Dashboard" asp-action="Index" aria-label="GameHub ERP dashboard"><span class="admin-brand-mark">G</span><span class="admin-brand-text"><strong>GameHub ERP</strong><small>Arena Management</small></span></a></div>
    <nav class="admin-nav" aria-label="Admin modules">

        @if (Can("Dashboard"))
        {
            <section class="@GroupClass(DashboardActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(DashboardActive ? "true" : "false")" aria-controls="admin-nav-dashboard">
                    <span class="admin-nav-group-title">Dashboard</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-dashboard">
                    <div class="admin-nav-group-inner">
                        <a class="admin-nav-link @(DashboardActive ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                    </div>
                </div>
            </section>
        }

        @if (Can("ArenaSetup"))
        {
            <section class="@GroupClass(MasterDataActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(MasterDataActive ? "true" : "false")" aria-controls="admin-nav-master-data">
                    <span class="admin-nav-group-title">Master Data</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-master-data">
                    <div class="admin-nav-group-inner">
                        <a class="admin-nav-link @(Arena("sports") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="sports"><i class="bi bi-trophy"></i><span>Sports</span></a>
                        <a class="admin-nav-link @(Arena("facilities") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="facilities"><i class="bi bi-building"></i><span>Facilities</span></a>
                        <a class="admin-nav-link @(Arena("courts") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="courts"><i class="bi bi-grid-3x3-gap"></i><span>Courts</span></a>
                        <a class="admin-nav-link @(Arena("pricing") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="pricing"><i class="bi bi-cash-stack"></i><span>Pricing</span></a>
                        <a class="admin-nav-link @(Arena("schedules") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="schedules"><i class="bi bi-clock-history"></i><span>Time Slots</span></a>
                    </div>
                </div>
            </section>
        }

        @if (Can("Customers") || Can("CRM"))
        {
            <section class="@GroupClass(CrmActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(CrmActive ? "true" : "false")" aria-controls="admin-nav-crm">
                    <span class="admin-nav-group-title">CRM</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-crm">
                    <div class="admin-nav-group-inner">
                        @if (Can("Customers"))
                        {
                            <a class="admin-nav-link @(On("Customers") ? "active" : "")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i><span>Customers</span></a>
                        }
                        @if (Can("CRM"))
                        {
                            <a class="admin-nav-link @(Crm("leads") ? "active" : "")" asp-controller="CRM" asp-action="Index" asp-route-tab="leads"><i class="bi bi-person-lines-fill"></i><span>Leads</span></a>
                            <a class="admin-nav-link @(Crm("opportunities") ? "active" : "")" asp-controller="CRM" asp-action="Index" asp-route-tab="opportunities"><i class="bi bi-briefcase"></i><span>Opportunities</span></a>
                            <a class="admin-nav-link @(On("CRM") && action == "FollowUps" ? "active" : "")" asp-controller="CRM" asp-action="FollowUps"><i class="bi bi-alarm"></i><span>Follow-ups</span></a>
                        }
                    </div>
                </div>
            </section>
        }

        @* TEMPORARILY HIDDEN - Sales section. Remove these comment markers to restore it.
        @if (Can("Sales") || Can("Invoices") || Can("Payments"))
        {
            <section class="@GroupClass(SalesActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(SalesActive ? "true" : "false")" aria-controls="admin-nav-sales">
                    <span class="admin-nav-group-title">Sales</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-sales">
                    <div class="admin-nav-group-inner">
                        @if (Can("Sales"))
                        {
                            <a class="admin-nav-link @(Sales("quotations") ? "active" : "")" asp-controller="Sales" asp-action="Index" asp-route-tab="quotations"><i class="bi bi-file-earmark-text"></i><span>Quotations</span></a>
                            <a class="admin-nav-link @(On("SalesOrders") ? "active" : "")" asp-controller="SalesOrders" asp-action="Index"><i class="bi bi-bag-check"></i><span>Sales Orders</span></a>
                        }
                        @if (Can("Invoices"))
                        {
                            <a class="admin-nav-link @(On("Invoices") ? "active" : "")" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i><span>Invoices</span></a>
                        }
                        @if (Can("Payments"))
                        {
                            <a class="admin-nav-link @(On("Payments") ? "active" : "")" asp-controller="Payments" asp-action="Index"><i class="bi bi-wallet2"></i><span>Payments</span></a>
                        }
                    </div>
                </div>
            </section>
        }
        *@

        @* TEMPORARILY HIDDEN - Operations section. Remove these comment markers to restore it.
        @if (Can("Bookings") || Can("Memberships"))
        {
            <section class="@GroupClass(OperationsActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(OperationsActive ? "true" : "false")" aria-controls="admin-nav-operations">
                    <span class="admin-nav-group-title">Operations</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-operations">
                    <div class="admin-nav-group-inner">
                        @if (Can("Bookings"))
                        {
                            <a class="admin-nav-link @(On("Bookings") && view != "calendar" ? "active" : "")" asp-controller="Bookings" asp-action="Index" asp-route-view="list"><i class="bi bi-calendar-check"></i><span>Bookings</span></a>
                        }
                        @if (Can("Memberships"))
                        {
                            <a class="admin-nav-link @(On("Memberships") ? "active" : "")" asp-controller="Memberships" asp-action="Index"><i class="bi bi-person-badge"></i><span>Memberships</span></a>
                        }
                    </div>
                </div>
            </section>
        }
        *@

        @* TEMPORARILY HIDDEN - HR section. Remove these comment markers to restore it.
        @if (Can("HR"))
        {
            <section class="@GroupClass(HrActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(HrActive ? "true" : "false")" aria-controls="admin-nav-hr">
                    <span class="admin-nav-group-title">HR</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-hr">
                    <div class="admin-nav-group-inner">
                        <a class="admin-nav-link @(On("HR") ? "active" : "")" asp-controller="HR" asp-action="Index"><i class="bi bi-people-fill"></i><span>HR Dashboard</span></a>
                        <a class="admin-nav-link @(On("Recruitment") ? "active" : "")" asp-controller="Recruitment" asp-action="Index"><i class="bi bi-person-plus"></i><span>Recruitment Management</span></a>
                        <a class="admin-nav-link @(On("Offers") ? "active" : "")" asp-controller="Offers" asp-action="Index"><i class="bi bi-file-earmark-check"></i><span>Offer &amp; Hiring</span></a>
                        <a class="admin-nav-link @(On("Employees") ? "active" : "")" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-vcard"></i><span>Employee Management</span></a>
                        <a class="admin-nav-link @(On("Performance") ? "active" : "")" asp-controller="Performance" asp-action="Index"><i class="bi bi-graph-up-arrow"></i><span>Performance &amp; Warnings</span></a>
                        <a class="admin-nav-link @(On("Termination") ? "active" : "")" asp-controller="Termination" asp-action="Index"><i class="bi bi-box-arrow-right"></i><span>Termination &amp; Clearance</span></a>
                        <a class="admin-nav-link @(On("HRReports") ? "active" : "")" asp-controller="HRReports" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span>HR Reports</span></a>
                    </div>
                </div>
            </section>
        }
        *@

        @if (Can("Users") || Can("Settings"))
        {
            <section class="@GroupClass(AdminActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(AdminActive ? "true" : "false")" aria-controls="admin-nav-administration">
                    <span class="admin-nav-group-title">Administration</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-administration">
                    <div class="admin-nav-group-inner">
                        @if (Can("Users"))
                        {
                            <a class="admin-nav-link @(On("Users") ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i><span>Users</span></a>
                        }
                        @if (Can("Settings"))
                        {
                            <a class="admin-nav-link @(On("Settings") ? "active" : "")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i><span>Configuration</span></a>
                        }
                    </div>
                </div>
            </section>
        }

        @* TEMPORARILY HIDDEN - Reports section. Remove these comment markers to restore it.
        @if (Can("Reports"))
        {
            <section class="@GroupClass(ReportsActive)" data-nav-group>
                <button type="button" class="admin-nav-group-toggle" data-nav-group-toggle aria-expanded="@(ReportsActive ? "true" : "false")" aria-controls="admin-nav-reports">
                    <span class="admin-nav-group-title">Reports</span>
                    <i class="bi bi-chevron-down admin-nav-group-chevron" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-items" id="admin-nav-reports">
                    <div class="admin-nav-group-inner">
                        <a class="admin-nav-link @(ReportsActive ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i><span>Reports Dashboard</span></a>
                    </div>
                </div>
            </section>
        }
        *@

    </nav>
    <div class="admin-profile-block"><div class="admin-avatar">@initials</div><div class="admin-profile-text"><strong>@name</strong><span class="admin-role-badge">@role</span></div><form asp-controller="Auth" asp-action="Logout" method="post" class="admin-sidebar-logout">@Html.AntiForgeryToken()<button type="submit" class="icon-button" title="Sign Out" aria-label="Sign Out"><i class="bi bi-box-arrow-right"></i></button></form></div>
</aside>
