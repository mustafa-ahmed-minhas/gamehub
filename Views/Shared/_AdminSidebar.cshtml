@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var tab = Context.Request.Query["tab"].ToString().ToLowerInvariant();
    var view = Context.Request.Query["view"].ToString().ToLowerInvariant();
    var name = User.FindFirstValue(ClaimTypes.Name) ?? "GameHub User";
    var initials = string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    var role = RolePermissions.GetCurrentRoleDisplay(User);
    bool Can(string module) => RolePermissions.CanAccessModule(User, module);
    bool On(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase);
    bool Arena(string value) => On("ArenaSetup") && string.Equals(tab, value, StringComparison.OrdinalIgnoreCase);
    bool Crm(string value) => On("CRM") && string.Equals(tab, value, StringComparison.OrdinalIgnoreCase);
    bool Sales(string value) => On("Sales") && string.Equals(tab, value, StringComparison.OrdinalIgnoreCase);
}
<aside class="admin-sidebar" data-admin-sidebar aria-label="GameHub ERP navigation">
    <div class="admin-sidebar-brand"><a class="admin-brand" asp-controller="Dashboard" asp-action="Index" aria-label="GameHub ERP dashboard"><span class="admin-brand-mark">G</span><span class="admin-brand-text"><strong>GameHub ERP</strong><small>Arena Management</small></span></a></div>
    <nav class="admin-nav" aria-label="Admin modules">
        @if (Can("Dashboard")) { <div class="admin-nav-section"><span>Dashboard</span><a class="admin-nav-link @(On("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a></div> }
        @if (Can("ArenaSetup")) { <div class="admin-nav-section"><span>Master Data</span><a class="admin-nav-link @(Arena("sports") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="sports"><i class="bi bi-trophy"></i><span>Sports</span></a><a class="admin-nav-link @(Arena("facilities") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="facilities"><i class="bi bi-building"></i><span>Facilities</span></a><a class="admin-nav-link @(Arena("courts") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="courts"><i class="bi bi-grid-3x3-gap"></i><span>Courts</span></a><a class="admin-nav-link @(Arena("pricing") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="pricing"><i class="bi bi-cash-stack"></i><span>Pricing</span></a><a class="admin-nav-link @(Arena("schedules") ? "active" : "")" asp-controller="ArenaSetup" asp-action="Index" asp-route-tab="schedules"><i class="bi bi-clock-history"></i><span>Time Slots</span></a></div> }
        @if (Can("Customers") || Can("CRM")) { <div class="admin-nav-section"><span>CRM</span>@if(Can("Customers")){<a class="admin-nav-link @(On("Customers") ? "active" : "")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i><span>Customers</span></a>}@if(Can("CRM")){<a class="admin-nav-link @(Crm("leads") ? "active" : "")" asp-controller="CRM" asp-action="Index" asp-route-tab="leads"><i class="bi bi-person-lines-fill"></i><span>Leads</span></a><a class="admin-nav-link @(Crm("opportunities") ? "active" : "")" asp-controller="CRM" asp-action="Index" asp-route-tab="opportunities"><i class="bi bi-briefcase"></i><span>Opportunities</span></a><a class="admin-nav-link @(On("CRM") && action=="FollowUps" ? "active" : "")" asp-controller="CRM" asp-action="FollowUps"><i class="bi bi-alarm"></i><span>Follow-ups</span></a>}</div> }
        @if (Can("Sales") || Can("Invoices") || Can("Payments")) { <div class="admin-nav-section"><span>Sales</span>@if(Can("Sales")){<a class="admin-nav-link @(Sales("quotations") ? "active" : "")" asp-controller="Sales" asp-action="Index" asp-route-tab="quotations"><i class="bi bi-file-earmark-text"></i><span>Quotations</span></a><a class="admin-nav-link @(On("SalesOrders") ? "active" : "")" asp-controller="SalesOrders" asp-action="Index"><i class="bi bi-bag-check"></i><span>Sales Orders</span></a>}@if(Can("Invoices")){<a class="admin-nav-link @(On("Invoices") ? "active" : "")" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i><span>Invoices</span></a>}@if(Can("Payments")){<a class="admin-nav-link @(On("Payments") ? "active" : "")" asp-controller="Payments" asp-action="Index"><i class="bi bi-wallet2"></i><span>Payments</span></a>}</div> }
        @if (Can("Bookings") || Can("Memberships")) { <div class="admin-nav-section"><span>Operations</span>@if(Can("Bookings")){<a class="admin-nav-link @(On("Bookings") && view!="calendar" ? "active" : "")" asp-controller="Bookings" asp-action="Index" asp-route-view="list"><i class="bi bi-calendar-check"></i><span>Bookings</span></a>}@if(Can("Memberships")){<a class="admin-nav-link @(On("Memberships") ? "active" : "")" asp-controller="Memberships" asp-action="Index"><i class="bi bi-person-badge"></i><span>Memberships</span></a>}</div> }
        @if (Can("Users") || Can("Settings")) { <div class="admin-nav-section"><span>Administration</span>@if(Can("Users")){<a class="admin-nav-link @(On("Users") && !string.Equals(Context.Request.Query["section"],"roles",StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i><span>Users</span></a><a class="admin-nav-link @(On("Users") && string.Equals(Context.Request.Query["section"],"roles",StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Users" asp-action="Index" asp-route-section="roles"><i class="bi bi-shield-check"></i><span>Roles</span></a>}@if(Can("Settings")){<a class="admin-nav-link @(On("Settings") ? "active" : "")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i><span>Configuration</span></a>}</div> }
        @if (Can("Reports")) { <div class="admin-nav-section"><span>Reports</span><a class="admin-nav-link @(On("Reports") ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i><span>Reports Dashboard</span></a></div> }
    </nav>
    <div class="admin-profile-block"><div class="admin-avatar">@initials</div><div class="admin-profile-text"><strong>@name</strong><span class="admin-role-badge">@role</span></div><form asp-controller="Auth" asp-action="Logout" method="post" class="admin-sidebar-logout">@Html.AntiForgeryToken()<button type="submit" class="icon-button" title="Sign Out" aria-label="Sign Out"><i class="bi bi-box-arrow-right"></i></button></form></div>
</aside>
