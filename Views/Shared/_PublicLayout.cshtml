<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GameHub Arena - premium courts for padel, badminton, football, and cricket." />
    <title>@ViewData["Title"] - GameHub Arena</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toasts.css" asp-append-version="true" />
</head>
<body class="public-page">
    <partial name="_Navbar" />

    <main id="top" role="main">
        @RenderBody()
    </main>

    <footer class="public-footer" id="contact">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a class="brand-mark footer-logo" href="#top" aria-label="GameHub home">
                        <span class="brand-icon">G</span>
                        <span>
                            <strong>GameHub</strong>
                            <small>Arena</small>
                        </span>
                    </a>
                    <p>Play more. Live better. Premium sports arena for everyone.</p>
                    <div class="social-links" aria-label="Social links">
                        <a href="@Url.Action("Index", "Home")#contact" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="@Url.Action("Index", "Home")#contact" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="@Url.Action("Index", "Home")#contact" aria-label="Twitter X"><i class="bi bi-twitter-x"></i></a>
                        <a href="@Url.Action("Index", "Home")#contact" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <div>
                    <h3>Quick Links</h3>
                    <a href="#top">Home</a>
                    <a href="#sports">Sports</a>
                    <a href="#facilities">Facilities</a>
                    <a href="#membership">Membership</a>
                    <a href="#gallery">Gallery</a>
                    <a href="#contact">Contact</a>
                </div>

                <div>
                    <h3>Support</h3>
                    <a href="@Url.Action("HowItWorks", "Courts")">How Booking Works</a>
                    <a href="@Url.Action("Plans", "MyMemberships")">Membership Plans</a>
                    <a href="@Url.Action("Signup", "Account")">Create Account</a>
                    <a href="#contact">Contact Us</a>
                </div>

                <div>
                    <h3>Contact Us</h3>
                    <p><i class="bi bi-geo-alt-fill"></i> 123 Sports Avenue, Lahore</p>
                    <p><i class="bi bi-telephone-fill"></i> +92 300 1234567</p>
                    <p><i class="bi bi-envelope-fill"></i> info@gamehub.com</p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year GameHub Arena. All rights reserved.</span>
                <span>Premium court experience in Pakistan.</span>
            </div>
        </div>
    </footer>
    <partial name="_ToastContainer" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/toasts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
