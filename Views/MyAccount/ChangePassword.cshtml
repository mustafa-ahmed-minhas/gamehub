@model CustomerChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_CustomerLayout";
}

<section class="account-editor">
    <div class="container narrow">
        <div class="section-heading">
            <span class="eyebrow-pill">Account Security</span>
            <h1>Change Password</h1>
            <p>Use a strong password to keep your GameHub account protected.</p>
        </div>
        <form asp-action="ChangePassword" method="post" class="profile-form-card" data-account-form>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="password-wrap">
                <div class="form-floating"><input asp-for="CurrentPassword" class="form-control" placeholder="Current password" /><label asp-for="CurrentPassword"></label></div>
                <button class="password-toggle" type="button" data-password-toggle><i class="bi bi-eye"></i></button>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="password-wrap">
                <div class="form-floating"><input asp-for="NewPassword" class="form-control" placeholder="New password" data-password-input /><label asp-for="NewPassword"></label></div>
                <button class="password-toggle" type="button" data-password-toggle><i class="bi bi-eye"></i></button>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="password-wrap">
                <div class="form-floating"><input asp-for="ConfirmNewPassword" class="form-control" placeholder="Confirm new password" data-confirm-password /><label asp-for="ConfirmNewPassword"></label></div>
                <button class="password-toggle" type="button" data-password-toggle><i class="bi bi-eye"></i></button>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>
            <div class="password-meter" data-password-meter><span></span></div>
            <p class="field-hint" data-password-text>Use uppercase, lowercase, number and special character.</p>
            <div class="sticky-action-bar">
                <a class="btn-ghost-light" asp-action="Index">Cancel</a>
                <button class="btn-premium" type="submit" data-loading-button><i class="bi bi-shield-check"></i> Change Password</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
