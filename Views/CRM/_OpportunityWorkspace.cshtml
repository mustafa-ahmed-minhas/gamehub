@model CrmIndexViewModel
@using GameHub.Helpers
@using Microsoft.AspNetCore.Html
@using System.Net
@{
    var activeFilters = new[] { "stage", "type", "assignedToUserId", "sportId" }.Count(x => !string.IsNullOrWhiteSpace(Q(x)));
    var stages = Enum.GetValues<OpportunityStage>();
    var avgProbability = Model.Opportunities.Any() ? (int)Math.Round(Model.Opportunities.Average(x => x.ProbabilityPercentage)) : 0;
    var closingThisMonth = Model.Opportunities.Count(x => x.ExpectedCloseDate.Month == DateTime.UtcNow.Month && x.ExpectedCloseDate.Year == DateTime.UtcNow.Year);
    var won = Model.Opportunities.Count(x => x.Stage == OpportunityStage.Won);
    var lost = Model.Opportunities.Count(x => x.Stage == OpportunityStage.Lost);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || activeFilters > 0;
    var start = Model.Opportunities.Count == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);
    var pageStart = Math.Max(1, Model.CurrentPage - 3);
    var pageEnd = Math.Min(Model.TotalPages, pageStart + 6);
    pageStart = Math.Max(1, pageEnd - 6);
}

<section class="arena-card crm-opportunities-card">
    <form class="arena-toolbar" method="get" data-crm-toolbar>
        <input type="hidden" name="tab" value="opportunities" />
        <input type="hidden" name="viewMode" value="@Model.ViewMode" />
        <div class="arena-search">
            <i class="bi bi-search"></i>
            <input name="search" value="@Model.Search" placeholder="Search opportunities, customers or lead numbers..." aria-label="Search opportunities" autocomplete="off" data-crm-search />
        </div>
        <button class="admin-secondary-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#opportunityFilters">
            <i class="bi bi-sliders"></i> Filters <span>@activeFilters</span>
        </button>
        <a class="admin-secondary-button" asp-action="Index" asp-route-tab="opportunities" asp-route-viewMode="@Model.ViewMode"><i class="bi bi-x-circle"></i> Clear</a>
        <select name="sortBy" data-crm-filter aria-label="Sort opportunities">
            <option value="newest" selected="@(Q("sortBy") is "" or "newest")">Newest</option>
            <option value="oldest" selected="@(Q("sortBy") == "oldest")">Oldest</option>
            <option value="value" selected="@(Q("sortBy") == "value")">Expected Value</option>
            <option value="weighted" selected="@(Q("sortBy") == "weighted")">Weighted Value</option>
            <option value="close" selected="@(Q("sortBy") == "close")">Expected Close</option>
            <option value="stage" selected="@(Q("sortBy") == "stage")">Stage</option>
        </select>
        <select name="pageSize" data-crm-filter aria-label="Page size">
            @foreach (var size in new[] { 10, 25, 50 })
            {
                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
            }
        </select>
        @if (Model.CanManageOpportunities)
        {
            <a class="admin-action-button" asp-action="CreateOpportunity"><i class="bi bi-plus-lg"></i> Add Opportunity</a>
        }

        <div class="offcanvas offcanvas-end crm-filter-panel" tabindex="-1" id="opportunityFilters">
            <div class="offcanvas-header">
                <div><span class="admin-kicker">Opportunity Filters</span><h5>Refine pipeline</h5></div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <label>Stage<select name="stage">@(FilterOptions<OpportunityStage>("stage"))</select></label>
                <label>Type<select name="type">@(FilterOptions<OpportunityType>("type"))</select></label>
                <label>Owner<select name="assignedToUserId"><option value="">All Owners</option>@foreach (var item in Model.UserOptions) { <option value="@item.Value" selected="@(Q("assignedToUserId") == item.Value)">@item.Text</option> }</select></label>
                <label>Sport<select name="sportId"><option value="">All Sports</option>@foreach (var item in Model.SportOptions) { <option value="@item.Value" selected="@(Q("sportId") == item.Value)">@item.Text</option> }</select></label>
                <div class="crm-filter-actions">
                    <button class="admin-action-button" type="submit"><i class="bi bi-check2"></i> Apply Filters</button>
                    <a class="admin-secondary-button" asp-action="Index" asp-route-tab="opportunities">Clear All</a>
                </div>
            </div>
        </div>
    </form>

    <div class="crm-active-filters">
        @foreach (var key in new[] { "stage", "type", "assignedToUserId", "sportId" })
        {
            if (!string.IsNullOrWhiteSpace(Q(key)))
            {
                <span class="crm-filter-chip">@key: @Q(key)</span>
            }
        }
    </div>

    @if (Model.ViewMode == "kanban")
    {
        <div class="crm-pipeline-summary crm-opportunity-strip">
            <span>Total pipeline <strong>@Model.CurrencySymbol @Model.PipelineValue.ToString("N0")</strong></span>
            <span>Weighted <strong>@Model.CurrencySymbol @Model.WeightedPipeline.ToString("N0")</strong></span>
            <span>Average probability <strong>@avgProbability%</strong></span>
            <span>Closing this month <strong>@closingThisMonth</strong></span>
            <span>Win rate <strong>@(won + lost == 0 ? 0 : (int)Math.Round(won * 100m / (won + lost)))%</strong></span>
        </div>
        <div class="crm-kanban crm-kanban-pro opportunities">
            @foreach (var stage in stages)
            {
                var items = Model.Opportunities.Where(x => x.Stage == stage).ToList();
                <section class="crm-stage-column stage-@stage.ToString().ToLowerInvariant()">
                    <header><div><strong>@stage.GetDisplayName()</strong><small>@Model.CurrencySymbol @items.Sum(x => x.WeightedValue).ToString("N0") weighted</small></div><span>@items.Count</span></header>
                    @foreach (var item in items)
                    {
                        var days = item.ExpectedCloseDate.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;
                        var health = item.IsOverdue ? "Overdue" : item.Stage == OpportunityStage.OnHold ? "On Hold" : days <= 3 ? "At Risk" : "On Track";
                        <article class="crm-kanban-card crm-opportunity-card">
                            <a asp-action="OpportunityDetails" asp-route-id="@item.Id" class="crm-card-main">
                                <strong>@item.Name</strong>
                                <span>@item.OpportunityNumber</span>
                                <em>@item.CustomerName</em>
                            </a>
                            <div class="crm-money-line"><span>@Model.CurrencySymbol @item.ExpectedValue.ToString("N0")</span><strong>@item.ProbabilityPercentage%</strong></div>
                            <div class="crm-probability"><i style="width:@item.ProbabilityPercentage%"></i></div>
                            <div class="crm-card-footer">
                                <span><i class="bi bi-cash-stack"></i> @Model.CurrencySymbol @item.WeightedValue.ToString("N0")</span>
                                <span><i class="bi bi-calendar-event"></i> @item.ExpectedCloseDate.ToString("MMM dd")</span>
                                <span class="health-@health.ToLowerInvariant().Replace(" ", "-")"><i class="bi bi-pulse"></i> @health</span>
                            </div>
                            <div class="crm-card-actions">
                                <a asp-action="OpportunityDetails" asp-route-id="@item.Id" aria-label="View opportunity"><i class="bi bi-eye"></i></a>
                                @if (Model.CanManageOpportunities) { <a asp-action="EditOpportunity" asp-route-id="@item.Id" aria-label="Edit opportunity"><i class="bi bi-pencil"></i></a> }
                            </div>
                        </article>
                    }
                    @if (!items.Any()) { <div class="crm-empty-stage"><i class="bi bi-kanban"></i><strong>No deals</strong><span>Opportunities in @stage.GetDisplayName() appear here.</span></div> }
                </section>
            }
        </div>
    }
    else
    {
        @if (!Model.Opportunities.Any())
        {
            <div class="arena-empty">
                <i class="bi bi-briefcase"></i>
                <h2>@(hasFilters ? "No Matching Opportunities" : "No Opportunities Yet")</h2>
                <p>@(hasFilters ? "Try changing or clearing your filters." : "Qualified leads can be converted into opportunities when a commercial path is clear.")</p>
                @if (hasFilters)
                {
                    <a class="admin-secondary-button" asp-action="Index" asp-route-tab="opportunities"><i class="bi bi-x-circle"></i> Clear Filters</a>
                }
                else if (Model.CanManageOpportunities)
                {
                    <a class="admin-action-button" asp-action="CreateOpportunity"><i class="bi bi-plus-lg"></i> Add Opportunity</a>
                }
            </div>
        }
        else
        {
            <div class="arena-table-wrap crm-opportunities-table-wrap">
                <table class="arena-table crm-table crm-opportunities-table">
                    <thead><tr><th>Opportunity</th><th>Customer</th><th>Stage</th><th>Owner</th><th>Expected Value</th><th>Probability</th><th>Weighted Value</th><th>Expected Close</th><th>Actions</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Opportunities)
                    {
                        var days = item.ExpectedCloseDate.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;
                        var health = item.IsOverdue ? "Overdue" : item.Stage == OpportunityStage.OnHold ? "On Hold" : days <= 3 ? "At Risk" : "On Track";
                        var ownerInitials = string.IsNullOrWhiteSpace(item.AssignedTo) ? "U" : string.Join("", item.AssignedTo.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
                        <tr>
                            <td data-label="Opportunity"><div class="user-cell membership-name-cell crm-person-cell"><span class="user-avatar membership-table-avatar crm-mini-avatar deal"><i class="bi bi-briefcase"></i></span><div><strong>@item.Name</strong><small>@item.OpportunityNumber</small><em>Source: @item.LeadNumber</em><span class="crm-inline-indicator">@item.Type.GetDisplayName()</span></div></div></td>
                            <td data-label="Customer"><strong>@item.CustomerName</strong></td>
                            <td data-label="Stage"><span class="membership-status-badge crm-opportunity-badge stage-@item.Stage.ToString().ToLowerInvariant().Replace("_", "")"><i></i>@item.Stage.GetDisplayName()</span></td>
                            <td data-label="Owner"><div class="user-cell membership-name-cell crm-owner-cell"><span class="user-avatar membership-table-avatar">@ownerInitials</span><div><strong>@(item.AssignedTo ?? "Unassigned")</strong>@if (string.IsNullOrWhiteSpace(item.AssignedTo)) { <small class="crm-overdue-text">Needs owner</small> }</div></div></td>
                            <td data-label="Expected Value"><strong>@Model.CurrencySymbol @item.ExpectedValue.ToString("N0")</strong></td>
                            <td data-label="Probability"><div class="crm-probability-cell"><span>@item.ProbabilityPercentage%</span><i><b style="width:@item.ProbabilityPercentage%"></b></i></div></td>
                            <td data-label="Weighted Value"><strong>@Model.CurrencySymbol @item.WeightedValue.ToString("N0")</strong></td>
                            <td data-label="Expected Close"><strong>@item.ExpectedCloseDate.ToString("MMM dd, yyyy")</strong><span class="membership-status-badge crm-opportunity-health health-@health.ToLowerInvariant().Replace(" ", "-")"><i></i>@health</span></td>
                            <td data-label="Actions">
                                <div class="membership-action-menu crm-opportunity-actions">
                                    <a class="membership-icon-button" asp-action="OpportunityDetails" asp-route-id="@item.Id" aria-label="View opportunity" data-tooltip="View"><i class="bi bi-eye"></i></a>
                                    @if (Model.CanManageOpportunities)
                                    {
                                        <div class="dropdown">
                                            <button class="membership-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-tooltip="More"><i class="bi bi-three-dots"></i></button>
                                            <div class="dropdown-menu crm-opportunity-more-menu">
                                                <a class="dropdown-item" asp-action="OpportunityDetails" asp-route-id="@item.Id"><i class="bi bi-eye"></i> View Details</a>
                                                <a class="dropdown-item" asp-action="EditOpportunity" asp-route-id="@item.Id"><i class="bi bi-pencil"></i> Edit</a>
                                                <a class="dropdown-item" asp-action="OpportunityDetails" asp-route-id="@item.Id" asp-fragment="opportunity-actions"><i class="bi bi-arrow-repeat"></i> Stage Actions</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }

    @if (Model.Opportunities.Any())
    {
        <div class="arena-pagination">
            <span>Showing @start-@end of @Model.TotalRecords opportunities</span>
            <nav>
                <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : PageUrl(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i> Previous</a>
                @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                {
                    <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@PageUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                }
                <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : PageUrl(Model.CurrentPage + 1))">Next <i class="bi bi-chevron-right"></i></a>
            </nav>
        </div>
    }
</section>

@functions {
    string Q(string key) => Context.Request.Query[key].ToString();
    IHtmlContent FilterOptions<TEnum>(string key) where TEnum : struct, Enum
    {
        var html = new System.Text.StringBuilder("<option value=\"\">All</option>");
        foreach (var item in Enum.GetValues<TEnum>())
        {
            var selected = Q(key) == item.ToString() ? " selected" : "";
            html.Append($"<option value=\"{item}\"{selected}>{item.GetDisplayName()}</option>");
        }
        return new HtmlString(html.ToString());
    }
    string PageUrl(int page)
    {
        var pairs = new List<string>();
        foreach (var item in Context.Request.Query)
        {
            if (item.Key.Equals("page", StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var value in item.Value)
            {
                if (!string.IsNullOrWhiteSpace(value)) pairs.Add($"{WebUtility.UrlEncode(item.Key)}={WebUtility.UrlEncode(value)}");
            }
        }
        pairs.Add($"page={page}");
        return $"{Context.Request.Path}?{string.Join("&", pairs)}";
    }
}