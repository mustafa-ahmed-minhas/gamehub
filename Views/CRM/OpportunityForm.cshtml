@model OpportunityFormViewModel
@using GameHub.Helpers
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Opportunity" : "Create Opportunity";
    Layout = "_AdminLayout";
}
<section class="crm-page crm-form-page">
    <header class="crm-header"><div><a class="customer-back-link" asp-action="Index" asp-route-tab="opportunities"><i class="bi bi-arrow-left"></i> Back to CRM</a><span class="admin-kicker">Opportunity Management</span><h1>@ViewData["Title"]</h1><p>Track expected value, probability, customer requirement and stage movement.</p></div></header>
    <form method="post" class="crm-form-grid" data-crm-form>
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
        <main class="crm-form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <fieldset><legend>Opportunity Identity</legend><div class="crm-field-grid"><label><span>Name *</span><input asp-for="Name" data-preview-name /><small asp-validation-for="Name"></small></label><label><span>Type</span><select asp-for="Type" asp-items="Html.GetEnumSelectList<OpportunityType>()"></select></label><label><span>Lead</span><select asp-for="LeadId" asp-items="Model.LeadOptions"></select></label><label><span>Customer</span><select asp-for="CustomerId" asp-items="Model.CustomerOptions"><option value="">Use lead contact</option></select></label><label class="wide"><span>Description</span><textarea asp-for="Description"></textarea></label></div></fieldset>
            <fieldset><legend>Service Context</legend><div class="crm-field-grid"><label><span>Sport</span><select asp-for="SportId" asp-items="Model.SportOptions"><option value="">Any sport</option></select></label><label><span>Facility</span><select asp-for="FacilityId" asp-items="Model.FacilityOptions"><option value="">Any facility</option></select></label><label><span>Court</span><select asp-for="CourtId" asp-items="Model.CourtOptions"><option value="">Any court</option></select></label><label><span>Membership Plan</span><select asp-for="MembershipPlanId" asp-items="Model.MembershipPlanOptions"><option value="">No plan</option></select></label></div></fieldset>
            <fieldset><legend>Commercial Information</legend><div class="crm-field-grid"><label><span>Expected Value (@Model.CurrencySymbol)</span><input asp-for="ExpectedValue" type="number" min="0" step="0.01" data-preview-value /></label><label><span>Probability %</span><input asp-for="ProbabilityPercentage" type="number" min="0" max="100" data-preview-probability /></label><label><span>Expected Close</span><input asp-for="ExpectedCloseDate" type="date" /></label><label><span>Stage</span><select asp-for="Stage" asp-items="Html.GetEnumSelectList<OpportunityStage>()" data-stage-select data-preview-stage></select></label></div></fieldset>
            <fieldset><legend>Requirement and Outcome</legend><div class="crm-field-grid"><label class="wide"><span>Customer Requirement</span><textarea asp-for="CustomerRequirement"></textarea></label><label class="wide"><span>Proposed Solution</span><textarea asp-for="ProposedSolution"></textarea></label><label class="wide"><span>Competitor Information</span><textarea asp-for="CompetitorInformation"></textarea></label><label><span>Actual Close</span><input asp-for="ActualCloseDate" type="date" /></label><label class="wide"><span>Loss Reason</span><textarea asp-for="LossReason"></textarea></label><label class="wide"><span>Internal Notes</span><textarea asp-for="InternalNotes"></textarea></label><label><span>Assigned To</span><select asp-for="AssignedToUserId" asp-items="Model.UserOptions"><option value="">Unassigned</option></select></label><label><span>Tags</span><input asp-for="Tags" /></label><label class="crm-switch"><input asp-for="IsActive" /><span>Active opportunity</span></label></div></fieldset>
            <div class="crm-savebar"><a class="admin-secondary-button" asp-action="Index" asp-route-tab="opportunities">Cancel</a><button class="admin-action-button" type="submit"><i class="bi bi-check2"></i> Save Opportunity</button></div>
        </main>
        <aside class="crm-preview-card"><span>Live Preview</span><h2 data-preview-name-text>@(string.IsNullOrWhiteSpace(Model.Name) ? "New Opportunity" : Model.Name)</h2><p><strong data-preview-stage-text>@Model.Stage.GetDisplayName()</strong></p><div><span>@Model.CurrencySymbol <strong data-preview-value-text>@Model.ExpectedValue.ToString("N0")</strong></span><span><strong data-preview-probability-text>@Model.ProbabilityPercentage</strong>% probability</span></div><em data-preview-weighted>@Model.CurrencySymbol @((Model.ExpectedValue * Model.ProbabilityPercentage / 100m).ToString("N0")) weighted</em></aside>
    </form>
</section>
@section Styles { <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/crm.js" asp-append-version="true"></script> }
