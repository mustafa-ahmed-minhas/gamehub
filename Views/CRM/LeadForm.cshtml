@model LeadFormViewModel
@using GameHub.Helpers
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Lead" : "Create Lead";
    Layout = "_AdminLayout";
    var isCreate = !Model.Id.HasValue;
    var statusLocked = isCreate || Model.Status == LeadStatus.Converted;
    var lockedStatus = isCreate ? LeadStatus.New : Model.Status;
    // Only the current status plus valid next workflow steps are offered;
    // Qualified and Converted are set by their dedicated lead actions.
    var allowedStatusValues = LeadStatusRules.AllowedTargets(Model.Status)
        .Where(x => x is not (LeadStatus.Qualified or LeadStatus.Converted))
        .Select(x => (int)x)
        .ToHashSet();
    var statusItems = Html.GetEnumSelectList<LeadStatus>()
        .Where(x => int.TryParse(x.Value, out var value) && (value == (int)Model.Status || allowedStatusValues.Contains(value)))
        .ToList();
}
<section class="crm-page crm-form-page crm-lead-form-page">
    <header class="lead-form-header">
        <div>
            <a class="customer-back-link" asp-action="Index" asp-route-tab="leads"><i class="bi bi-arrow-left"></i> Back to CRM</a>
            <span class="admin-kicker">Lead Management</span>
            <h1>@ViewData["Title"]</h1>
            <p>Capture inquiry information, ownership, priority and follow-up context in one place.</p>
        </div>
        <div class="lead-form-header-meta">
            <span class="lead-form-mode"><i class="bi bi-@(isCreate ? "plus-circle" : "pencil-square")"></i> @(isCreate ? "New record" : Model.LeadNumber)</span>
            <span class="lead-form-required-note"><em>*</em> Required field</span>
        </div>
    </header>

    <form method="post" class="lead-form" data-crm-form data-fv-form>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="lead-form-layout">
            <main class="lead-form-main">
                <div asp-validation-summary="ModelOnly" class="lead-form-summary"></div>

                @if (Model.PossibleDuplicates.Any())
                {
                    <div class="lead-form-alert warning">
                        <span class="lead-form-alert-icon"><i class="bi bi-exclamation-triangle"></i></span>
                        <div class="lead-form-alert-body">
                            <strong>Possible duplicates found</strong>
                            <p>Review these existing records before saving this inquiry.</p>
                            <div class="lead-form-alert-list">
                                @foreach (var item in Model.PossibleDuplicates)
                                {
                                    <a asp-action="LeadDetails" asp-route-id="@item.Id">@item.LeadNumber &middot; @item.CustomerName <span>@item.Status.GetDisplayName()</span></a>
                                }
                            </div>
                            <label class="lead-checkline">
                                <input asp-for="AllowDuplicate" />
                                <span>Proceed as a separate inquiry</span>
                            </label>
                        </div>
                    </div>
                }

                @if (!isCreate && statusLocked)
                {
                    <div class="lead-form-alert info">
                        <span class="lead-form-alert-icon"><i class="bi bi-lock"></i></span>
                        <div class="lead-form-alert-body">
                            <strong>Converted lead</strong>
                            <p>This lead is linked to an opportunity, so its status is locked. Contact details can still be corrected.</p>
                        </div>
                    </div>
                }

                <section class="lead-form-section">
                    <header class="lead-section-head">
                        <span class="lead-section-icon"><i class="bi bi-person-lines-fill"></i></span>
                        <div>
                            <h2>Customer &amp; Contact</h2>
                            <p>Who is inquiring and how the team can reach them.</p>
                        </div>
                    </header>
                    <div class="lead-form-grid">
                        <label class="lead-field">
                            <span class="lead-field-label">Existing Customer</span>
                            <select asp-for="CustomerId" asp-items="Model.CustomerOptions">
                                <option value="">No customer linked</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Customer Name <em class="lead-required" aria-hidden="true">*</em></span>
                            <input asp-for="CustomerName" placeholder="e.g. Ayaan Khan" autocomplete="name" data-preview-name data-fv-rule="required,letters" />
                            <span asp-validation-for="CustomerName" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Email</span>
                            <input asp-for="Email" type="email" placeholder="name@company.com" autocomplete="email" data-preview-contact data-fv-rule="email" />
                            <span asp-validation-for="Email" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Phone</span>
                            <input asp-for="Phone" type="tel" inputmode="numeric" placeholder="03001234567" autocomplete="tel" data-preview-contact data-fv-rule="phone" />
                            <span asp-validation-for="Phone" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">WhatsApp</span>
                            <input asp-for="WhatsAppNumber" type="tel" inputmode="numeric" placeholder="03001234567" data-fv-rule="phone" />
                            <span asp-validation-for="WhatsAppNumber" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Organization</span>
                            <input asp-for="OrganizationName" placeholder="e.g. Skyline Builders" autocomplete="organization" data-fv-rule="org" />
                            <span asp-validation-for="OrganizationName" class="text-danger lead-field-error"></span>
                        </label>
                    </div>
                </section>

                <section class="lead-form-section">
                    <header class="lead-section-head">
                        <span class="lead-section-icon"><i class="bi bi-clipboard2-data"></i></span>
                        <div>
                            <h2>Inquiry Details</h2>
                            <p>What the customer is looking for, where and when.</p>
                        </div>
                    </header>
                    <div class="lead-form-grid">
                        <label class="lead-field">
                            <span class="lead-field-label">Source</span>
                            <select asp-for="Source" asp-items="Html.GetEnumSelectList<LeadSource>()" data-preview-source></select>
                            <span asp-validation-for="Source" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Service Interest</span>
                            <select asp-for="ServiceInterest" asp-items="Html.GetEnumSelectList<LeadServiceInterest>()" data-preview-interest></select>
                            <span asp-validation-for="ServiceInterest" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Sport</span>
                            <select asp-for="SportId" asp-items="Model.SportOptions">
                                <option value="">Any sport</option>
                            </select>
                            <span asp-validation-for="SportId" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Facility</span>
                            <select asp-for="FacilityId" asp-items="Model.FacilityOptions">
                                <option value="">Any facility</option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Court</span>
                            <select asp-for="CourtId" asp-items="Model.CourtOptions">
                                <option value="">Any court</option>
                            </select>
                            <span asp-validation-for="CourtId" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Membership Plan</span>
                            <select asp-for="MembershipPlanId" asp-items="Model.MembershipPlanOptions">
                                <option value="">No plan</option>
                            </select>
                            <span asp-validation-for="MembershipPlanId" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Preferred Date</span>
                            <input asp-for="PreferredDate" type="date" data-fv-rule="past" />
                            <span asp-validation-for="PreferredDate" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Preferred Time</span>
                            <input asp-for="PreferredStartTime" type="time" data-fv-rule="time" />
                            <span asp-validation-for="PreferredStartTime" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Expected Players</span>
                            <input asp-for="ExpectedPlayerCount" type="number" min="1" max="1000" placeholder="e.g. 8" data-fv-rule="int" data-fv-min="1" data-fv-max="1000" />
                            <span asp-validation-for="ExpectedPlayerCount" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field lead-field-wide">
                            <span class="lead-field-label">Subject</span>
                            <input asp-for="InquirySubject" placeholder="e.g. Weekend padel court booking" data-fv-rule="org" />
                            <span asp-validation-for="InquirySubject" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field lead-field-wide">
                            <span class="lead-field-label">Details</span>
                            <textarea asp-for="InquiryDetails" rows="4" placeholder="Share the customer's requirements, preferred timings and any special requests..."></textarea>
                            <span asp-validation-for="InquiryDetails" class="text-danger lead-field-error"></span>
                        </label>
                    </div>
                </section>

                <section class="lead-form-section">
                    <header class="lead-section-head">
                        <span class="lead-section-icon"><i class="bi bi-sliders2"></i></span>
                        <div>
                            <h2>Ownership &amp; Workflow</h2>
                            <p>Route the lead, set its priority and schedule the next touchpoint.</p>
                        </div>
                    </header>
                    <div class="lead-form-grid">
                        <label class="lead-field">
                            <span class="lead-field-label">Assigned To</span>
                            <select asp-for="AssignedToUserId" asp-items="Model.UserOptions">
                                <option value="">Unassigned</option>
                            </select>
                            <small class="lead-field-help">Only Sales users are eligible for lead assignment.</small>
                            <span asp-validation-for="AssignedToUserId" class="text-danger lead-field-error"></span>
                        </label>
                        @if (statusLocked)
                        {
                            <label class="lead-field">
                                <span class="lead-field-label">Status</span>
                                <span class="lead-status-locked">
                                    <span class="membership-status-badge crm-lead-badge status-@lockedStatus.ToString().ToLowerInvariant()"><i></i>@lockedStatus.GetDisplayName()</span>
                                    <input asp-for="Status" type="hidden" value="@((int)lockedStatus)" />
                                </span>
                                <small class="lead-field-help">@(isCreate ? "New leads always start as New; use the lead actions to progress the workflow." : "Only the Convert to Opportunity workflow can change this status.")</small>
                            </label>
                        }
                        else
                        {
                            <label class="lead-field">
                                <span class="lead-field-label">Status</span>
                                <select asp-for="Status" asp-items="statusItems" data-preview-status data-fv-status-select></select>
                                <span asp-validation-for="Status" class="text-danger lead-field-error"></span>
                                <small class="lead-field-help">Qualified and Converted are set by their dedicated lead actions.</small>
                            </label>
                        }
                        <label class="lead-field">
                            <span class="lead-field-label">Priority</span>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<LeadPriority>()" data-preview-priority></select>
                            <span asp-validation-for="Priority" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field">
                            <span class="lead-field-label">Next Follow-up</span>
                            <input asp-for="NextFollowUpAt" type="datetime-local" />
                            <span asp-validation-for="NextFollowUpAt" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field lead-field-wide">
                            <span class="lead-field-label">Tags</span>
                            <input asp-for="Tags" placeholder="corporate, weekend, follow-up" data-fv-rule="tags" />
                            <span asp-validation-for="Tags" class="text-danger lead-field-error"></span>
                        </label>
                    </div>
                </section>

                <section class="lead-form-section">
                    <header class="lead-section-head">
                        <span class="lead-section-icon"><i class="bi bi-journal-text"></i></span>
                        <div>
                            <h2>Notes &amp; Visibility</h2>
                            <p>Qualification context, internal notes and whether the lead stays active.</p>
                        </div>
                    </header>
                    <div class="lead-form-grid">
                        <label class="lead-field lead-field-wide">
                            <span class="lead-field-label">Qualification Notes</span>
                            <textarea asp-for="QualificationNotes" rows="3" placeholder="Why is this lead qualified? Capture needs, budget and decision timeline..."></textarea>
                            <span asp-validation-for="QualificationNotes" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field lead-field-wide">
                            <span class="lead-field-label">Disqualification Reason</span>
                            <textarea asp-for="DisqualificationReason" rows="2" placeholder="If this lead was disqualified, note the reason..."></textarea>
                            <span asp-validation-for="DisqualificationReason" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-field lead-field-wide">
                            <span class="lead-field-label">Internal Notes</span>
                            <textarea asp-for="InternalNotes" rows="3" placeholder="Private context for the team, e.g. preferred contact window or account history..."></textarea>
                            <span asp-validation-for="InternalNotes" class="text-danger lead-field-error"></span>
                        </label>
                        <label class="lead-checkline lead-field-wide lead-active-toggle">
                            <input asp-for="IsActive" />
                            <span>Active lead</span>
                            <small>Inactive leads stay on record but are excluded from the active pipeline.</small>
                        </label>
                    </div>
                </section>

                <div class="lead-form-savebar">
                    <a class="admin-secondary-button" asp-action="Index" asp-route-tab="leads">Cancel</a>
                    <button class="admin-action-button" type="submit"><i class="bi bi-check2"></i> Save Lead</button>
                </div>
            </main>

            <aside class="lead-form-aside">
                <div class="lead-summary-card">
                    <span class="lead-summary-kicker"><i class="bi bi-stars"></i> Live Preview</span>
                    <span class="lead-summary-avatar" data-preview-initial>@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "N" : Model.CustomerName.Trim().Substring(0, 1).ToUpperInvariant())</span>
                    <h2 data-preview-name-text>@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "New Lead" : Model.CustomerName)</h2>
                    <p data-preview-contact-text>@(Model.Email ?? Model.Phone ?? "No contact yet")</p>
                    <div class="lead-summary-meta">
                        <strong data-preview-interest-text>@Model.ServiceInterest.GetDisplayName()</strong>
                        <em data-preview-source-text>@Model.Source.GetDisplayName()</em>
                    </div>
                    <div class="lead-summary-badges">
                        <span data-preview-priority-text>@Model.Priority.GetDisplayName()</span>
                        <span data-preview-status-text>@Model.Status.GetDisplayName()</span>
                    </div>
                </div>

                <div class="lead-summary-help">
                    <span class="lead-summary-help-icon"><i class="bi bi-lightbulb"></i></span>
                    <div>
                        <strong>Quick tips</strong>
                        <ul>
                            <li>Add at least one contact method so the team can reach the customer.</li>
                            <li>Assign an owner before qualifying or converting the lead.</li>
                            <li>Use tags to make the lead easy to find later.</li>
                        </ul>
                    </div>
                </div>
            </aside>
        </div>
    </form>
</section>
@section Styles { <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/field-validation.js" asp-append-version="true"></script><script src="~/js/crm.js" asp-append-version="true"></script> }
