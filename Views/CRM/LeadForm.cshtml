@model LeadFormViewModel
@using GameHub.Helpers
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Lead" : "Create Lead";
    Layout = "_AdminLayout";
}
<section class="crm-page crm-form-page">
    <header class="crm-header"><div><a class="customer-back-link" asp-action="Index" asp-route-tab="leads"><i class="bi bi-arrow-left"></i> Back to CRM</a><span class="admin-kicker">Lead Management</span><h1>@ViewData["Title"]</h1><p>Capture inquiry information, ownership, priority and follow-up context.</p></div></header>
    <form method="post" class="crm-form-grid" data-crm-form>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <main class="crm-form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (Model.PossibleDuplicates.Any())
            {
                <div class="crm-warning"><strong>Possible duplicates found</strong>@foreach (var item in Model.PossibleDuplicates) { <a asp-action="LeadDetails" asp-route-id="@item.Id">@item.LeadNumber - @item.CustomerName (@item.Status.GetDisplayName())</a> }<label><input asp-for="AllowDuplicate" /> Proceed as separate inquiry</label></div>
            }
            <fieldset><legend>Contact Information</legend><div class="crm-field-grid"><label><span>Existing Customer</span><select asp-for="CustomerId" asp-items="Model.CustomerOptions"><option value="">No customer linked</option></select></label><label><span>Customer Name *</span><input asp-for="CustomerName" data-preview-name /><small asp-validation-for="CustomerName"></small></label><label><span>Email</span><input asp-for="Email" data-preview-contact /><small asp-validation-for="Email"></small></label><label><span>Phone</span><input asp-for="Phone" data-preview-contact /></label><label><span>WhatsApp</span><input asp-for="WhatsAppNumber" /></label><label><span>Organization</span><input asp-for="OrganizationName" /></label></div></fieldset>
            <fieldset><legend>Inquiry Information</legend><div class="crm-field-grid"><label><span>Source</span><select asp-for="Source" asp-items="Html.GetEnumSelectList<LeadSource>()" data-preview-source></select></label><label><span>Service Interest</span><select asp-for="ServiceInterest" asp-items="Html.GetEnumSelectList<LeadServiceInterest>()" data-preview-interest></select></label><label><span>Sport</span><select asp-for="SportId" asp-items="Model.SportOptions"><option value="">Any sport</option></select></label><label><span>Facility</span><select asp-for="FacilityId" asp-items="Model.FacilityOptions"><option value="">Any facility</option></select></label><label><span>Court</span><select asp-for="CourtId" asp-items="Model.CourtOptions"><option value="">Any court</option></select></label><label><span>Membership Plan</span><select asp-for="MembershipPlanId" asp-items="Model.MembershipPlanOptions"><option value="">No plan</option></select></label><label><span>Preferred Date</span><input asp-for="PreferredDate" type="date" /></label><label><span>Preferred Time</span><input asp-for="PreferredStartTime" type="time" /></label><label><span>Duration Minutes</span><input asp-for="PreferredDurationMinutes" type="number" min="1" /></label><label><span>Expected Players</span><input asp-for="ExpectedPlayerCount" type="number" min="1" /></label><label class="wide"><span>Subject</span><input asp-for="InquirySubject" /></label><label class="wide"><span>Details</span><textarea asp-for="InquiryDetails"></textarea></label></div></fieldset>
            <fieldset><legend>Lead Management</legend><div class="crm-field-grid"><label><span>Assigned To</span><select asp-for="AssignedToUserId" asp-items="Model.UserOptions"><option value="">Unassigned</option></select></label><label><span>Status</span><select asp-for="Status" asp-items="Html.GetEnumSelectList<LeadStatus>()" data-preview-status></select></label><label><span>Priority</span><select asp-for="Priority" asp-items="Html.GetEnumSelectList<LeadPriority>()" data-preview-priority></select></label><label><span>Temperature</span><select asp-for="Temperature" asp-items="Html.GetEnumSelectList<LeadTemperature>()" data-preview-temp></select></label><label><span>Next Follow-up</span><input asp-for="NextFollowUpAt" type="datetime-local" /></label><label><span>Tags</span><input asp-for="Tags" /></label></div></fieldset>
            <fieldset><legend>Qualification and Notes</legend><div class="crm-field-grid"><label class="wide"><span>Qualification Notes</span><textarea asp-for="QualificationNotes"></textarea></label><label class="wide"><span>Disqualification Reason</span><textarea asp-for="DisqualificationReason"></textarea></label><label class="wide"><span>Internal Notes</span><textarea asp-for="InternalNotes"></textarea></label><label class="crm-switch"><input asp-for="IsActive" /><span>Active lead</span></label></div></fieldset>
            <div class="crm-savebar"><a class="admin-secondary-button" asp-action="Index" asp-route-tab="leads">Cancel</a><button class="admin-action-button" type="submit"><i class="bi bi-check2"></i> Save Lead</button></div>
        </main>
        <aside class="crm-preview-card"><span>Live Preview</span><h2 data-preview-name-text>@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "New Lead" : Model.CustomerName)</h2><p data-preview-contact-text>@(Model.Email ?? Model.Phone ?? "No contact yet")</p><div><strong data-preview-interest-text>@Model.ServiceInterest.GetDisplayName()</strong><em data-preview-source-text>@Model.Source.GetDisplayName()</em></div><div><span data-preview-priority-text>@Model.Priority.GetDisplayName()</span><span data-preview-temp-text>@Model.Temperature.GetDisplayName()</span><span data-preview-status-text>@Model.Status.GetDisplayName()</span></div></aside>
    </form>
</section>
@section Styles { <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/crm.js" asp-append-version="true"></script> }
