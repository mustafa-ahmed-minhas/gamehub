@model InvoicePreviewViewModel
@using GameHub.Helpers
@{ var invoice = Model.Invoice; var settings = Model.Settings; ViewData["Title"] = $"Invoice {invoice.InvoiceNumber}"; Layout = "_AdminLayout"; }
<section class="users-page customer-profile-page sales-cycle-page sales-document-page">
    <header class="customer-profile-header admin-reveal no-print"><div class="customer-profile-title"><a class="customer-back-link" asp-action="Details" asp-route-id="@invoice.Id"><i class="bi bi-arrow-left"></i> Back to Invoice</a><span class="admin-label">Document Preview</span><h1>Invoice @invoice.InvoiceNumber</h1><p>Review the customer-ready commercial document before printing or saving it as PDF.</p></div><div class="customer-detail-actions"><button class="admin-secondary-button" type="button" data-doc-print data-document-id="salesInvoiceDocument"><i class="bi bi-printer"></i> Print</button><button class="admin-action-button" type="button" data-doc-download data-document-id="salesInvoiceDocument"><i class="bi bi-download"></i> Download / Save PDF</button><div class="membership-action-menu"><button class="membership-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More preview actions"><i class="bi bi-three-dots"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-action="Details" asp-route-id="@invoice.Id"><i class="bi bi-arrow-left"></i> Back to details</a></li><li><a class="dropdown-item" asp-action="Index"><i class="bi bi-receipt"></i> Back to invoices</a></li></ul></div></div></header>
    <article id="salesInvoiceDocument" class="accounting-document invoice-document document-print-root" data-document-preview>
        <header class="invoice-document-header"><div class="invoice-document-brand"><span class="invoice-document-logo">G</span><div><strong>@settings.ArenaName</strong><small>Premium sports arena</small><p>@settings.Address<br />@settings.Phone · @settings.Email</p></div></div><div class="invoice-document-heading"><span>COMMERCIAL INVOICE</span><h1>INVOICE</h1><strong>@invoice.InvoiceNumber</strong><small>Revision @invoice.RevisionNumber</small></div></header>
        <div class="invoice-document-rule"></div>
        <section class="invoice-document-meta"><div class="invoice-document-block"><span>Bill To</span><h2>@invoice.Customer.FullName</h2><p>@invoice.Customer.CustomerCode<br />@invoice.Customer.Email<br />@(invoice.Customer.PrimaryPhone ?? "Phone not provided")<br />@(invoice.BillingAddress ?? invoice.Customer.AddressLine1 ?? "Address not provided")</p></div><div class="invoice-document-block invoice-document-facts"><span>Invoice Details</span><dl><div><dt>Invoice Date</dt><dd>@invoice.InvoiceDate.ToString("dd MMM yyyy")</dd></div><div><dt>Due Date</dt><dd>@invoice.DueDate.ToString("dd MMM yyyy")</dd></div><div><dt>Source</dt><dd>@invoice.SourceType.GetDisplayName()</dd></div><div><dt>Reference</dt><dd>@(invoice.SalesOrder?.SalesOrderNumber ?? "Direct invoice")</dd></div><div><dt>Status</dt><dd>@invoice.Status.GetDisplayName()</dd></div></dl></div></section>
        <section class="invoice-document-section"><div class="invoice-document-section-heading"><span>01</span><div><small>Services and charges</small><h2>Invoice Items</h2></div></div><table class="invoice-document-items"><thead><tr><th>Description</th><th>Qty</th><th>Rate</th><th>Discount</th><th>Tax</th><th>Total</th></tr></thead><tbody>@foreach (var item in invoice.Items.OrderBy(x => x.LineNumber)) { <tr><td><strong>@item.Description</strong><small>@item.ItemType.GetDisplayName()</small></td><td>@item.Quantity.ToString("N2") @item.UnitOfMeasure</td><td>@invoice.CurrencySymbol @item.UnitPrice.ToString("N2")</td><td>@item.DiscountPercentage.ToString("N0")%</td><td>@item.TaxPercentage.ToString("N0")%</td><td><strong>@invoice.CurrencySymbol @item.LineTotal.ToString("N2")</strong></td></tr> }</tbody></table></section>
        <section class="invoice-document-bottom"><div class="invoice-document-notes"><div><span>Payment Terms</span><p>@invoice.PaymentTerms</p></div><div><span>Terms & Conditions</span><p>@(invoice.TermsAndConditions ?? "Please contact the arena for questions about this invoice.")</p></div><div><span>Notes</span><p>@(invoice.CustomerNotes ?? "No additional notes.")</p></div></div><div class="invoice-document-total"><div><span>Subtotal</span><strong>@invoice.CurrencySymbol @invoice.Subtotal.ToString("N2")</strong></div><div><span>Discount</span><strong>- @invoice.CurrencySymbol @invoice.DiscountTotal.ToString("N2")</strong></div><div><span>Tax</span><strong>@invoice.CurrencySymbol @invoice.TaxTotal.ToString("N2")</strong></div><div><span>Adjustment</span><strong>@invoice.CurrencySymbol @invoice.AdjustmentAmount.ToString("N2")</strong></div><div class="grand"><span>Amount Due</span><strong>@invoice.CurrencySymbol @invoice.OutstandingAmount.ToString("N2")</strong></div><small>Total invoice value @invoice.CurrencySymbol @invoice.GrandTotal.ToString("N2") · Paid @invoice.CurrencySymbol @invoice.PaidAmount.ToString("N2")</small></div></section>
        <footer class="invoice-document-footer"><div><strong>Thank you for choosing @settings.ArenaName.</strong><p>Prepared by GameHub ERP · Support @settings.Email · @settings.Phone</p></div><div class="invoice-document-approval"><span>Approval status</span><strong>@invoice.Status.GetDisplayName()</strong><small>Revision @invoice.RevisionNumber</small></div></footer>
    </article>
</section>
@section Styles { <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/customer-documents.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/customer-documents-print.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/invoice-preview.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/document-print.js" asp-append-version="true"></script> }
