@model InvoiceIndexViewModel
@using GameHub.Helpers
@using GameHub.Models.Enums
@using System.Net
@{
    ViewData["Title"] = "Invoices";
    Layout = "_AdminLayout";

    var start = Model.TotalRecords == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords);
    var pageStart = Math.Max(1, Model.CurrentPage - 2);
    var pageEnd = Math.Min(Model.TotalPages, pageStart + 4);
    pageStart = Math.Max(1, pageEnd - 4);

    var draftCount = Model.Items.Count(x => x.Status is InvoiceStatus.Draft or InvoiceStatus.Rejected);
    var pendingCount = Model.Items.Count(x => x.Status == InvoiceStatus.SubmittedForApproval);
    var issuedCount = Model.Items.Count(x => x.Status is InvoiceStatus.Issued or InvoiceStatus.PartiallyPaid or InvoiceStatus.Paid or InvoiceStatus.Overdue);
    var overdueCount = Model.Items.Count(x => x.Status == InvoiceStatus.Overdue);

    var activeFilterCount = new[] { "sourceType", "status" }.Count(x => !string.IsNullOrWhiteSpace(Q(x)));
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || activeFilterCount > 0;

    string Q(string key) => Context.Request.Query[key].ToString();
    string PageUrl(int page)
    {
        var pairs = new List<string>();
        foreach (var item in Context.Request.Query)
        {
            if (item.Key.Equals("page", StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var value in item.Value) if (!string.IsNullOrWhiteSpace(value)) pairs.Add($"{WebUtility.UrlEncode(item.Key)}={WebUtility.UrlEncode(value)}");
        }
        pairs.Add($"page={page}");
        return $"{Context.Request.Path}?{string.Join("&", pairs)}";
    }
}

<section class="arena-page sales-cycle-page invoice-index-page">
    <header class="arena-header admin-reveal">
        <div>
            <span class="admin-label">Sales Management</span>
            <h1>Invoice Management</h1>
            <p>Create, approve and issue commercial invoices without recording payments in this phase.</p>
        </div>
        <div class="arena-actions">
            @if (Model.CanCreate)
            {
                <a class="admin-action-button" asp-action="CreateDirect"><i class="bi bi-plus-circle"></i> Direct Invoice</a>
            }
            <a class="admin-secondary-button" asp-controller="SalesOrders" asp-action="Index"><i class="bi bi-clipboard2-check"></i> Ready Orders</a>
        </div>
    </header>

    <div class="arena-summary-grid">
        <article><i class="bi bi-pencil-square"></i><span>Draft</span><strong data-counter>@draftCount</strong></article>
        <article><i class="bi bi-hourglass-split"></i><span>Pending Approval</span><strong data-counter>@pendingCount</strong></article>
        <article><i class="bi bi-send-check"></i><span>Issued</span><strong data-counter>@issuedCount</strong></article>
        <article><i class="bi bi-exclamation-circle"></i><span>Overdue</span><strong data-counter>@overdueCount</strong></article>
    </div>

    <div class="sales-cycle-layout sales-cycle-layout-wide">
        <main class="sales-cycle-main">
            <section class="arena-card">
                <form class="arena-toolbar" method="get" asp-action="Index">
                    <div class="arena-search">
                        <i class="bi bi-search"></i>
                        <input name="search" value="@Model.Search" placeholder="Search invoice, customer or sales order..." aria-label="Search invoices" autocomplete="off" data-sales-search />
                    </div>

                    <button class="admin-secondary-button" type="button" data-sales-filter-toggle aria-controls="invoiceFilterDrawer" aria-expanded="false">
                        <i class="bi bi-sliders"></i> Filters
                        <span class="membership-status-badge @(activeFilterCount > 0 ? "active" : "pending")" data-sales-filter-count @(activeFilterCount == 0 ? "hidden" : "")><i></i>@activeFilterCount</span>
                    </button>

                    <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-x-circle"></i> Clear</a>

                    <select name="sortBy" data-sales-filter aria-label="Sort invoices">
                        <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                        <option value="due" selected="@(Model.SortBy == "due")">Due Date</option>
                        <option value="total" selected="@(Model.SortBy == "total")">Highest Total</option>
                    </select>

                    <select name="pageSize" data-sales-filter aria-label="Page size">
                        @foreach (var size in new[] { 10, 25, 50 })
                        {
                            <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                        }
                    </select>
                </form>

                <div class="sales-cycle-chips">
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <span>Search: @Model.Search</span>
                    }
                    @if (Model.SourceType.HasValue)
                    {
                        <span>Source: @Model.SourceType.Value.GetDisplayName()</span>
                    }
                    @if (Model.Status.HasValue)
                    {
                        <span>Status: @Model.Status.Value.GetDisplayName()</span>
                    }
                    @if (hasFilters)
                    {
                        <a asp-action="Index"><i class="bi bi-x"></i> Clear All</a>
                    }
                </div>

                @if (!Model.Items.Any())
                {
                    <div class="arena-empty">
                        <i class="bi bi-receipt"></i>
                        <h2>@(hasFilters ? "No Matching Invoices" : "No Invoices Yet")</h2>
                        <p>@(hasFilters ? "Try changing or clearing your filters." : "Create an invoice from a ready sales order or start a direct invoice.")</p>
                        @if (hasFilters)
                        {
                            <a class="admin-secondary-button" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Clear Filters</a>
                        }
                        else if (Model.CanCreate)
                        {
                            <a class="admin-action-button" asp-action="CreateDirect"><i class="bi bi-plus-lg"></i> Direct Invoice</a>
                        }
                    </div>
                }
                else
                {
                    <div class="arena-table-wrap">
                        <table class="arena-table sales-cycle-table">
                            <thead>
                                <tr>
                                    <th scope="col">Invoice</th>
                                    <th scope="col">Source</th>
                                    <th scope="col">Customer</th>
                                    <th scope="col">Invoice Date</th>
                                    <th scope="col">Due Date</th>
                                    <th scope="col">Total</th>
                                    <th scope="col">Outstanding</th>
                                    <th scope="col">Status</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in Model.Items)
                                {
                                    var approvalLabel = invoice.Status switch { InvoiceStatus.Draft => "Draft", InvoiceStatus.SubmittedForApproval => "Pending", InvoiceStatus.Rejected => "Rejected", _ => "Approved" };
                                    var isEditable = invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Rejected;
                                    var isPending = invoice.Status == InvoiceStatus.SubmittedForApproval;
                                    var isApproved = invoice.Status == InvoiceStatus.Approved;
                                    var isIssued = invoice.Status == InvoiceStatus.Issued;
                                    var initials = string.Join("", (invoice.CustomerName ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
                                    <tr>
                                        <td data-label="Invoice">
                                            <strong title="@invoice.InvoiceNumber">@invoice.InvoiceNumber</strong>
                                            <small title="@(invoice.Subject ?? "Commercial invoice")">@(invoice.Subject ?? "Commercial invoice")</small>
                                            <em>Revision @invoice.RevisionNumber</em>
                                        </td>
                                        <td data-label="Source">
                                            <span class="membership-status-badge @(invoice.SourceType == InvoiceSourceType.SalesOrder ? StatusBadgeHelper.Confirmed : StatusBadgeHelper.Active)"><i></i>@invoice.SourceType.GetDisplayName()</span>
                                            <small>@(invoice.SalesOrderNumber ?? "Direct invoice")</small>
                                        </td>
                                        <td data-label="Customer">
                                            <div class="user-cell membership-name-cell">
                                                <span class="user-avatar membership-table-avatar">@(initials.Length == 0 ? "I" : initials)</span>
                                                <div>
                                                    <strong title="@invoice.CustomerName">@invoice.CustomerName</strong>
                                                    <small>@invoice.CustomerCode</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Invoice Date">
                                            <strong>@invoice.InvoiceDate.ToString("dd MMM yyyy")</strong>
                                        </td>
                                        <td data-label="Due Date">
                                            <strong>@invoice.DueDate.ToString("dd MMM yyyy")</strong>
                                            @if (invoice.Status == InvoiceStatus.Overdue)
                                            {
                                                <small class="@StatusBadgeHelper.Badge("overdue")"><i></i>Overdue</small>
                                            }
                                        </td>
                                        <td data-label="Total">
                                            <strong>@invoice.CurrencySymbol @invoice.GrandTotal.ToString("N0")</strong>
                                            <small>Grand total</small>
                                        </td>
                                        <td data-label="Outstanding">
                                            <strong>@invoice.CurrencySymbol @invoice.OutstandingAmount.ToString("N0")</strong>
                                            <small>Paid @invoice.CurrencySymbol @invoice.PaidAmount.ToString("N0")</small>
                                        </td>
                                        <td data-label="Status">
                                            <span class="@invoice.Status.Badge()"><i></i>@invoice.Status.GetDisplayName()</span>
                                            <small class="membership-status-badge @StatusBadgeHelper.Modifier(approvalLabel)"><i></i>@approvalLabel</small>
                                        </td>
                                        <td data-label="Actions">
                                            <div class="gamehub-table-action-menu">
                                                <a class="membership-icon-button" asp-action="Details" asp-route-id="@invoice.Id" aria-label="View @invoice.InvoiceNumber" data-tooltip="View"><i class="bi bi-eye"></i></a>
                                                <button class="membership-icon-button" type="button" data-gamehub-table-menu-button aria-label="More actions for @invoice.InvoiceNumber" aria-expanded="false"><i class="bi bi-three-dots-vertical"></i></button>
                                                <div class="gamehub-table-action-dropdown" data-gamehub-table-menu>
                                                    <a asp-action="Preview" asp-route-id="@invoice.Id"><i class="bi bi-file-earmark-richtext"></i> Preview</a>
                                                    @if (isEditable && Model.CanCreate)
                                                    {
                                                        <a asp-action="Edit" asp-route-id="@invoice.Id"><i class="bi bi-pencil"></i> Edit</a>
                                                        <form asp-action="SubmitForApproval" method="post">
                                                            <input type="hidden" name="id" value="@invoice.Id" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit"><i class="bi bi-send"></i> Submit for approval</button>
                                                        </form>
                                                    }
                                                    @if (isPending)
                                                    {
                                                        <a asp-action="Details" asp-route-id="@invoice.Id"><i class="bi bi-check2-circle"></i> Review approval</a>
                                                    }
                                                    @if (isApproved && Model.CanCreate)
                                                    {
                                                        <form asp-action="Issue" method="post">
                                                            <input type="hidden" name="id" value="@invoice.Id" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit"><i class="bi bi-send-check"></i> Issue invoice</button>
                                                        </form>
                                                    }
                                                    @if (isIssued)
                                                    {
                                                        <form asp-action="Void" method="post">
                                                            <input type="hidden" name="id" value="@invoice.Id" />
                                                            <input type="hidden" name="reason" value="Voided from invoice register" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="danger"><i class="bi bi-slash-circle"></i> Void invoice</button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="arena-pagination">
                        <span>Showing @start-@end of @Model.TotalRecords invoices</span>
                        <nav aria-label="Invoice pagination">
                            <a class="page-link @(Model.CurrentPage <= 1 ? "disabled" : "")" href="@(Model.CurrentPage <= 1 ? "#" : PageUrl(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i> Previous</a>
                            @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                            {
                                <a class="page-link @(pageNumber == Model.CurrentPage ? "active" : "")" href="@PageUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                            }
                            <a class="page-link @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" href="@(Model.CurrentPage >= Model.TotalPages ? "#" : PageUrl(Model.CurrentPage + 1))">Next <i class="bi bi-chevron-right"></i></a>
                        </nav>
                    </div>
                }
            </section>
        </main>
    </div>

    <div class="sales-cycle-filter-drawer" data-sales-filter-drawer aria-hidden="true">
        <div class="sales-cycle-filter-panel" id="invoiceFilterDrawer" role="dialog" aria-label="Invoice filters">
            <div class="sales-cycle-filter-head">
                <div>
                    <span class="admin-label">Invoice Filters</span>
                    <h2>Refine the register</h2>
                </div>
                <button class="membership-icon-button" type="button" data-sales-filter-close aria-label="Close filters"><i class="bi bi-x-lg"></i></button>
            </div>
            <form method="get" asp-action="Index">
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <input type="hidden" name="search" value="@Model.Search" />
                }
                @if (Model.SortBy != "newest")
                {
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                }
                @if (Model.PageSize != 10)
                {
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                }
                <div class="sales-cycle-filter-grid">
                    <label>Source
                        <select name="sourceType" data-sales-filter-input>
                            <option value="">All Sources</option>
                            @foreach (InvoiceSourceType value in Enum.GetValues<InvoiceSourceType>())
                            {
                                <option value="@value" selected="@(Q("sourceType") == value.ToString())">@value.GetDisplayName()</option>
                            }
                        </select>
                    </label>
                    <label>Status
                        <select name="status" data-sales-filter-input>
                            <option value="">All Statuses</option>
                            @foreach (InvoiceStatus value in Enum.GetValues<InvoiceStatus>())
                            {
                                <option value="@value" selected="@(Q("status") == value.ToString())">@value.GetDisplayName()</option>
                            }
                        </select>
                    </label>
                </div>
                <div class="sales-cycle-filter-actions">
                    <button class="admin-action-button" type="submit"><i class="bi bi-check2"></i> Apply Filters</button>
                    <a class="admin-secondary-button" asp-action="Index">Clear All</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Styles { <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/invoices.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/sales.js" asp-append-version="true"></script><script src="~/js/memberships.js" asp-append-version="true"></script> }
