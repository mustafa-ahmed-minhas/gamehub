@model OnlineBookingStartViewModel
@{
    ViewData["Title"] = "Book a Court";
    Layout = "_CustomerLayout";
}

<section class="booking-hero">
    <div class="container booking-hero-grid">
        <div>
            <span class="eyebrow-pill"><i class="bi bi-calendar2-check"></i> Online Court Booking</span>
            <h1>Choose Your Perfect Time to Play</h1>
            <p>Select your date, duration and available court time. Your booking is confirmed only after full payment.</p>
        </div>
        <article class="selected-court-card">
            <div class="selected-court-image" style="background-image:url('@(Model.CourtImageUrl ?? "https://images.unsplash.com/photo-1554068865-24cecd4e34b8?auto=format&fit=crop&q=80&w=1200")')"></div>
            <div>
                <span>@Model.SportName Â· @Model.FacilityName</span>
                <h2>@Model.CourtName</h2>
                <p>@Model.Capacity players Â· @(Model.StartingPrice.HasValue ? $"From {Model.CurrencySymbol} {Model.StartingPrice:N0}" : "Pricing varies by time")</p>
            </div>
        </article>
    </div>
</section>

<section class="booking-workspace" data-online-booking data-court-id="@Model.CourtId" data-sport-id="@Model.SportId" data-availability-url="@Url.Action("Availability", "OnlineBooking")" data-calculate-url="@Url.Action("Calculate", "OnlineBooking")" data-customer-url="@Url.Action("CustomerSummary", "OnlineBooking")" data-membership-url="@Url.Action("MembershipSummary", "OnlineBooking")">
    <div class="container">
        @await Html.PartialAsync("_BookingProgress")
        <div class="booking-grid">
        <form asp-action="Review" method="post" class="booking-flow-card" data-booking-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="CourtId" value="@Model.CourtId" />
            <input type="hidden" name="StartTime" data-selected-start />
            <input type="hidden" name="DurationMinutes" data-duration-hidden value="@Model.DurationOptions.FirstOrDefault()" />

            <div class="booking-steps">
                <span class="active">1 Court</span>
                <span>2 Date</span>
                <span>3 Time</span>
                <span>4 Review</span>
                <span>5 Checkout</span>
            </div>

            <section class="booking-section">
                <h2>Select date</h2>
                <p>Bookings are available from @Model.MinDate.ToString("MMM dd") to @Model.MaxDate.ToString("MMM dd, yyyy").</p>
                <div class="quick-date-row">
                    <button type="button" data-quick-date="@Model.MinDate.ToString("yyyy-MM-dd")">Today</button>
                    <button type="button" data-quick-date="@Model.Tomorrow.ToString("yyyy-MM-dd")">Tomorrow</button>
                    <button type="button" data-quick-date="@Model.WeekendDate.ToString("yyyy-MM-dd")">This Weekend</button>
                </div>
                <input class="booking-date-input" type="date" name="BookingDate" min="@Model.MinDate.ToString("yyyy-MM-dd")" max="@Model.MaxDate.ToString("yyyy-MM-dd")" value="@Model.MinDate.ToString("yyyy-MM-dd")" data-booking-date />
            </section>

            <section class="booking-section">
                <h2>Select duration</h2>
                <div class="duration-grid" data-duration-grid>
                    @foreach (var duration in Model.DurationOptions)
                    {
                        <button class="duration-card @(duration == Model.DurationOptions.FirstOrDefault() ? "selected" : "")" type="button" data-duration="@duration">
                            <strong>@duration</strong>
                            <span>minutes</span>
                        </button>
                    }
                </div>
            </section>

            <section class="booking-section">
                <h2>Choose available time</h2>
                <div class="slot-state" data-slot-state>Choose a date and duration to load live slots.</div>
                <div class="slot-grid" data-slot-grid></div>
            </section>

            <section class="booking-section">
                <h2>Your account</h2>
                @if (Model.IsCustomerSignedIn)
                {
                    <div class="customer-summary-panel" data-customer-panel>
                        <span class="loading-line">Loading customer summary...</span>
                    </div>
                    @if (!Model.EmailVerified)
                    {
                        <div class="verification-required">
                            <i class="bi bi-envelope-exclamation"></i>
                            <div>
                                <strong>Email verification required</strong>
                                <p>Please verify your email before continuing to checkout.</p>
                                <button type="submit" form="resend-verification-form" class="btn-ghost-light">Resend Verification</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="guest-account-panel">
                        <i class="bi bi-person-lock"></i>
                        <div>
                            <h3>Sign in to continue</h3>
                            <p>Secure checkout, booking history, membership discounts, payment receipts and reminders require a customer account.</p>
                            <a class="btn-premium" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Start", "OnlineBooking", new { id = Model.CourtId })">Sign In</a>
                            <a class="btn-ghost-light" asp-controller="Account" asp-action="Signup">Create Account</a>
                        </div>
                    </div>
                }
            </section>

            <section class="booking-section">
                <h2>Player and booking details</h2>
                <div class="form-grid two">
                    <div class="form-floating">
                        <input class="form-control" type="number" min="1" max="@Model.Capacity" value="1" name="PlayerCount" data-player-count />
                        <label>Player Count</label>
                    </div>
                    <div class="form-floating">
                        <input class="form-control" name="SpecialRequest" maxlength="500" placeholder="Special request" />
                        <label>Special Request</label>
                    </div>
                </div>
                <div class="form-floating">
                    <textarea class="form-control" name="CustomerNotes" maxlength="500" placeholder="Notes" style="height: 110px"></textarea>
                    <label>Customer Notes</label>
                </div>
                <label class="premium-policy-check">
                    <input type="checkbox" name="AcceptBookingPolicy" value="true" />
                    <span></span>
                    I understand the booking is not confirmed until 100% payment succeeds.
                </label>
                <label class="premium-policy-check">
                    <input type="checkbox" name="AcceptCancellationPolicy" value="true" />
                    <span></span>
                    I accept GameHub cancellation and schedule policies.
                </label>
            </section>

            <button class="btn-premium booking-submit" type="submit" @(Model.IsCustomerSignedIn && Model.EmailVerified ? "" : "disabled") data-review-submit>
                <i class="bi bi-credit-card"></i> Review and Continue
            </button>
        </form>

        <aside class="live-summary-card premium-summary-card" data-live-summary>
            <div class="summary-header">
                <span class="eyebrow-pill"><i class="bi bi-receipt-cutoff"></i> @Model.ArenaName</span>
                <h2>Booking Summary</h2>
                <span class="summary-status-badge" data-summary-status>Awaiting slot</span>
            </div>

            <div class="summary-section">
                <h3><i class="bi bi-geo-alt"></i> Court Details</h3>
                <div class="summary-row">
                    <span><i class="bi bi-trophy"></i> Court</span>
                    <strong>@Model.CourtName</strong>
                </div>
                <div class="summary-row">
                    <span><i class="bi bi-dribbble"></i> Sport</span>
                    <strong>@Model.SportName</strong>
                </div>
                <div class="summary-row">
                    <span><i class="bi bi-building"></i> Facility</span>
                    <strong>@Model.FacilityName</strong>
                </div>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-section">
                <h3><i class="bi bi-calendar3"></i> Selected Slot</h3>
                <div class="summary-row">
                    <span><i class="bi bi-calendar-event"></i> Date</span>
                    <strong data-summary-date>Not selected</strong>
                </div>
                <div class="summary-row">
                    <span><i class="bi bi-clock"></i> Time</span>
                    <strong data-summary-time>Choose a slot</strong>
                </div>
                <div class="summary-row">
                    <span><i class="bi bi-hourglass-split"></i> Duration</span>
                    <strong data-summary-pricing>Awaiting slot</strong>
                </div>
                <div class="summary-row">
                    <span><i class="bi bi-people"></i> Players</span>
                    <strong data-summary-players>1</strong>
                </div>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-section pricing-section">
                <h3><i class="bi bi-cash-stack"></i> Pricing Breakdown</h3>
                <div class="summary-row">
                    <span><i class="bi bi-receipt"></i> Base</span>
                    <strong data-summary-base>-</strong>
                </div>
                <div class="summary-row">
                    <span><i class="bi bi-percent"></i> Membership</span>
                    <strong data-summary-discount>-</strong>
                </div>
                <div class="summary-row">
                    <span><i class="bi bi-calculator"></i> Tax</span>
                    <strong data-summary-tax>-</strong>
                </div>
                <div class="summary-total-row">
                    <span><i class="bi bi-wallet2"></i> Total Payable</span>
                    <strong class="summary-total" data-summary-total>-</strong>
                </div>
            </div>

            <div class="race-notice premium-notice">
                <i class="bi bi-shield-check"></i>
                <p>100% payment is required to confirm this booking. Availability is rechecked before payment is completed.</p>
            </div>
        </aside>
    </div>
    </div>
</section>

<form id="resend-verification-form" asp-controller="Account" asp-action="ResendVerification" method="post" class="d-none" aria-hidden="true">
    @Html.AntiForgeryToken()
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/online-booking.css" asp-append-version="true" />
    <style>
        .booking-section {
            border: 1px solid rgba(214, 166, 82, .12);
            box-shadow: 0 18px 42px rgba(17, 16, 14, .08);
        }
        .booking-section h2 {
            letter-spacing: -.01em;
            margin-bottom: 6px;
        }
        .booking-section p {
            color: #6d6458;
            font-weight: 600;
        }
        .quick-date-row button {
            min-width: 118px;
            justify-content: center;
        }
        .duration-card {
            min-width: 112px;
            text-align: center;
        }
        .duration-card strong {
            letter-spacing: -.02em;
        }
        .booking-date-input {
            box-shadow: 0 10px 24px rgba(17, 16, 14, .05);
        }
        .live-summary-card {
            border: 1px solid rgba(214, 166, 82, .18);
            box-shadow: 0 24px 56px rgba(17, 16, 14, .12);
        }
        .guest-account-panel,
        .customer-summary-panel {
            box-shadow: 0 18px 40px rgba(0, 0, 0, .18);
        }
        .selected-court-card {
            box-shadow: 0 24px 56px rgba(17, 16, 14, .16);
        }

        .premium-summary-card {
            display: grid;
            gap: 18px;
            padding: 24px;
            border-radius: 28px;
            background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,248,238,.96));
            border: 1px solid rgba(214, 166, 82, .22);
        }

        .summary-header {
            display: grid;
            gap: 10px;
        }

        .summary-header h2 {
            margin: 0;
            font-size: 1.55rem;
            letter-spacing: -.02em;
        }

        .summary-status-badge {
            width: fit-content;
            padding: 7px 12px;
            border-radius: 999px;
            background: #fff3d9;
            color: #7a5517;
            font-size: .74rem;
            font-weight: 900;
            border: 1px solid rgba(214, 166, 82, .24);
        }

        .summary-section {
            display: grid;
            gap: 10px;
        }

        .summary-section h3 {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 4px;
            font-size: .95rem;
            font-weight: 900;
            color: #171614;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .summary-section h3 i {
            color: #b8892f;
        }

        .summary-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 11px 12px;
            border-radius: 14px;
            background: rgba(255, 250, 242, .88);
            border: 1px solid rgba(214, 166, 82, .1);
        }

        .summary-row span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #6d6458;
            font-weight: 800;
            font-size: .84rem;
        }

        .summary-row span i {
            color: #b8892f;
        }

        .summary-row strong {
            color: #171614;
            font-weight: 900;
            text-align: right;
            word-break: break-word;
        }

        .summary-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(214, 166, 82, .35), transparent);
        }

        .pricing-section .summary-row {
            background: #fff;
        }

        .summary-total-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 16px 14px;
            border-radius: 18px;
            background: #11100e;
            color: #fff;
            box-shadow: 0 16px 34px rgba(0, 0, 0, .18);
        }

        .summary-total-row span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: rgba(255, 255, 255, .78);
            font-weight: 900;
        }

        .summary-total-row .summary-total {
            color: #d6a652;
            font-size: 1.8rem;
            line-height: 1;
        }

        .premium-notice {
            margin-top: 2px;
            border: 1px solid rgba(214, 166, 82, .18);
        }

        @@media (max-width: 720px) {
            .summary-row,
            .summary-total-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .summary-row strong,
            .summary-total-row .summary-total {
                text-align: left;
            }
        }
        @@media (max-width: 720px) {
            .quick-date-row button,
            .duration-card {
                width: 100%;
            }
        }
    </style>
}
@section Scripts {
    <script src="~/js/online-booking.js" asp-append-version="true"></script>
}
